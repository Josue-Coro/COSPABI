@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var oUsuario = (CapaModelo.CM_Usuario_Activo)Session["Usuario"];
    var listaPermisos = oUsuario?.ListaPermisos ?? new System.Collections.Generic.List<CapaModelo.CM_Permiso>();

    bool puedeRegistrar = listaPermisos.Any(p => p.accion.ToUpper() == "REGISTRAR CLIENTE");
    bool puedeEditar = listaPermisos.Any(p => p.accion.ToUpper() == "EDITAR CLIENTE");
    bool puedeEliminar = listaPermisos.Any(p => p.accion.ToUpper() == "ELIMINAR CLIENTE");
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-xl font-semibold text-gray-800">Gestión de Clientes</h1>
        <p class="text-sm text-gray-400 mt-0.5">Administra los clientes registrados en el sistema</p>
    </div>
    @if (puedeRegistrar)
    {
        <button onclick="abrirCrear()"
                class="btn-primary inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white">
            <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nuevo Cliente
        </button>
    }
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <span class="text-sm font-semibold text-gray-700">Lista de Clientes</span>
        <div class="flex items-center gap-3">
            <!-- Buscador -->
            <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-1.5 w-52">
                <svg style="width:15px;height:15px;" class="text-gray-400 flex-shrink-0"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" id="txtBusqueda" placeholder="Buscar cliente..."
                       class="bg-transparent text-sm text-gray-600 outline-none w-full placeholder-gray-400">
            </div>
            <!-- Tamaño de página -->
            <select id="selTamano"
                    class="text-sm border border-gray-300 rounded-lg px-3 py-1.5
                           focus:ring-2 focus:ring-primary-500 outline-none">
                <option value="10">10 por página</option>
                <option value="25">25 por página</option>
                <option value="50">50 por página</option>
            </select>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">#</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Nombre Completo</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">CI</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Género</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Teléfono</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">F. Nacimiento</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Estado</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyClientes" class="divide-y divide-gray-100">
                <tr>
                    <td colspan="8" class="px-6 py-10 text-center text-sm text-gray-400">
                        <svg class="animate-spin mx-auto mb-2" style="width:22px;height:22px;"
                             fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10"
                                    stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                        </svg>
                        Cargando clientes...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <div class="px-6 py-3 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-2">
        <span class="text-xs text-gray-400" id="infoPaginacion"></span>
        <div id="controlesPaginacion" class="flex items-center gap-1"></div>
    </div>
</div>

<!-- --------------------------------------
     MODAL: REGISTRAR
-------------------------------------- -->
<div id="modalCrear" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarCrear()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Nuevo Cliente</h3>
                <button onclick="cerrarCrear()"
                        class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <iframe id="iframeCrear" src="" style="width:100%;height:420px;border:none;display:block;"></iframe>
        </div>
    </div>
</div>

<!-- --------------------------------------
     MODAL: EDITAR
-------------------------------------- -->
<div id="modalEditar" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarEditar()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Editar Cliente</h3>
                <button onclick="cerrarEditar()"
                        class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <iframe id="iframeEditar" src="" style="width:100%;height:420px;border:none;display:block;"></iframe>
        </div>
    </div>
</div>

<!-- --------------------------------------
     MODAL: ELIMINAR / CAMBIAR ESTADO
-------------------------------------- -->
<div id="modalEliminar" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarEliminar()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-red-400 to-red-600"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Cambiar Estado</h3>
                <button onclick="cerrarEliminar()"
                        class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <iframe id="iframeEliminar" src="" style="width:100%;height:230px;border:none;display:block;"></iframe>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    }

        .btn-primary:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(34,197,94,0.30);
        }
</style>

@section scripts {
    <script>
    // Permisos desde Razor para controlar botones en JS
    var puedeEditar   = @puedeEditar.ToString().ToLower();
    var puedeEliminar = @puedeEliminar.ToString().ToLower();

    var paginaActual   = 1;
    var totalPaginas   = 1;
    var busquedaActual = '';
    var tamanoPagina   = 10;

    $(function () {
        cargarClientes();

        var timer;
        $('#txtBusqueda').on('input', function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                busquedaActual = $('#txtBusqueda').val().trim();
                paginaActual   = 1;
                cargarClientes();
            }, 400);
        });

        $('#selTamano').on('change', function () {
            tamanoPagina = parseInt($(this).val());
            paginaActual = 1;
            cargarClientes();
        });
    });

    // -- Cargar tabla -------------------------------------------------
    function cargarClientes() {
        $('#tbodyClientes').html(
            '<tr><td colspan="8" class="px-6 py-10 text-center text-sm text-gray-400">' +
            '<svg class="animate-spin mx-auto mb-2" style="width:22px;height:22px;" fill="none" viewBox="0 0 24 24">' +
            '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="#22c55e" stroke-width="4"/>' +
            '<path class="opacity-75" fill="#22c55e" d="M4 12a8 8 0 018-8v8H4z"/></svg>Cargando...</td></tr>'
        );

        $.ajax({
            url:  '@Url.Action("Listar", "Cliente")',
            type: 'GET',
            data: { busqueda: busquedaActual, pagina: paginaActual, tamanoPagina: tamanoPagina },
            success: function (res) {
                if (!res.exito) { mostrarToast(res.mensaje, 'error'); return; }
                renderTabla(res.clientes, res.totalRegistros);
                totalPaginas = Math.ceil(res.totalRegistros / tamanoPagina) || 1;
                renderPaginacion(res.totalRegistros);
            },
            error: function () {
                $('#tbodyClientes').html('<tr><td colspan="8" class="px-6 py-10 text-center text-sm text-red-500">Error al cargar los datos.</td></tr>');
            }
        });
    }

    // -- Renderizar filas ---------------------------------------------
    function renderTabla(clientes, total) {
        var tbody = $('#tbodyClientes');
        tbody.empty();

        if (!clientes || clientes.length === 0) {
            tbody.append('<tr><td colspan="8" class="px-6 py-10 text-center text-sm text-gray-400">No se encontraron clientes.</td></tr>');
            return;
        }

        var inicio = (paginaActual - 1) * tamanoPagina + 1;

        $.each(clientes, function (i, c) {
            var badge = c.estado
                ? '<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Activo</span>'
                : '<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Inactivo</span>';

            var nomEsc = c.nombre_completo.replace(/'/g, "\\'");

            var btnEditar = puedeEditar
                ? '<button onclick="abrirEditar(' + c.id_cliente + ')" title="Editar" ' +
                  'class="p-1.5 rounded-lg text-gray-400 hover:bg-green-50 hover:text-green-600 transition">' +
                  '<svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
                  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
                  'd="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>' +
                  '</svg></button>'
                : '';

            var btnEstado = puedeEliminar
                ? '<button onclick="abrirEliminar(' + c.id_cliente + ',\'' + nomEsc + '\',' + c.estado + ')" ' +
                  'title="' + (c.estado ? 'Desactivar' : 'Activar') + '" ' +
                  'class="p-1.5 rounded-lg text-gray-400 hover:bg-red-50 hover:text-red-500 transition">' +
                  '<svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
                  (c.estado
                      ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>'
                      : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>') +
                  '</svg></button>'
                : '';

            tbody.append(
                '<tr class="hover:bg-gray-50 transition">' +
                '<td class="px-6 py-3.5 text-gray-400 text-xs">'     + (inicio + i)                        + '</td>' +
                '<td class="px-6 py-3.5 font-medium text-gray-800">' + c.nombre_completo                   + '</td>' +
                '<td class="px-6 py-3.5 text-gray-600">'             + c.ci                                + '</td>' +
                '<td class="px-6 py-3.5 text-gray-600">'             + c.genero                            + '</td>' +
                '<td class="px-6 py-3.5 text-gray-600">'             + (c.telefono || '')                 + '</td>' +
                '<td class="px-6 py-3.5 text-gray-600">'             + parsearFechaNet(c.fecha_nacimiento) + '</td>' +
                '<td class="px-6 py-3.5">'                           + badge                               + '</td>' +
                '<td class="px-6 py-3.5 text-center">' +
                    '<div class="inline-flex items-center gap-1">' + btnEditar + btnEstado + '</div>' +
                '</td>' +
                '</tr>'
            );
        });
    }

    // -- Paginación ---------------------------------------------------
    function renderPaginacion(total) {
        var inicio = total === 0 ? 0 : (paginaActual - 1) * tamanoPagina + 1;
        var fin    = Math.min(paginaActual * tamanoPagina, total);
        $('#infoPaginacion').text('Mostrando ' + inicio + ' a ' + fin + ' de ' + total + ' registros');

        var ctrl = $('#controlesPaginacion');
        ctrl.empty();
        var base = 'px-3 py-1.5 text-xs rounded-lg border transition font-medium ';

        ctrl.append('<button ' + (paginaActual === 1 ? 'disabled' : '') +
            ' onclick="irPagina(' + (paginaActual - 1) + ')" class="' + base +
            (paginaActual === 1 ? 'opacity-40 cursor-not-allowed border-gray-200 text-gray-400'
                                : 'border-gray-300 text-gray-600 hover:bg-gray-100') + '">? Ant</button>');

        var desde = Math.max(1, paginaActual - 2);
        var hasta = Math.min(totalPaginas, paginaActual + 2);
        for (var p = desde; p <= hasta; p++) {
            ctrl.append('<button onclick="irPagina(' + p + ')" class="' + base +
                (p === paginaActual
                    ? 'bg-primary-500 text-white border-primary-500'
                    : 'border-gray-300 text-gray-600 hover:bg-gray-100') + '">' + p + '</button>');
        }

        ctrl.append('<button ' + (paginaActual === totalPaginas ? 'disabled' : '') +
            ' onclick="irPagina(' + (paginaActual + 1) + ')" class="' + base +
            (paginaActual === totalPaginas ? 'opacity-40 cursor-not-allowed border-gray-200 text-gray-400'
                                           : 'border-gray-300 text-gray-600 hover:bg-gray-100') + '">Sig ?</button>');
    }

    function irPagina(p) {
        if (p < 1 || p > totalPaginas) return;
        paginaActual = p;
        cargarClientes();
    }

    // -- Modales ------------------------------------------------------
    function abrirCrear()  {
        $('#iframeCrear').attr('src', '@Url.Action("RegistrarCliente", "Cliente")');
        $('#modalCrear').removeClass('hidden').addClass('flex');
    }
    function cerrarCrear() {
        $('#modalCrear').removeClass('flex').addClass('hidden');
        $('#iframeCrear').attr('src', '');
    }

    function abrirEditar(id) {
        $('#iframeEditar').attr('src', '@Url.Action("EditarCliente", "Cliente")?id=' + id);
        $('#modalEditar').removeClass('hidden').addClass('flex');
    }
    function cerrarEditar() {
        $('#modalEditar').removeClass('flex').addClass('hidden');
        $('#iframeEditar').attr('src', '');
    }

    function abrirEliminar(id, nombre, estado) {
        $('#iframeEliminar').attr('src',
            '@Url.Action("EliminarCliente", "Cliente")?id=' + id +
            '&nombre=' + encodeURIComponent(nombre) +
            '&estado=' + estado);
        $('#modalEliminar').removeClass('hidden').addClass('flex');
    }
    function cerrarEliminar() {
        $('#modalEliminar').removeClass('flex').addClass('hidden');
        $('#iframeEliminar').attr('src', '');
    }

    // Los iframes llaman a esto al terminar cualquier acción
    function onAccionCompletada() {
        cerrarCrear();
        cerrarEditar();
        cerrarEliminar();
        cargarClientes();
    }

    // -- Helpers ------------------------------------------------------
    function parsearFechaNet(val) {
        if (!val) return '';
        var m = /\/Date\((\d+)\)\//.exec(val);
        if (m) return new Date(parseInt(m[1])).toISOString().substring(0, 10);
        return typeof val === 'string' ? val.substring(0, 10) : '';
    }

    function mostrarToast(msg, tipo) {
        var toast = $('<div>')
            .addClass('fixed bottom-6 right-6 z-50 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg ' +
                      (tipo === 'success' ? 'bg-green-500' : 'bg-red-500'))
            .text(msg);
        $('body').append(toast);
        setTimeout(function () { toast.fadeOut(400, function () { $(this).remove(); }); }, 3000);
    }
    </script>
}

