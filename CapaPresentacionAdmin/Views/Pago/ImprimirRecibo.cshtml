@model System.Collections.Generic.List<CapaModelo.CM_ReciboPago>
@{
    Layout = null;
    // Uno o varios recibos del mismo cobro ("Cobrar todo"): cada uno se imprime en
    // su propia pagina, asi un pago de 3 periodos entrega 3 recibos con una sola
    // orden de impresion. La accion garantiza al menos un elemento.
    var titulo = Model.Count == 1 ? "Recibo Nro " + Model[0].id_pago : "Recibos Nro " + Model[0].id_pago + " a " + Model[Model.Count - 1].id_pago;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>@titulo</title>
    <style>
        body { font-family: monospace; font-size: 12px; margin: 0; padding: 10px; width: 300px; }
        .center { text-align: center; }
        .right { text-align: right; }
        .bold { font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 2px 0; }
        .line { border-top: 1px dashed #000; margin: 5px 0; }
        .line-double { border-top: 2px dashed #000; margin: 5px 0; }
        .recibo + .recibo { margin-top: 30px; padding-top: 30px; border-top: 3px double #999; }
        @@media print {
            body { width: 100%; margin: 0; padding: 0; }
            .no-print { display: none; }
            .recibo + .recibo { margin-top: 0; padding-top: 0; border-top: none; page-break-before: always; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="no-print" style="margin-bottom: 20px;">
        <button onclick="window.print()" style="padding: 5px 10px; cursor: pointer;">Imprimir</button>
        @if (Model.Count > 1)
        {
            <span style="margin-left: 8px; color: #555;">@Model.Count recibos, uno por página</span>
        }
    </div>

    @foreach (var recibo in Model)
    {
        <div class="recibo">
            <div class="center bold" style="font-size: 14px;">
                COOPERATIVA DE SERVICIOS PUBLICOS<br>
                "COSPABI" R.L.
            </div>
            <div class="center" style="font-size: 10px; margin-bottom: 10px;">
                Calle s/n - Cel. 77399315 - 68763439<br>
                El Bisito - Cotoca - Santa Cruz - Bolivia
            </div>

            <div style="display: flex; justify-content: space-between;">
                <span class="bold">RECIBO Nro :</span>
                <span class="bold">@recibo.id_pago</span>
            </div>

            <div class="line"></div>

            <table>
                <tr>
                    <td>Mes: @recibo.nombre_periodo</td>
                    <td class="right">Santa Cruz - El Bisito</td>
                </tr>
                <tr>
                    <td>CODIGO FIJO: @recibo.codigo_fijo</td>
                    <td class="right">@recibo.fecha_pago.ToString("dd/MM/yyyy")</td>
                </tr>
            </table>

            <div style="margin-top: 5px;">Nombre : @recibo.nombre_socio</div>
            <div style="margin-top: 5px;">
                Ubicacion: @recibo.ubicacion
                <span style="float: right;">Cat : @recibo.categoria</span>
            </div>

            <div class="line-double"></div>

            @if (recibo.consumo.HasValue)
            {
                <div style="margin-top: 5px; margin-bottom: 5px;">
                    Consumo : @recibo.consumo Cub
                </div>
            }

            <table>
                <tr>
                    <th class="bold" style="text-align: left;">Detalle</th>
                    <th class="bold" style="text-align: right;">Importe Bs.</th>
                </tr>
                @if (recibo.Detalles != null)
                {
                    foreach (var d in recibo.Detalles)
                    {
                        <tr>
                            <td>@d.concepto</td>
                            <td class="right">@d.subtotal.ToString("0.00")</td>
                        </tr>
                    }
                }
            </table>

            <div class="line-double"></div>

            <div style="display: flex; justify-content: space-between; font-size: 14px; margin-top: 5px;">
                <span class="bold">IMPORTE TOTAL :</span>
                <span class="bold">@recibo.total_pagado.ToString("0.00")</span>
            </div>

            <div style="margin-top: 15px;">
                Cajero : @recibo.cajero<br>
                Hora : @recibo.fecha_pago.ToString("HH:mm:ss dd/MM/yyyy")<br>
                Entidad de Pago: COSPABI LTDA
            </div>
        </div>
    }

</body>
</html>
