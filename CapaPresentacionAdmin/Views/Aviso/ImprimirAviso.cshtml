@model List<CapaModelo.CM_AvisoImpresion>
@{
    // Una hoja por aviso. La impresion individual manda una lista de 1; la
    // impresion en lote (periodo + ruta) manda todas las del lote con salto de
    // pagina entre hojas, en un solo dialogo de impresion.
    Layout = null;
    bool esLote = ViewBag.EsLote != null && (bool)ViewBag.EsLote;
    string titulo = Model.Count == 1 && !esLote
        ? "Aviso de Cobranza #" + Model[0].id_aviso
        : "Avisos de Cobranza (" + Model.Count + ")";
}
@functions {
    // Formato invariante: punto decimal, sin depender de la cultura del servidor.
    string Money(decimal d) => d.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture);
    string Num(decimal d)   => d.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
    string F(DateTime d)    => d.ToString("dd/MM/yy");
    string FL(DateTime? d)  => d.HasValue ? d.Value.ToString("dd/MM/yyyy") : "/   /";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@titulo</title>
    <style>
        @@page { size: 8.5in 5.5in; margin: 0.25in; }

        * { box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #0a5c2a; margin: 0; background: #e5e7eb; }
        .hoja {
            page-break-after: always; break-after: page;
            width: 8in; min-height: 5in; margin: 12px auto; background: #fff;
            border: 1.5px solid #0a5c2a; padding: 8px 12px; font-size: 10px; line-height: 1.25;
        }
        .center { text-align: center; }
        .right  { text-align: right; }
        .bold   { font-weight: 700; }
        table { border-collapse: collapse; width: 100%; }
        td, th { padding: 1px 4px; }

        .top { display: flex; align-items: center; gap: 10px; border-bottom: 1.5px solid #0a5c2a; padding-bottom: 4px; }
        .logo { width: 34px; height: 34px; border-radius: 50%; background: #0a5c2a; color: #fff;
                display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
        .coop { flex: 1; text-align: center; }
        .coop .n { font-size: 13px; font-weight: 700; }
        .coop .s { font-size: 8.5px; }
        .aviso-tit { text-align: center; font-weight: 700; font-size: 12px; letter-spacing: 1px; margin: 3px 0; }

        .box { border: 1px solid #0a5c2a; margin-top: 4px; }
        .box .cap { background: #0a5c2a; color: #fff; font-weight: 700; font-size: 8.5px; padding: 1px 5px; letter-spacing: .5px; }

        .kv td { border: 1px solid #cbd5cf; }
        .kv .k { font-size: 7.5px; color: #4b7a5e; text-transform: uppercase; }
        .kv .v { font-weight: 700; }

        .lect th { background: #f0f7f2; border: 1px solid #cbd5cf; font-size: 7.5px; text-transform: uppercase; }
        .lect td { border: 1px solid #cbd5cf; text-align: center; font-weight: 700; }

        .cols { display: flex; gap: 8px; margin-top: 4px; }
        .col-hist { flex: 1.4; }
        .col-fact { flex: 1; }
        .hist th, .fact th { background: #f0f7f2; border: 1px solid #cbd5cf; font-size: 7.5px; text-transform: uppercase; }
        .hist td, .fact td { border: 1px solid #cbd5cf; }

        .totales td { border: 1px solid #0a5c2a; }
        .totales .k { font-size: 8px; text-transform: uppercase; color: #4b7a5e; }
        .totales .big { font-size: 13px; font-weight: 700; }

        .pie { text-align: center; font-weight: 700; font-size: 9px; margin-top: 5px; border-top: 1px dashed #0a5c2a; padding-top: 3px; }

        .barra { text-align: center; margin: 12px; }
        .barra button { background: #0a5c2a; color: #fff; border: none; padding: 8px 18px; border-radius: 8px;
                        font-size: 13px; font-weight: 600; cursor: pointer; margin: 0 4px; }
        .barra .sec { background: #6b7280; }
        .barra .info { font-size: 12px; color: #374151; margin-right: 10px; }
        .vacio { max-width: 8in; margin: 40px auto; text-align: center; color: #374151; font-size: 14px; }

        @@media print {
            body { background: #fff; }
            .hoja { margin: 0; border: 1.5px solid #0a5c2a; width: 100%; }
            .hoja:last-child { page-break-after: auto; break-after: auto; }
            .vacio { display: none; }
            .barra { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="barra">
        @if (Model.Count != 1 || esLote)
        {
            <span class="info">@Model.Count aviso(s) — una hoja por aviso</span>
        }
        <button onclick="window.print()">🖨 Imprimir</button>
        <button class="sec" onclick="window.close()">Cerrar</button>
    </div>

    @if (Model.Count == 0)
    {
        <div class="vacio">No hay avisos pendientes de impresión con los filtros elegidos.</div>
    }

    @foreach (var av in Model)
    {
    <div class="hoja">

        <!-- Encabezado -->
        <div class="top">
            <div class="logo">💧</div>
            <div class="coop">
                <div class="n">COOPERATIVA DE SERVICIOS PÚBLICOS "COSPABI" R.L.</div>
                <div class="s">Calle s/n &bull; Cel: 773 99315 - 687 63439 &bull; El Bisito - Cotoca - Santa Cruz - Bolivia</div>
            </div>
            <div class="logo" style="background:#0a5c2a;">🌲</div>
        </div>
        <div class="aviso-tit">AVISO DE COBRANZA</div>

        <!-- Datos del socio -->
        <table class="kv">
            <tr>
                <td class="k">Cód. Fijo</td>      <td class="v">@av.codigo_fijo</td>
                <td class="k">Cód. UB</td>        <td class="v">@(av.ubicacion?.ToString() ?? "-")</td>
                <td class="k">Categoría</td>      <td class="v">@av.categoria</td>
                <td class="k">Fecha Emisión</td>  <td class="v">@F(av.fecha_emision)</td>
            </tr>
            <tr>
                <td class="k">Nombre</td>     <td class="v" colspan="3">@av.nombre_socio</td>
                <td class="k">Actividad</td>  <td class="v">@av.actividad</td>
                <td class="k">N° Casa</td>    <td class="v">@(av.num_casa?.ToString() ?? "-")</td>
            </tr>
        </table>

        <!-- Lecturación -->
        <div class="box">
            <div class="cap">Fecha de Lecturación / Lectura</div>
            <table class="lect">
                <tr>
                    <th>Fecha Actual</th><th>Fecha Anterior</th>
                    <th>Lect. Actual</th><th>Lect. Anterior</th>
                    <th>Consumo m³</th><th>Días Facturados</th>
                </tr>
                <tr>
                    <td>@F(av.fecha_lectura_actual)</td>
                    <td>@FL(av.fecha_lectura_anterior)</td>
                    <td>@Num(av.lectura_actual)</td>
                    <td>@Num(av.lectura_anterior)</td>
                    <td>@Num(av.consumo_m3)</td>
                    <td>@av.dias_lectura</td>
                </tr>
            </table>
        </div>

        <!-- Histórico + Datos Facturados -->
        <div class="cols">
            <div class="col-hist box">
                <div class="cap">Histórico</div>
                <table class="hist">
                    <tr>
                        <th>Mes</th><th>Factura</th><th class="right">Cons.</th>
                        <th class="right">Monto</th><th>Fecha Pago</th><th class="center">Est.</th>
                    </tr>
                    @foreach (var h in av.historico)
                    {
                        <tr>
                            <td>@h.nombre_periodo</td>
                            <td>@h.id_aviso</td>
                            <td class="right">@Num(h.consumo_m3)</td>
                            <td class="right">@Money(h.total_aviso)</td>
                            <td>@(h.fecha_pago.HasValue ? h.fecha_pago.Value.ToString("dd/MM/yyyy") : "/   /")</td>
                            <td class="center">@h.estado_pago_label</td>
                        </tr>
                    }
                </table>
            </div>

            <div class="col-fact box">
                <div class="cap">Datos Facturados</div>
                <table class="fact">
                    <tr><th>Concepto</th><th class="right">Importe</th></tr>
                    <tr>
                        <td>Consumo Agua</td>
                        <td class="right">@Money(av.total_consumo)</td>
                    </tr>
                    @foreach (var c in av.cargos)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(c.nombre_tipo_cargo) ? c.descripcion : c.nombre_tipo_cargo)</td>
                            <td class="right">@Money(c.monto)</td>
                        </tr>
                    }
                    @if (av.monto_credito.HasValue)
                    {
                        <tr>
                            <td>Cuota Inscripción</td>
                            <td class="right">@Money(av.monto_credito.Value)</td>
                        </tr>
                    }
                </table>
            </div>
        </div>

        <!-- Totales -->
        <table class="totales" style="margin-top:4px;">
            <tr>
                <td class="k">Deuda</td>
                <td class="bold">Bs. @Money(av.deuda_actual)</td>
                <td class="k">Fecha de Corte</td>
                <td class="bold">@F(av.fecha_vencimiento)</td>
                <td class="k right">Total Factura</td>
                <td class="big right">Bs. @Money(av.total_aviso)</td>
            </tr>
        </table>

        <div class="pie">SR. SOCIO EVITE EL CORTE CANCELANDO SU FACTURA PUNTUALMENTE</div>
    </div>
    }

    <script>
        // Avisa a la pestaña que abrio este documento (Aviso.cshtml) que ya esta
        // listo, para que quite la pantalla "Generando impresion".
        window.onload = function () {
            try {
                if (window.opener && !window.opener.closed)
                    window.opener.postMessage({ tipo: 'lote-avisos-listo', cantidad: @Model.Count }, window.location.origin);
            } catch (e) { }
            if (@(Model.Count > 0 ? "true" : "false")) window.print();
        };
    </script>
</body>
</html>
