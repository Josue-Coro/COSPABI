@model CapaModelo.CM_Aviso
@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var nombre = Session["NombreSocio"] as string ?? "Socio";
    var hoy = DateTime.Today;
    var vencido = Model != null && Model.fecha_vencimiento < hoy && Model.estado != "PAGADO";
    var pagado = Model != null && Model.estado == "PAGADO";
}

<header class="mb-6 md:mb-8">
    <p class="font-body-md text-body-md text-on-surface-variant mb-1">Bienvenido de nuevo,</p>
    <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface">@nombre</h1>
    <p class="font-caption text-caption text-on-surface-variant mt-2">
        @hoy.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-BO"))
    </p>
</header>

<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter-grid">

    @* ---------------- Saldo actual (aviso mas reciente) ---------------- *@
    <section class="bento-card bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-card-padding md:col-span-7 lg:col-span-8 flex flex-col relative overflow-hidden">
        <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary-50 rounded-full blur-3xl opacity-60 pointer-events-none"></div>

        <div class="relative z-10 flex-1 flex flex-col">
            <div class="flex justify-between items-start gap-3 mb-6">
                <div class="flex items-center gap-2">
                    <span class="p-2 bg-surface-container rounded-lg text-primary">
                        <svg class="ic w-5 h-5"><use href="#ic-wallet"></use></svg>
                    </span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Saldo actual</span>
                </div>

                @if (Model != null)
                {
                    if (pagado)
                    {
                        <span class="px-3 py-1 rounded-full flex items-center gap-1 border bg-primary-50 text-primary-700 border-primary-container/30 font-label-sm text-label-sm">
                            <svg class="ic w-4 h-4"><use href="#ic-check-circle"></use></svg>
                            Al día
                        </span>
                    }
                    else if (vencido)
                    {
                        <span class="px-3 py-1 rounded-full flex items-center gap-1 border bg-error-container/50 text-on-error-container border-error-red/20 font-label-sm text-label-sm">
                            <svg class="ic w-4 h-4"><use href="#ic-warning"></use></svg>
                            Venció el @Model.fecha_vencimiento.ToString("dd MMM")
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1 rounded-full flex items-center gap-1 border bg-warning-yellow/10 text-on-surface border-warning-yellow/30 font-label-sm text-label-sm">
                            <svg class="ic w-4 h-4"><use href="#ic-clock"></use></svg>
                            Vence @Model.fecha_vencimiento.ToString("dd MMM")
                        </span>
                    }
                }
            </div>

            @if (Model != null)
            {
                <div class="mb-8">
                    <p class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface mb-1">
                        Bs. @Model.deuda_actual.ToString("N2")
                    </p>
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        Período @Model.nombre_periodo &middot; total del aviso Bs. @Model.total_aviso.ToString("N2")
                    </p>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 mt-auto">
                    @if (!pagado)
                    {
                        <a href="@Url.Action("Avisos", "Portal")"
                           class="gradient-primary text-on-primary font-label-sm text-label-sm font-semibold rounded-lg px-6 py-3 flex-1 inline-flex items-center justify-center gap-2 shadow-sm hover:opacity-90 active:translate-y-px transition-all">
                            <svg class="ic w-[18px] h-[18px]"><use href="#ic-qr"></use></svg>
                            Pagar con QR
                        </a>
                    }
                    <a href="@Url.Action("Avisos", "Portal")"
                       class="bg-transparent border border-outline-variant text-on-surface font-label-sm text-label-sm rounded-lg px-6 py-3 flex-1 inline-flex items-center justify-center gap-2 hover:bg-surface-container-low active:translate-y-px transition-all">
                        <svg class="ic w-[18px] h-[18px]"><use href="#ic-receipt"></use></svg>
                        Ver mis avisos
                    </a>
                </div>
            }
            else
            {
                <div class="flex-1 flex flex-col items-center justify-center text-center py-8 text-on-surface-variant">
                    <svg class="ic w-12 h-12 mb-3 opacity-40"><use href="#ic-receipt"></use></svg>
                    <p class="font-body-md text-body-md">Todavía no tienes avisos registrados.</p>
                </div>
            }
        </div>
    </section>

    @* ---------------- Consumo (se arma en el cliente con ListarAvisos) ---------------- *@
    <section class="bento-card bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-card-padding md:col-span-5 lg:col-span-4 flex flex-col">
        <div class="flex items-center gap-2 mb-6">
            <span class="p-2 bg-surface-container rounded-lg text-primary">
                <svg class="ic w-5 h-5"><use href="#ic-drop"></use></svg>
            </span>
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Último consumo</span>
        </div>

        <div class="mb-6 flex items-end gap-2">
            <span id="consumoActual" class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface leading-none">--</span>
            <span class="font-body-md text-body-md text-on-surface-variant mb-1">m³</span>
        </div>

        <div id="graficoConsumo" class="mt-auto flex items-end justify-between h-24 gap-2 px-1">
            <p class="font-caption text-caption text-on-surface-variant self-center w-full text-center">Cargando…</p>
        </div>
    </section>

    @* ---------------- Notificaciones recientes ---------------- *@
    <section class="md:col-span-12 mt-2">
        <div class="flex justify-between items-center mb-stack-md">
            <h2 class="font-headline-md text-headline-md-mobile text-on-surface">Notificaciones recientes</h2>
            <a href="@Url.Action("Notificaciones", "Portal")" class="font-label-sm text-label-sm text-primary hover:underline flex items-center gap-1">
                Ver todas <svg class="ic w-4 h-4"><use href="#ic-arrow-right"></use></svg>
            </a>
        </div>
        <div id="notifRecientes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <p class="font-caption text-caption text-on-surface-variant">Cargando…</p>
        </div>
    </section>

</div>

@section scripts {
    <script>
        $(function () {
            cargarConsumo();
            cargarNotificaciones();
        });

        // El grafico sale de los avisos que ya devuelve el portal: no hace
        // falta un SP nuevo, cada aviso trae su consumo_m3.
        function cargarConsumo() {
            $.get('@Url.Action("ListarAvisos", "Portal")', function (res) {
                var cont = $('#graficoConsumo');
                if (!res.exito || !res.avisos || !res.avisos.length) {
                    cont.html('<p class="font-caption text-caption text-on-surface-variant self-center w-full text-center">Sin lecturas registradas.</p>');
                    return;
                }

                // ListarAvisos llega del mas reciente al mas antiguo
                var conConsumo = res.avisos.filter(function (a) { return a.consumo_m3 != null; });
                if (!conConsumo.length) {
                    cont.html('<p class="font-caption text-caption text-on-surface-variant self-center w-full text-center">Sin lecturas registradas.</p>');
                    return;
                }

                $('#consumoActual').text(Portal.fmt(conConsumo[0].consumo_m3));

                var ultimos = conConsumo.slice(0, 4).reverse();
                var max = Math.max.apply(null, ultimos.map(function (a) { return a.consumo_m3; }));
                if (max <= 0) { max = 1; }

                cont.empty();
                $.each(ultimos, function (i, a) {
                    var alto = Math.max(8, Math.round((a.consumo_m3 / max) * 100));
                    var esUltimo = (i === ultimos.length - 1);
                    var etiqueta = Portal.esc(String(a.nombre_periodo).substring(0, 7));
                    cont.append(
                        '<div class="w-full flex flex-col items-center gap-1 group" title="' + etiqueta + ': ' + Portal.fmt(a.consumo_m3) + ' m³">' +
                            '<div class="w-full rounded-t-sm transition-colors ' +
                                (esUltimo ? 'gradient-primary shadow-[0_-2px_10px_rgba(34,197,94,0.3)]' : 'bg-surface-container-highest group-hover:bg-primary-container/50') +
                            '" style="height:' + alto + '%"></div>' +
                            '<span class="font-caption text-caption ' + (esUltimo ? 'text-primary font-bold' : 'text-on-surface-variant') + '">' + etiqueta + '</span>' +
                        '</div>');
                });
            });
        }

        function cargarNotificaciones() {
            $.get('@Url.Action("ListarNotificaciones", "Portal")', function (res) {
                var cont = $('#notifRecientes');
                cont.empty();
                if (!res.exito || !res.notificaciones || !res.notificaciones.length) {
                    cont.html('<p class="font-caption text-caption text-on-surface-variant">No tienes notificaciones.</p>');
                    return;
                }
                var url = '@Url.Action("Notificaciones", "Portal")';
                $.each(res.notificaciones.slice(0, 3), function (_, n) {
                    var nueva = !n.leido;
                    cont.append(
                        '<a href="' + url + '" class="bento-card bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-4 flex gap-4 items-start group">' +
                            '<span class="p-2 rounded-lg shrink-0 ' + (nueva ? 'bg-primary-50 text-primary' : 'bg-surface-container text-on-surface-variant') + '">' +
                                '<svg class="ic w-5 h-5"><use href="#ic-megaphone"></use></svg>' +
                            '</span>' +
                            '<span class="min-w-0">' +
                                '<span class="flex items-center gap-2 mb-1">' +
                                    '<span class="font-label-sm text-label-sm text-on-surface font-semibold truncate">' + Portal.esc(n.titulo) + '</span>' +
                                    (nueva ? '<span class="shrink-0 text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-primary-50 text-primary-700">Nueva</span>' : '') +
                                '</span>' +
                                '<span class="block font-caption text-caption leading-relaxed text-on-surface-variant line-clamp-2">' + Portal.esc(n.mensaje) + '</span>' +
                            '</span>' +
                        '</a>');
                });
            });
        }
    </script>
}
