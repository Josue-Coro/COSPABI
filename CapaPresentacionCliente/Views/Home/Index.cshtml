@model CapaModelo.CM_Aviso
@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nombre = Session["NombreSocio"] as string ?? "Socio";
    var hoy    = DateTime.Today;
}

<style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f1f5f9; }

    .home-header {
        background: #1c2434;
        border-radius: 14px;
        padding: 22px 20px;
        color: white;
        margin-bottom: 16px;
    }
    .home-header .saludo { font-size: 13px; color: rgba(255,255,255,0.55); margin-bottom: 2px; }
    .home-header .nombre { font-size: 20px; font-weight: 700; }
    .home-header .fecha  { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 3px; }

    .aviso-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
        overflow: hidden;
        margin-bottom: 14px;
    }
    .aviso-card-header {
        background: #f8fafc;
        padding: 12px 18px;
        border-bottom: 1px solid #e2e8f0;
        display: flex; align-items: center; justify-content: space-between;
    }
    .aviso-card-header .titulo {
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px; color: #64748b;
    }
    .aviso-card-body { padding: 18px; }
    .monto-principal { font-size: 30px; font-weight: 800; color: #1e293b; line-height: 1; margin-bottom: 3px; }
    .monto-label     { font-size: 12px; color: #94a3b8; margin-bottom: 14px; }
    .aviso-dato-fila {
        display: flex; justify-content: space-between;
        padding: 8px 0; border-bottom: 1px solid #f1f5f9; font-size: 14px;
    }
    .aviso-dato-fila:last-child { border-bottom: none; }
    .aviso-dato-fila .lbl { color: #94a3b8; }
    .aviso-dato-fila .val { font-weight: 600; color: #1e293b; }

    .badge-estado {
        font-size: 11px; font-weight: 600;
        padding: 3px 10px; border-radius: 20px; display: inline-block;
    }
    .badge-GENERADO  { background: #dcfce7; color: #15803d; }
    .badge-LECTURADO { background: #fffbeb; color: #d97706; }
    .badge-IMPRESO   { background: #f0fdf4; color: #16a34a; }
    .badge-PAGADO    { background: #dcfce7; color: #15803d; }
    .badge-vencido   { background: #fef2f2; color: #dc2626; }
    .badge-vigente   { background: #dcfce7; color: #15803d; }

    .empty-state { text-align: center; padding: 36px 20px; color: #94a3b8; }
    .empty-state svg { margin-bottom: 10px; opacity: 0.35; }
    .empty-state p   { font-size: 14px; margin: 0; }

    .acceso-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
        padding: 16px 18px;
        display: flex; align-items: center; gap: 14px;
        text-decoration: none; color: inherit;
        transition: box-shadow 0.15s;
        margin-bottom: 10px;
    }
    .acceso-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.10); text-decoration: none; color: inherit; }
    .acceso-icon {
        width: 44px; height: 44px; border-radius: 12px;
        background: #dcfce7;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .acceso-titulo { font-size: 15px; font-weight: 700; color: #1e293b; margin: 0; }
    .acceso-sub    { font-size: 13px; color: #94a3b8; margin: 0; }
</style>

<div style="max-width:520px; margin:0 auto; padding:16px;">

    <!-- Encabezado saludo -->
    <div class="home-header">
        <div class="saludo">Bienvenido de vuelta</div>
        <div class="nombre">@nombre</div>
        <div class="fecha">@hoy.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))</div>
    </div>

    <!-- Último aviso -->
    <div class="aviso-card">
        <div class="aviso-card-header">
            <span class="titulo">Último Aviso</span>
            @if (Model != null)
            {
                var badgeClass = "badge-" + Model.estado;
                <span class="badge-estado @badgeClass">@Model.nombre_estado</span>
            }
        </div>
        <div class="aviso-card-body">
            @if (Model != null)
            {
                var vencido = Model.fecha_vencimiento < hoy && Model.estado != "PAGADO";
                <div class="monto-principal">Bs. @Model.deuda_actual.ToString("N2")</div>
                <div class="monto-label">Deuda actual</div>

                <div class="aviso-dato-fila">
                    <span class="lbl">Periodo</span>
                    <span class="val">@Model.nombre_periodo</span>
                </div>
                <div class="aviso-dato-fila">
                    <span class="lbl">Total aviso</span>
                    <span class="val">Bs. @Model.total_aviso.ToString("N2")</span>
                </div>
                <div class="aviso-dato-fila">
                    <span class="lbl">Vencimiento</span>
                    <span class="val">
                        <span class="badge-estado @(vencido ? "badge-vencido" : "badge-vigente")">
                            @Model.fecha_vencimiento.ToString("dd/MM/yyyy")
                        </span>
                    </span>
                </div>
                <div class="aviso-dato-fila">
                    <span class="lbl">Emisión</span>
                    <span class="val">@Model.fecha_emision.ToString("dd/MM/yyyy")</span>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <p>No tienes avisos registrados aún.</p>
                </div>
            }
        </div>
    </div>

    <!-- Accesos rápidos -->
    <p style="font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:#94a3b8; margin-bottom:10px;">
        Accesos rápidos
    </p>

    <a href="@Url.Action("Index", "Perfil")" class="acceso-card">
        <div class="acceso-icon">
            <svg width="22" height="22" fill="none" stroke="#16a34a" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
        </div>
        <div>
            <p class="acceso-titulo">Mi Perfil</p>
            <p class="acceso-sub">Ver mis datos de socio</p>
        </div>
    </a>

</div>