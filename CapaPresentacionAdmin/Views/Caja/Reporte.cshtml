@using CapaModelo
@{
    Layout = null;
    var arqueo = (CM_CajaArqueo)ViewBag.Arqueo;
    var pagos = (List<CM_Pago>)ViewBag.Pagos ?? new List<CM_Pago>();
    var conceptos = ViewBag.Conceptos as CM_ArqueoGeneral;
    var usuario = (CM_Usuario_Activo)Session["Usuario"];
    var cajero = usuario != null ? usuario.nombre + " " + usuario.apellido : "-";
    var ahora = DateTime.Now;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Arqueo de Caja Nº @arqueo.id_caja - COSPABI R.L.</title>
    <link href="@Url.Content("~/Content/app.css")?v=@CapaPresentacionAdmin.Recursos.AppCss()" rel="stylesheet" />
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .hoja { max-width: 860px; margin: 24px auto; background: #fff; padding: 32px 36px; border: 1px solid #e5e7eb; border-radius: 12px; }
        @@media print {
            body { background: #fff; margin: 0; }
            .no-print { display: none !important; }
            .hoja { max-width: none; margin: 0; padding: 0; border: none; border-radius: 0; }
            @@page { size: portrait; margin: 1.2cm 1.2cm 1.6cm; }
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 antialiased">

    <!-- Barra de acciones (solo en pantalla) -->
    <div class="no-print bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between sticky top-0 z-50 shadow-sm">
        <span class="text-sm font-semibold text-gray-700">Arqueo de Caja Nº @arqueo.id_caja</span>
        <div class="flex items-center gap-3">
            <button onclick="window.close()" class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50">Cerrar</button>
            <button onclick="window.print()" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm">Imprimir / Guardar PDF</button>
        </div>
    </div>

    <div class="hoja">
        <div class="rpt">

            <!-- Cabecera -->
            <div class="rpt-head">
                <div>
                    <div class="rpt-coop">COSPABI R.L.</div>
                    <div class="rpt-coop-sub">Cooperativa de Agua Potable</div>
                    <div class="rpt-coop-sub">Santa Cruz - Bolivia</div>
                </div>
                <div>
                    <div class="rpt-title">Arqueo de Caja</div>
                    <div class="rpt-range">Caja Nº @arqueo.id_caja &nbsp; Fecha : @arqueo.fecha.ToString("dd/MM/yy")</div>
                    <div class="rpt-range">Cajero : @cajero</div>
                </div>
                <div class="rpt-stamp">
                    Fecha : @ahora.ToString("dd/MM/yy")<br>
                    Hora &nbsp;: @ahora.ToString("HH:mm:ss")
                </div>
            </div>

            <!-- Datos de la caja -->
            <table style="margin-top:6px">
                <thead>
                    <tr>
                        <th>Apertura</th>
                        <th>Cierre</th>
                        <th>Estado</th>
                        <th class="num">Fondo apertura</th>
                        <th class="num">Total cobrado</th>
                        <th class="num">Efectivo en caja</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@arqueo.hora_apertura.ToString("dd/MM/yy HH:mm")</td>
                        <td>@(arqueo.hora_cierre.HasValue ? arqueo.hora_cierre.Value.ToString("dd/MM/yy HH:mm") : "-- abierta --")</td>
                        <td>@(arqueo.estado ? "ABIERTA (arqueo parcial)" : "CERRADA")</td>
                        <td class="num">@arqueo.monto_apertura.ToString("N2")</td>
                        <td class="num">@arqueo.total_cobrado.ToString("N2")</td>
                        <td class="num">@((arqueo.monto_apertura + arqueo.efectivo_cobrado).ToString("N2"))</td>
                    </tr>
                </tbody>
            </table>

            <!-- Recaudacion por servicio (mismo cuadro que el Arqueo General) -->
            <table class="rpt-boxed" style="margin-top:18px">
                <thead>
                    <tr>
                        <th class="num" style="width:50px">N°</th>
                        <th>Servicio</th>
                        <th class="num" style="width:90px">Cant.</th>
                        <th class="num" style="width:140px">Cobrado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="rpt-group"><td colspan="4">Centro de Cobranza :</td></tr>
                    @if (conceptos != null && conceptos.Conceptos.Count > 0)
                    {
                        foreach (var c in conceptos.Conceptos)
                        {
                            <tr>
                                <td class="num">@c.nro</td>
                                <td>@c.servicio</td>
                                <td class="num">@c.cantidad</td>
                                <td class="num">@c.cobrado.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="rpt-empty">Sin cobros en esta caja</td></tr>
                    }
                </tbody>
            </table>
            <div class="rpt-total">
                <span>Total :</span>
                <span>@(conceptos != null ? conceptos.CantidadConceptos : 0)</span>
                <span>@arqueo.total_cobrado.ToString("N2")</span>
            </div>

            <!-- Por metodo de pago -->
            <table style="width:auto;min-width:320px;margin-top:14px">
                <thead>
                    <tr><th>Método de pago</th><th class="num">Cant.</th><th class="num">Cobrado</th></tr>
                </thead>
                <tbody>
                    @if (arqueo.porMetodo != null && arqueo.porMetodo.Count > 0)
                    {
                        foreach (var m in arqueo.porMetodo)
                        {
                            <tr><td>@m.metodo</td><td class="num">@m.cantidad</td><td class="num">@m.total.ToString("N2")</td></tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" class="rpt-empty">Sin transacciones</td></tr>
                    }
                </tbody>
            </table>

            <!-- Detalle de cobros (libro diario) -->
            <table style="margin-top:18px">
                <thead>
                    <tr>
                        <th class="num">Código</th>
                        <th>Nombre</th>
                        <th class="num">Boleta</th>
                        <th class="ctr">Hora</th>
                        <th class="num">N° Aviso</th>
                        <th>Método</th>
                        <th class="num">Monto</th>
                        <th class="num">Vuelto</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pagos.Count > 0)
                    {
                        <tr class="rpt-group"><td colspan="8">Pagadas</td></tr>
                        foreach (var p in pagos)
                        {
                            <tr>
                                <td class="num">@(p.codigo_fijo.HasValue ? p.codigo_fijo.Value.ToString() : "")</td>
                                <td>@(string.IsNullOrEmpty(p.nombre_socio) ? "Registro socio nuevo" : p.nombre_socio)</td>
                                <td class="num">@p.id_pago</td>
                                <td class="ctr">@p.fecha_pago.ToString("HH:mm:ss")</td>
                                <td class="num">@(p.aviso_id_aviso.HasValue ? p.aviso_id_aviso.Value.ToString() : "Inscr.")</td>
                                <td>@p.nombre_metodo</td>
                                <td class="num">@p.monto_pagado.ToString("N2")</td>
                                <td class="num">@(p.vuelto.HasValue && p.vuelto.Value > 0 ? p.vuelto.Value.ToString("N2") : "")</td>
                            </tr>
                        }
                        <tr class="rpt-subtotal">
                            <td colspan="6" class="num">Sub Total :</td>
                            <td class="num">@pagos.Count</td>
                            <td class="num">@pagos.Sum(x => x.monto_pagado).ToString("N2")</td>
                        </tr>
                    }
                    else
                    {
                        <tr><td colspan="8" class="rpt-empty">Sin movimientos</td></tr>
                    }
                </tbody>
            </table>

            <div class="rpt-signs">
                <div class="rpt-sign">Cajero<br><span style="font-size:10px">@cajero</span></div>
                <div class="rpt-sign">Contabilidad</div>
                <div class="rpt-sign">Tesorero</div>
            </div>

            <div class="rpt-foot">
                <span>COSPABI R.L. - Sistema de Gestión</span>
                <span>Arqueo de Caja Nº @arqueo.id_caja</span>
            </div>
        </div>
    </div>

    <script>
        window.onload = function () { setTimeout(function () { window.print(); }, 300); };
    </script>
</body>
</html>
