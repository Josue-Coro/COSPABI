@{
    ViewBag.Title = "EditarTarifa";
    Layout = null;
    int id = 0;
    int.TryParse(Request.QueryString["id"], out id);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = { theme: { extend: { colors: { primary: { 500: '#22c55e', 600: '#16a34a', 700: '#15803d' } }, fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] } } } }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: transparent;
        }

        .input-field {
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .input-field:focus {
                border-color: #22c55e;
                box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
                outline: none;
            }

        .btn-primary {
            background: linear-gradient(135deg,#22c55e 0%,#16a34a 100%);
            transition: opacity 0.2s, transform 0.15s;
        }

            .btn-primary:hover:not(:disabled) {
                opacity: 0.92;
                transform: translateY(-1px);
            }

            .btn-primary:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }
    </style>
</head>
<body class="p-1">

    <input type="hidden" id="idTarifa" value="@id">

    <!-- Consumo mínimo y Precio por m³ -->
    <div class="grid grid-cols-2 gap-3 mb-3">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Consumo mínimo (m³)</label>
            <input type="number" id="consumo_minimo_m3" min="0" placeholder="Ej: 10"
                   class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Precio por m³ (Bs.)</label>
            <input type="number" id="precio_m3" min="0" step="0.01" placeholder="Ej: 5"
                   class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
        </div>
    </div>

    <!-- Monto mínimo -->
    <div class="mb-3">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Monto mínimo (Bs.)</label>
        <div class="relative">
            <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-400 text-sm font-medium">Bs.</span>
            <input type="number" id="monto_minimo" min="0" step="0.001" placeholder="Ej: 50.000"
                   class="input-field w-full pl-9 pr-4 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
        </div>
    </div>

    <!-- Rol de socio -->
    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Rol de socio</label>
        <select id="rol_socio_id_rol_socio"
                class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
            <option value="">— Cargando... —</option>
        </select>
    </div>

    <!-- Error -->
    <div id="errorMsg" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span id="errorText"></span>
    </div>

    <!-- Botón guardar -->
    <button id="btnGuardar" onclick="editar()"
            class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
        <span id="btnText">Guardar Cambios</span>
        <svg id="btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
        </svg>
    </button>

    <script>
        $(function () {
            var id = parseInt($('#idTarifa').val());

            // Cargar roles y tarifas en paralelo
            $.when(
                $.ajax({ url: '@Url.Action("ListarRolSocio", "Tarifa")', type: 'GET' }),
                $.ajax({ url: '@Url.Action("ListarTarifa", "Tarifa")',   type: 'GET' })
            ).done(function (resRoles, resTarifas) {

                // Poblar select de roles
                var opts = '';
                $.each(resRoles[0].data, function (i, r) {
                    opts += '<option value="' + r.id_rol_socio + '">' + r.rol_socio + '</option>';
                });
                $('#rol_socio_id_rol_socio').html(opts);

                // Buscar la tarifa actual y prellenar campos
                var t = $.grep(resTarifas[0].data, function (x) { return x.id_tarifa === id; })[0];
                if (t) {
                    $('#consumo_minimo_m3').val(t.consumo_minimo_m3);
                    $('#monto_minimo').val(t.monto_minimo);
                    $('#precio_m3').val(t.precio_m3);
                    $('#rol_socio_id_rol_socio').val(t.rol_socio_id_rol_socio);
                }
            }).fail(function () {
                mostrarError('Error al cargar los datos de la tarifa.');
            });
        });

        function editar() {
            var id      = parseInt($('#idTarifa').val());
            var consumo = parseFloat($('#consumo_minimo_m3').val());
            var monto   = parseFloat($('#monto_minimo').val());
            var precio  = parseFloat($('#precio_m3').val());
            var rol     = $('#rol_socio_id_rol_socio').val();

            if (isNaN(consumo) || consumo < 0) { mostrarError('Ingresa un consumo mínimo válido.'); return; }
            if (isNaN(monto)   || monto < 0)   { mostrarError('Ingresa un monto mínimo válido.');   return; }
            if (isNaN(precio)  || precio < 0)  { mostrarError('Ingresa un precio por m³ válido.');  return; }
            if (!rol)                           { mostrarError('Selecciona un rol de socio.');        return; }

            ocultarError();
            setLoading(true);

            $.ajax({
                url:  '@Url.Action("EditarTarifa", "Tarifa")',
                type: 'POST',
                data: {
                    id_tarifa:             id,
                    consumo_minimo_m3:     consumo,
                    monto_minimo:          monto,
                    precio_m3:             precio,
                    rol_socio_id_rol_socio: rol
                },
                success: function (res) {
                    if (res.resultado === true) {
                        window.parent.onAccionCompletada();
                    } else {
                        mostrarError(res.mensaje || 'No se pudo actualizar la tarifa.');
                        setLoading(false);
                    }
                },
                error: function () {
                    mostrarError('Error de conexión. Intenta nuevamente.');
                    setLoading(false);
                }
            });
        }

        function mostrarError(msg) { $('#errorText').text(msg); $('#errorMsg').removeClass('hidden'); }
        function ocultarError()    { $('#errorMsg').addClass('hidden'); }
        function setLoading(v)     { $('#btnGuardar').prop('disabled', v); $('#btnText').text(v ? 'Guardando...' : 'Guardar Cambios'); $('#btnSpinner').toggleClass('hidden', !v); }
    </script>
</body>
</html>