@{
    ViewBag.Title = "Mi perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-primary {
        background: linear-gradient(135deg,#22c55e 0%,#16a34a 100%);
        transition: opacity .2s, transform .15s;
    }
        .btn-primary:hover:not(:disabled) { opacity: .92; transform: translateY(-1px); }
        .btn-primary:disabled { opacity: .65; cursor: not-allowed; }

    .input-field { transition: border-color .2s, box-shadow .2s; }
        .input-field:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,.15);
            outline: none;
        }
        .input-field[readonly] { color: #6b7280; cursor: not-allowed; }

    .stat-box { border: 1px solid #f3f4f6; border-radius: .875rem; padding: .875rem 1rem; background: #fafafa; }
    .stat-box p:first-child { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #9ca3af; font-weight: 600; }
    .stat-box p:last-child { font-size: 1.125rem; font-weight: 700; color: #1f2937; margin-top: 2px; }

    .timeline-item { position: relative; padding-left: 1.5rem; padding-bottom: 1rem; }
    .timeline-item::before {
        content: ''; position: absolute; left: 5px; top: 8px; width: 8px; height: 8px;
        border-radius: 999px; background: #22c55e; box-shadow: 0 0 0 3px #dcfce7;
    }
    .timeline-item::after {
        content: ''; position: absolute; left: 8.5px; top: 18px; bottom: -2px; width: 1px; background: #e5e7eb;
    }
    .timeline-item:last-child::after { display: none; }
</style>

<!-- Encabezado -->
<div class="mb-6">
    <h1 class="text-xl font-semibold text-gray-800">Mi perfil</h1>
    <p class="text-sm text-gray-400 mt-0.5">Tus datos de acceso y tu actividad en el sistema</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

    <!-- ===== Columna izquierda: tarjeta de identidad ===== -->
    <div class="lg:col-span-1 flex flex-col gap-5">

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="h-20 bg-gradient-to-r from-primary-500 to-primary-700"></div>
            <div class="px-6 pb-6">
                <div class="-mt-10 mb-3 w-20 h-20 rounded-full bg-white p-1 shadow-md">
                    <div id="pfAvatar"
                         class="w-full h-full rounded-full bg-primary-100 flex items-center justify-center text-primary-700 text-2xl font-bold">
                        ..
                    </div>
                </div>
                <h2 id="pfNombreCompleto" class="text-lg font-bold text-gray-800 leading-tight">Cargando...</h2>
                <p class="text-sm text-gray-400" id="pfUsuarioTxt"></p>

                <div class="mt-3 flex flex-wrap gap-2">
                    <span id="pfRolBadge"
                          class="inline-flex items-center gap-1.5 bg-primary-50 border border-primary-100 text-primary-700 text-xs font-semibold px-2.5 py-1 rounded-full">
                        <svg style="width:13px;height:13px" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        <span id="pfRol">...</span>
                    </span>
                    <span id="pfEstadoBadge" class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500">
                        <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                        <span id="pfEstado">...</span>
                    </span>
                </div>

                <p id="pfDescRol" class="text-xs text-gray-400 mt-3 leading-relaxed"></p>

                <div class="grid grid-cols-2 gap-3 mt-5">
                    <div class="stat-box">
                        <p>Permisos</p>
                        <p id="pfPermisos">-</p>
                    </div>
                    <div class="stat-box">
                        <p>Acciones</p>
                        <p id="pfAcciones">-</p>
                    </div>
                    <div class="stat-box">
                        <p>Cajas</p>
                        <p id="pfCajas">-</p>
                    </div>
                    <div class="stat-box">
                        <p>Alta</p>
                        <p id="pfAlta" class="!text-sm">-</p>
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-2 text-xs text-gray-500">
                    <svg style="width:14px;height:14px" class="text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Último acceso: <strong id="pfUltimoAcceso" class="text-gray-700">-</strong></span>
                </div>
            </div>
        </div>

    </div>

    <!-- ===== Columna derecha: formularios + actividad ===== -->
    <div class="lg:col-span-2 flex flex-col gap-5">

        <!-- Datos personales -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <svg style="width:16px;height:16px" class="text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-sm font-semibold text-gray-700">Datos personales</span>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Nombre <span class="text-red-500">*</span></label>
                        <input type="text" id="nombre" maxlength="255"
                               class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Apellido <span class="text-red-500">*</span></label>
                        <input type="text" id="apellido" maxlength="255"
                               class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Nombre de usuario</label>
                        <input type="text" id="usuario" readonly
                               class="input-field w-full px-3 py-2.5 border border-gray-200 rounded-xl text-sm bg-gray-100">
                        <p class="text-xs text-gray-400 mt-1">Lo administra Gestionar Usuarios.</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Rol</label>
                        <input type="text" id="rolInput" readonly
                               class="input-field w-full px-3 py-2.5 border border-gray-200 rounded-xl text-sm bg-gray-100">
                        <p class="text-xs text-gray-400 mt-1">Define tus permisos en el sistema.</p>
                    </div>
                </div>

                <div id="errDatos" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span id="errDatosTxt"></span>
                </div>

                <div class="flex justify-end">
                    <button id="btnGuardarDatos" onclick="guardarDatos()"
                            class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white">
                        <span>Guardar cambios</span>
                        <svg class="hidden animate-spin spinner" style="width:16px;height:16px" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Seguridad -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <svg style="width:16px;height:16px" class="text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span class="text-sm font-semibold text-gray-700">Cambiar contraseña</span>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Contraseña actual <span class="text-red-500">*</span></label>
                        <input type="password" id="passActual" autocomplete="current-password"
                               class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Nueva contraseña <span class="text-red-500">*</span></label>
                        <input type="password" id="passNueva" autocomplete="new-password"
                               class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Confirmar <span class="text-red-500">*</span></label>
                        <input type="password" id="passConfirm" autocomplete="new-password"
                               class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    </div>
                </div>

                <div class="flex items-center justify-between flex-wrap gap-3">
                    <label class="inline-flex items-center gap-2 text-xs text-gray-500 cursor-pointer select-none">
                        <input type="checkbox" id="verPass" class="rounded border-gray-300">
                        Mostrar contraseñas
                    </label>
                    <p class="text-xs text-gray-400">Mínimo 6 caracteres. Cerrará tu sesión en otros dispositivos al volver a iniciar.</p>
                </div>

                <div id="errPass" class="hidden mt-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span id="errPassTxt"></span>
                </div>

                <div class="flex justify-end mt-4">
                    <button id="btnCambiarPass" onclick="cambiarPass()"
                            class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white">
                        <span>Actualizar contraseña</span>
                        <svg class="hidden animate-spin spinner" style="width:16px;height:16px" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Actividad reciente -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <svg style="width:16px;height:16px" class="text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    <span class="text-sm font-semibold text-gray-700">Actividad reciente</span>
                </div>
                <span class="text-xs text-gray-400">Últimas 10 acciones</span>
            </div>
            <div class="p-6">
                <div id="listaActividad" class="text-sm">
                    <p class="text-gray-400 text-center py-4">Cargando...</p>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Toast -->
<div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

@section scripts {
<script>
    $(function () {
        cargarPerfil();

        $('#verPass').on('change', function () {
            var tipo = this.checked ? 'text' : 'password';
            $('#passActual, #passNueva, #passConfirm').attr('type', tipo);
        });
    });

    function cargarPerfil() {
        $.get('@Url.Action("Obtener", "Perfil")')
            .done(function (res) {
                if (!res.exito) { mostrarToast(res.mensaje || 'No se pudo cargar el perfil', 'error'); return; }
                pintarPerfil(res.perfil);
                pintarActividad(res.actividad);
            })
            .fail(function () { mostrarToast('Error de conexión al cargar el perfil', 'error'); });
    }

    function pintarPerfil(p) {
        var ini = ((p.nombre || ' ')[0] + (p.apellido || ' ')[0]).toUpperCase();
        $('#pfAvatar').text(ini);
        $('#pfNombreCompleto').text(p.nombre + ' ' + p.apellido);
        $('#pfUsuarioTxt').text('@@' + p.usuario);
        $('#pfRol').text(p.nombre_rol);
        $('#pfDescRol').text(p.descripcion_rol || '');
        $('#pfPermisos').text(p.cantidad_permisos);
        $('#pfAcciones').text(p.acciones_bitacora);
        $('#pfCajas').text(p.cajas_abiertas_total);
        $('#pfAlta').text(fmtFecha(p.fecha_creacion));
        $('#pfUltimoAcceso').text(p.ultimo_acceso ? fmtFechaHora(p.ultimo_acceso) : 'Sin registro');

        var badge = $('#pfEstadoBadge');
        badge.removeClass('bg-gray-100 text-gray-500 bg-green-50 text-green-700 bg-red-50 text-red-700');
        badge.find('span:first').removeClass('bg-gray-400 bg-green-500 bg-red-500');
        if (p.estado) {
            badge.addClass('bg-green-50 text-green-700'); badge.find('span:first').addClass('bg-green-500');
            $('#pfEstado').text('Activo');
        } else {
            badge.addClass('bg-red-50 text-red-700'); badge.find('span:first').addClass('bg-red-500');
            $('#pfEstado').text('Inactivo');
        }

        $('#nombre').val(p.nombre);
        $('#apellido').val(p.apellido);
        $('#usuario').val(p.usuario);
        $('#rolInput').val(p.nombre_rol);
    }

    function pintarActividad(lista) {
        if (!lista || lista.length === 0) {
            $('#listaActividad').html('<p class="text-gray-400 text-center py-4">Aún no tienes acciones registradas.</p>');
            return;
        }
        var html = '';
        lista.forEach(function (b) {
            html += '<div class="timeline-item">' +
                        '<p class="text-gray-700 leading-snug">' + escapeHtml(b.accion) + '</p>' +
                        '<p class="text-xs text-gray-400 mt-0.5">' + fmtFechaHora(b.fecha_hora) + '</p>' +
                    '</div>';
        });
        $('#listaActividad').html(html);
    }

    // ---- Datos personales ----
    function guardarDatos() {
        ocultarError('#errDatos');
        var nombre = $('#nombre').val().trim();
        var apellido = $('#apellido').val().trim();
        if (!nombre || !apellido) { mostrarError('#errDatos', '#errDatosTxt', 'El nombre y el apellido son obligatorios.'); return; }

        cargando('#btnGuardarDatos', true);
        $.post('@Url.Action("Editar", "Perfil")', { nombre: nombre, apellido: apellido })
            .done(function (res) {
                if (!res.exito) { mostrarError('#errDatos', '#errDatosTxt', res.mensaje); return; }
                mostrarToast(res.mensaje, 'success');
                // El header/sidebar se pintan con Session en el servidor: recargar para verlos actualizados.
                setTimeout(function () { location.reload(); }, 900);
            })
            .fail(function () { mostrarError('#errDatos', '#errDatosTxt', 'Error de conexión.'); })
            .always(function () { cargando('#btnGuardarDatos', false); });
    }

    // ---- Contraseña ----
    function cambiarPass() {
        ocultarError('#errPass');
        var actual = $('#passActual').val();
        var nueva = $('#passNueva').val();
        var conf = $('#passConfirm').val();

        if (!actual) { mostrarError('#errPass', '#errPassTxt', 'Debes ingresar tu contraseña actual.'); return; }
        if (nueva.length < 6) { mostrarError('#errPass', '#errPassTxt', 'La nueva contraseña debe tener al menos 6 caracteres.'); return; }
        if (nueva !== conf) { mostrarError('#errPass', '#errPassTxt', 'La confirmación no coincide.'); return; }

        cargando('#btnCambiarPass', true);
        $.post('@Url.Action("CambiarContrasena", "Perfil")', { actual: actual, nueva: nueva, confirmacion: conf })
            .done(function (res) {
                if (!res.exito) { mostrarError('#errPass', '#errPassTxt', res.mensaje); return; }
                mostrarToast(res.mensaje, 'success');
                $('#passActual, #passNueva, #passConfirm').val('');
                cargarPerfil();
            })
            .fail(function () { mostrarError('#errPass', '#errPassTxt', 'Error de conexión.'); })
            .always(function () { cargando('#btnCambiarPass', false); });
    }

    // ---- Helpers ----
    function cargando(sel, on) {
        $(sel).prop('disabled', on).find('.spinner').toggleClass('hidden', !on);
    }
    function mostrarError(box, txt, msg) { $(txt).text(msg); $(box).removeClass('hidden'); }
    function ocultarError(box) { $(box).addClass('hidden'); }

    function mostrarToast(msg, tipo) {
        var color = tipo === 'success' ? 'bg-green-600' : 'bg-red-600';
        var t = $('<div class="px-4 py-3 rounded-lg text-white text-sm font-medium shadow-lg pointer-events-auto ' + color + '"></div>').text(msg);
        $('#toastContainer').append(t);
        setTimeout(function () { t.fadeOut(300, function () { $(this).remove(); }); }, 3500);
    }

    function parseFecha(val) {
        if (!val) return null;
        var ms = parseInt(String(val).replace('/Date(', '').replace(')/', ''));
        return new Date(ms);
    }
    function pad(n) { return String(n).padStart(2, '0'); }
    function fmtFecha(val) {
        var d = parseFecha(val); if (!d) return '-';
        return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear();
    }
    function fmtFechaHora(val) {
        var d = parseFecha(val); if (!d) return '-';
        return fmtFecha(val) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }
    function escapeHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
</script>
}
