<?xml version="1.0" encoding="utf-8"?>
<!-- PLANTILLA. Copia este archivo a 'Secrets.config' (mismo folder) y completa
     los valores reales. 'Secrets.config' esta en .gitignore y NO se sube a git.

     Son las MISMAS credenciales que usa CapaPresentacionAdmin: la cooperativa
     tiene una sola cuenta de comercio en Libelula. El portal las necesita
     porque ahora el socio puede generar su propio QR desde 'Mis avisos'. -->
<appSettings>
  <add key="Libelula.AppKey"  value="TU-APPKEY-DE-LIBELULA" />
  <add key="Libelula.UrlBase" value="https://api.libelula.bo" />
  <!-- URL PUBLICA del callback PAGO EXITOSO (accesible desde internet).
       Sin ella el pago igual funciona: el socio confirma con el boton
       "Ya pagué / Verificar" del modal, que reconsulta la pasarela.
       Si se expone el portal con un tunel, apuntar a:
       https://TU-TUNEL-PUBLICO/Portal/PagoExitoso -->
  <!-- <add key="Libelula.CallbackUrl" value="https://TU-TUNEL-PUBLICO/Portal/PagoExitoso" /> -->
</appSettings>
