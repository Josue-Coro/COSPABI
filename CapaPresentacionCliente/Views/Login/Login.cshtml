@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Portal del Socio – COSPABI</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #1c2434;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 28px 16px 44px;
        }

        @@keyframes cardUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .card-enter { animation: cardUp 0.35s ease both; }

        .logo-wrap {
            width: 68px; height: 68px;
            border-radius: 18px;
            background: #22c55e;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 14px;
        }

        .login-card {
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0,0,0,0.18);
        }
        .card-stripe {
            height: 4px;
            background: #22c55e;
        }
        .card-body-inner { padding: 28px 24px 32px; }

        .form-label-lg {
            font-size: 14px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 7px;
            display: block;
        }

        /* 16px evita zoom automático en iOS */
        .input-field {
            font-size: 16px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            padding: 13px 14px 13px 44px;
            border: 1.5px solid #d1d5db;
            border-radius: 12px;
            background: #f8fafc;
            color: #1e293b;
            width: 100%;
            transition: border-color 0.2s, box-shadow 0.2s;
            -webkit-appearance: none;
        }
        .input-field::placeholder { color: #94a3b8; }
        .input-field:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
            outline: none;
            background: #fff;
        }

        .input-wrap { position: relative; }
        .input-icon {
            position: absolute; top: 50%; left: 13px;
            transform: translateY(-50%);
            color: #94a3b8; pointer-events: none; display: flex;
        }
        .toggle-pass {
            position: absolute; top: 50%; right: 11px;
            transform: translateY(-50%);
            background: none; border: none; padding: 4px;
            cursor: pointer; color: #94a3b8; display: flex;
        }
        .toggle-pass:hover { color: #475569; }

        .btn-login {
            width: 100%;
            padding: 15px;
            font-size: 16px;
            font-weight: 700;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #fff;
            background: #16a34a;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            transition: background 0.2s, transform 0.15s;
            -webkit-appearance: none;
        }
        .btn-login:hover:not(:disabled) { background: #15803d; transform: translateY(-1px); }
        .btn-login:active:not(:disabled) { transform: translateY(0); }
        .btn-login:disabled { opacity: 0.55; cursor: not-allowed; }

        @@keyframes spin { to { transform: rotate(360deg); } }
        .spinner {
            width: 18px; height: 18px;
            border: 2px solid rgba(255,255,255,0.35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            display: none;
        }

        .alert-error {
            display: none;
            background: #fef2f2;
            border: 1.5px solid #fca5a5;
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 18px;
        }
        .alert-error-text { font-size: 14px; font-weight: 500; color: #b91c1c; line-height: 1.45; }

        @@keyframes shake {
            0%,100% { transform: translateX(0); }
            25%,75%  { transform: translateX(-4px); }
            50%      { transform: translateX(4px); }
        }
        .shake { animation: shake 0.32s ease both; }

        .page-footer { font-size: 12px; color: rgba(255,255,255,0.35); text-align: center; margin-top: 20px; }
    </style>
</head>
<body>

    <div class="w-100 card-enter" style="max-width:400px;">

        <div class="text-center mb-4">
            <div class="logo-wrap">
                <svg width="34" height="34" fill="white" viewBox="0 0 24 24">
                    <path d="M12 2C8.5 7 5 10.5 5 14a7 7 0 0014 0c0-3.5-3.5-7-7-12z"/>
                </svg>
            </div>
            <h1 style="font-size:24px; font-weight:800; color:#fff; margin:0; letter-spacing:-0.3px;">COSPABI</h1>
            <p style="font-size:13px; color:rgba(255,255,255,0.5); margin-top:3px; margin-bottom:0;">Portal del Socio</p>
        </div>

        <div class="login-card">
            <div class="card-stripe"></div>
            <div class="card-body-inner">

                <h2 style="font-size:20px; font-weight:700; color:#1e293b; margin-bottom:3px;">Bienvenido</h2>
                <p style="font-size:14px; color:#64748b; margin-bottom:24px; line-height:1.5;">
                    Ingresa tu usuario y contraseña para ver tus avisos de agua.
                </p>

                <form id="loginForm" method="post" novalidate autocomplete="on">

                    <div class="mb-4">
                        <label for="usuario" class="form-label-lg">Tu usuario</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </span>
                            <input type="text" id="usuario" name="usuario"
                                   class="input-field" autocomplete="username"
                                   placeholder="Escribe tu usuario" autofocus required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="contrasena" class="form-label-lg">Tu contraseña</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </span>
                            <input type="password" id="contrasena" name="contrasena"
                                   class="input-field" style="padding-right:44px;"
                                   autocomplete="current-password"
                                   placeholder="Escribe tu contraseña" required>
                            <button type="button" id="togglePassword" class="toggle-pass" aria-label="Mostrar contraseña">
                                <svg id="iconMostrar" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                <svg id="iconOcultar" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none;">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div id="errorMsg" class="alert-error" role="alert" aria-live="assertive">
                        <div class="d-flex align-items-start" style="gap:8px;">
                            <svg width="18" height="18" fill="#ef4444" viewBox="0 0 20 20" style="flex-shrink:0;margin-top:1px;">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            </svg>
                            <span id="errorText" class="alert-error-text"></span>
                        </div>
                    </div>

                    <button type="submit" id="btnSubmit" class="btn-login">
                        <span id="btnText">Ingresar</span>
                        <span id="btnSpinner" class="spinner"></span>
                    </button>

                </form>

                <p style="text-align:center; font-size:13px; color:#94a3b8; margin-top:20px; margin-bottom:0; line-height:1.5;">
                    ¿Problemas para ingresar? Comunícate con la oficina de COSPABI.
                </p>
            </div>
        </div>

        <p class="page-footer">&copy; @DateTime.Now.Year COSPABI &mdash; Todos los derechos reservados</p>
    </div>

    <script>
        $(function () {
            $("#togglePassword").on("click", function () {
                var $inp = $("#contrasena");
                var esPass = $inp.attr("type") === "password";
                $inp.attr("type", esPass ? "text" : "password");
                $("#iconMostrar").toggle(!esPass);
                $("#iconOcultar").toggle(esPass);
            });

            function mostrarError(msg) {
                $("#errorText").text(msg);
                $("#errorMsg").show();
                $("#loginForm").addClass("shake");
                setTimeout(function () { $("#loginForm").removeClass("shake"); }, 340);
            }
            function ocultarError() { $("#errorMsg").hide(); $("#errorText").text(""); }
            function setLoading(on) {
                $("#btnSubmit").prop("disabled", on);
                $("#btnText").text(on ? "Validando..." : "Ingresar");
                if (on) $("#btnSpinner").show(); else $("#btnSpinner").hide();
            }

            $("#loginForm").on("submit", function (e) {
                e.preventDefault();
                ocultarError();
                var usuario    = $.trim($("#usuario").val());
                var contrasena = $("#contrasena").val();
                if (!usuario || !contrasena) { mostrarError("Por favor completa tu usuario y contraseña."); return; }
                setLoading(true);
                $.ajax({
                    url: '@Url.Action("ValidarLogin", "Login")',
                    type: "POST",
                    data: { usuario: usuario, contrasena: contrasena },
                    success: function (r) {
                        if (r.resultado === true) {
                            window.location.href = '@Url.Action("Index", "Home")';
                        } else {
                            mostrarError(r.mensaje || "Usuario o contraseña incorrectos.");
                            setLoading(false);
                        }
                    },
                    error: function () {
                        mostrarError("No se pudo conectar. Por favor intenta de nuevo.");
                        setLoading(false);
                    }
                });
            });
        });
    </script>

</body>
</html>
