

@{
    ViewBag.Title = "EliminarSocio";
    Layout = null;
    int id = 0;
    int.TryParse(Request.QueryString["id"], out id);
    string nombre = Request.QueryString["nombre"] ?? "este socio";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link href="~/Content/app.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: transparent;
        }

        .btn-danger {
            background: linear-gradient(135deg,#ef4444 0%,#dc2626 100%);
            transition: opacity 0.2s, transform 0.15s;
        }

            .btn-danger:hover:not(:disabled) {
                opacity: 0.92;
                transform: translateY(-1px);
            }

            .btn-danger:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }
    </style>
</head>
<body class="p-3">

    <input type="hidden" id="idSocio" value="@id">

    <div class="flex flex-col items-center text-center mb-5">
        <div class="w-14 h-14 rounded-full bg-red-100 flex items-center justify-center mb-3">
            <svg style="width:28px;height:28px;" class="text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
        </div>
        <p class="text-sm text-gray-600">
            ¿Deseas eliminar al socio
            <span class="font-semibold text-gray-800">"@nombre"</span>?
        </p>
        <p class="text-xs text-gray-400 mt-1">Esta acción no se puede deshacer.</p>
    </div>

    <div id="errorMsg" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span id="errorText"></span>
    </div>

    <div class="flex gap-3">
        <button onclick="window.parent.cerrarEliminar()"
                class="flex-1 py-2.5 rounded-xl text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">
            Cancelar
        </button>
        <button id="btnEliminar" onclick="eliminar()"
                class="btn-danger flex-1 py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
            <span id="btnText">Sí, eliminar</span>
            <svg id="btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
            </svg>
        </button>
    </div>

    <script>
    function eliminar() {
        setLoading(true);
        $.ajax({
            url:  '@Url.Action("Eliminar", "Socio")',
            type: 'POST',
            data: { id: $('#idSocio').val() },
            success: function (res) {
                if (res.exito) { window.parent.onAccionCompletada(); }
                else {
                    $('#errorText').text(res.mensaje || 'No se pudo eliminar el socio.');
                    $('#errorMsg').removeClass('hidden');
                    setLoading(false);
                }
            },
            error: function () {
                $('#errorText').text('Error de conexión. Intenta nuevamente.');
                $('#errorMsg').removeClass('hidden');
                setLoading(false);
            }
        });
    }

    function setLoading(v) {
        $('#btnEliminar').prop('disabled', v);
        $('#btnText').text(v ? 'Eliminando...' : 'Sí, eliminar');
        $('#btnSpinner').toggleClass('hidden', !v);
    }
    </script>
</body>
</html>


