@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal del Socio – COSPABI</title>
    <link rel="icon" href="~/favicon.ico" />
    <link href="~/Content/app.css?v=@Recursos.AppCss()" rel="stylesheet" />
</head>
<body class="bg-slate-100 text-on-background font-sans antialiased min-h-screen flex items-center justify-center p-4">

    @* Halos decorativos del mockup: se quedan detras de la tarjeta *@
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0" aria-hidden="true">
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-primary-container rounded-full mix-blend-multiply blur-[100px] opacity-20"></div>
        <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-primary-700 rounded-full mix-blend-multiply blur-[100px] opacity-10"></div>
    </div>

    <main class="w-full max-w-[420px] mx-auto relative z-10 animate-fade-in-up">

        <div class="bg-surface-container-lowest rounded-xl elevation-1 p-8 sm:p-10 flex flex-col items-center">

            @* ---- Marca ---- *@
            <div class="w-16 h-16 rounded-xl gradient-primary flex items-center justify-center text-on-primary mb-4 shadow-lg shadow-primary-container/25">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.7 7.05 7.65a7 7 0 1 0 9.9 0z" />
                </svg>
            </div>

            <div class="text-center mb-8 w-full">
                <h1 class="font-headline-md text-headline-md text-on-surface mb-1">Bienvenido socio</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Ingresa tus datos para acceder a tu portal.</p>
            </div>

            @* ---- Formulario ---- *@
            <form id="loginForm" method="post" novalidate autocomplete="on" class="w-full flex flex-col gap-5">

                <div class="flex flex-col gap-1.5 w-full">
                    <label for="usuario" class="font-label-sm text-label-sm text-on-surface ml-1">Tu usuario</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-3 text-outline-variant pointer-events-none">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="5" width="20" height="14" rx="2" /><circle cx="8.5" cy="11.5" r="2.5" /><path d="M14 10h5" /><path d="M14 14h3" />
                            </svg>
                        </span>
                        <input type="text" id="usuario" name="usuario" autocomplete="username" autofocus required
                               placeholder="Escribe tu usuario"
                               class="font-body-md text-body-md w-full pl-11 pr-4 py-3 rounded-lg bg-slate-100 border border-outline-variant text-on-surface placeholder:text-outline-variant focus:outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-[3px] focus:ring-primary-container/15 transition-all">
                    </div>
                </div>

                <div class="flex flex-col gap-1.5 w-full">
                    <label for="contrasena" class="font-label-sm text-label-sm text-on-surface ml-1">Tu contraseña</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-3 text-outline-variant pointer-events-none">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input type="password" id="contrasena" name="contrasena" autocomplete="current-password" required
                               placeholder="Escribe tu contraseña"
                               class="font-body-md text-body-md w-full pl-11 pr-11 py-3 rounded-lg bg-slate-100 border border-outline-variant text-on-surface placeholder:text-outline-variant focus:outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-[3px] focus:ring-primary-container/15 transition-all">
                        <button type="button" id="togglePassword" aria-label="Mostrar contraseña"
                                class="absolute right-3 text-outline-variant hover:text-on-surface transition-colors focus:outline-none">
                            <svg id="iconMostrar" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" />
                            </svg>
                            <svg id="iconOcultar" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true">
                                <path d="M9.9 5.2A9.8 9.8 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3 3.9" />
                                <path d="M6.2 6.2A17 17 0 0 0 2 12s3.6 7 10 7a9.8 9.8 0 0 0 4.2-.9" />
                                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /><path d="m2 2 20 20" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div id="errorMsg" role="alert" aria-live="assertive"
                     class="hidden items-start gap-2 bg-error-container/60 border border-error-red/40 rounded-lg px-3.5 py-3">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5 text-error-red" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" />
                    </svg>
                    <span id="errorText" class="font-label-sm text-label-sm text-on-error-container leading-snug"></span>
                </div>

                <button type="submit" id="btnSubmit"
                        class="w-full mt-1 py-3.5 px-6 rounded-xl gradient-primary text-on-primary font-label-sm text-label-sm font-semibold shadow-[0_4px_10px_rgba(34,197,94,0.2)] hover:shadow-[0_6px_14px_rgba(34,197,94,0.3)] hover:-translate-y-px active:translate-y-px disabled:opacity-60 disabled:translate-y-0 transition-all flex items-center justify-center gap-2 group">
                    <span id="btnText">Iniciar sesión</span>
                    <svg id="btnFlecha" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                        <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                    </svg>
                    <span id="btnSpinner" class="hidden w-[18px] h-[18px] rounded-full border-2 border-white/35 border-t-white animate-spin"></span>
                </button>

            </form>

            <div class="mt-8 text-center w-full">
                <p class="font-caption text-caption leading-relaxed text-on-surface-variant flex items-center justify-center gap-1.5">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><path d="M12 17h.01" />
                    </svg>
                    ¿Problemas para ingresar? Comunícate con la oficina de COSPABI.
                </p>
            </div>

        </div>

        <p class="text-center font-caption text-caption text-on-surface-variant mt-6">
            &copy; @DateTime.Now.Year Cooperativa de Agua Potable COSPABI R.L.
        </p>
    </main>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script>
        $(function () {

            $("#togglePassword").on("click", function () {
                var $inp = $("#contrasena");
                var esPass = $inp.attr("type") === "password";
                $inp.attr("type", esPass ? "text" : "password");
                $("#iconMostrar").toggleClass("hidden", esPass);
                $("#iconOcultar").toggleClass("hidden", !esPass);
                $(this).attr("aria-label", esPass ? "Ocultar contraseña" : "Mostrar contraseña");
            });

            function mostrarError(msg) {
                $("#errorText").text(msg);
                $("#errorMsg").removeClass("hidden").addClass("flex");
                $("#loginForm").addClass("shake");
                setTimeout(function () { $("#loginForm").removeClass("shake"); }, 340);
            }

            function ocultarError() {
                $("#errorMsg").addClass("hidden").removeClass("flex");
                $("#errorText").text("");
            }

            function setLoading(on) {
                $("#btnSubmit").prop("disabled", on);
                $("#btnText").text(on ? "Validando…" : "Iniciar sesión");
                $("#btnFlecha").toggleClass("hidden", on);
                $("#btnSpinner").toggleClass("hidden", !on);
            }

            $("#loginForm").on("submit", function (e) {
                e.preventDefault();
                ocultarError();

                var usuario = $.trim($("#usuario").val());
                var contrasena = $("#contrasena").val();
                if (!usuario || !contrasena) {
                    mostrarError("Por favor completa tu usuario y contraseña.");
                    return;
                }

                setLoading(true);
                $.ajax({
                    url: '@Url.Action("ValidarLogin", "Login")',
                    type: "POST",
                    data: { usuario: usuario, contrasena: contrasena },
                    success: function (r) {
                        if (r.resultado === true) {
                            window.location.href = '@Url.Action("Index", "Home")';
                        } else {
                            // El mensaje viene del SP: generico si fallo la credencial,
                            // explicito si la cuenta quedo bloqueada por intentos fallidos.
                            mostrarError(r.mensaje || "Usuario o contraseña incorrectos.");
                            setLoading(false);
                        }
                    },
                    error: function () {
                        mostrarError("No se pudo conectar. Por favor intenta de nuevo.");
                        setLoading(false);
                    }
                });
            });
        });
    </script>

</body>
</html>
