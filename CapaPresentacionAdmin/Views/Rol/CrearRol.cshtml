@{
    ViewBag.Title = "CrearRol";
    Layout = null; 
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link href="~/Content/app.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans',sans-serif;
            background: transparent;
        }

        .input-field {
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .input-field:focus {
                border-color: #22c55e;
                box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
                outline: none;
            }

        .btn-primary {
            background: linear-gradient(135deg,#22c55e 0%,#16a34a 100%);
            transition: opacity 0.2s,transform 0.15s;
        }

            .btn-primary:hover:not(:disabled) {
                opacity: 0.92;
                transform: translateY(-1px);
            }

            .btn-primary:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }
    </style>
</head>
<body class="p-1">

    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Nombre del Rol</label>
        <input type="text" id="nombre" placeholder="Ej: Administrador"
               class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
    </div>

    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Descripción</label>
        <textarea id="descripcion" rows="3" placeholder="Describe las responsabilidades de este rol..."
                  class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400 resize-none"></textarea>
    </div>

    <div class="mb-5">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Estado</label>
        <select id="estado" class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
            <option value=""> Seleccionar </option>
            <option value="true">Activo</option>
            <option value="false">Inactivo</option>
        </select>
    </div>

    <div id="errorMsg" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span id="errorText"></span>
    </div>

    <button id="btnGuardar" onclick="registrar()"
            class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
        <span id="btnText">Guardar Rol</span>
        <svg id="btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
        </svg>
    </button>

    <script>
        function registrar() {
            var nombre     = $.trim($('#nombre').val());
            var descripcion = $.trim($('#descripcion').val());
            var estado     = $('#estado').val();

            if (!nombre)      { mostrarError('El nombre del rol es obligatorio.'); return; }
            if (!descripcion) { mostrarError('La descripción es obligatoria.'); return; }
            if (estado === '') { mostrarError('Selecciona el estado del rol.'); return; }

            ocultarError();
            setLoading(true);

            $.ajax({
                url: '@Url.Action("RegistrarRol", "Rol")',
                type: 'POST',
                data: { nombre: nombre, descripcion: descripcion, estado: estado },
                success: function (res) {
                    if (res.resultado > 0) {
                        window.parent.onAccionCompletada();
                    } else {
                        mostrarError(res.mensaje || 'No se pudo registrar el rol.');
                        setLoading(false);
                    }
                },
                error: function () {
                    mostrarError('Error de conexión. Intenta nuevamente.');
                    setLoading(false);
                }
            });
        }

        function mostrarError(msg) { $('#errorText').text(msg); $('#errorMsg').removeClass('hidden'); }
        function ocultarError()    { $('#errorMsg').addClass('hidden'); }
        function setLoading(v)     { $('#btnGuardar').prop('disabled', v); $('#btnText').text(v ? 'Guardando...' : 'Guardar Rol'); $('#btnSpinner').toggleClass('hidden', !v); }
    </script>
</body>
</html>

