@{
    ViewBag.Title = "Mis Avisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f1f5f9; }

    .card-portal {
        background: #fff; border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
        overflow: hidden; margin-bottom: 14px;
    }
    .card-portal-header {
        background: #f8fafc; padding: 12px 18px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px; color: #64748b;
    }
    .resumen-grid { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
    .resumen-item {
        flex: 1; min-width: 140px; background: #fff; border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07); padding: 14px 16px; text-align: center;
    }
    .resumen-item .num { font-size: 22px; font-weight: 800; color: #1e293b; }
    .resumen-item .lbl { font-size: 11px; color: #94a3b8; text-transform: uppercase; font-weight: 600; }
    .resumen-item.deuda .num { color: #dc2626; }

    .tabla-avisos { width: 100%; font-size: 14px; }
    .tabla-avisos th {
        text-align: left; padding: 10px 18px; font-size: 11px;
        text-transform: uppercase; color: #94a3b8; border-bottom: 1px solid #f1f5f9;
    }
    .tabla-avisos td { padding: 10px 18px; border-bottom: 1px solid #f1f5f9; color: #334155; }
    .tabla-avisos tr:last-child td { border-bottom: none; }
    .monto { font-weight: 700; color: #1e293b; white-space: nowrap; }

    .badge-estado {
        font-size: 11px; font-weight: 600;
        padding: 3px 10px; border-radius: 20px; display: inline-block;
    }
    .badge-PAGADO   { background: #dcfce7; color: #15803d; }
    .badge-pendiente{ background: #fffbeb; color: #d97706; }
    .badge-vencido  { background: #fef2f2; color: #dc2626; }
    .badge-ANULADO  { background: #f1f5f9; color: #64748b; }
    .sin-datos { padding: 24px; text-align: center; color: #94a3b8; font-size: 14px; }
</style>

<div class="resumen-grid" id="resumen"></div>

<div class="card-portal">
    <div class="card-portal-header">Historial de avisos de cobranza</div>
    <div style="overflow-x:auto">
        <table class="tabla-avisos">
            <thead>
                <tr>
                    <th>Período</th>
                    <th>Emisión</th>
                    <th>Vence</th>
                    <th style="text-align:right">Consumo</th>
                    <th>Estado</th>
                    <th style="text-align:right">Total</th>
                    <th style="text-align:right">Deuda</th>
                </tr>
            </thead>
            <tbody id="tbodyAvisos">
                <tr><td colspan="7" class="sin-datos">Cargando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section scripts {
<script>
    function fmt(n) { return (n == null ? 0 : n).toLocaleString('es-BO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function parseNet(v) { if (!v) return null; var m = /\/Date\((\d+)\)\//.exec(v); var d = m ? new Date(parseInt(m[1])) : new Date(v); return isNaN(d) ? null : d; }
    function ffecha(v) { var d = parseNet(v); return d ? d.toLocaleDateString('es-BO') : '-'; }

    $(function () {
        $.get('@Url.Action("Resumen", "Portal")', function (res) {
            if (!res.exito) return;
            var r = res.resumen;
            $('#resumen').html(
                '<div class="resumen-item deuda"><div class="num">Bs. ' + fmt(r.deuda_total) + '</div><div class="lbl">Deuda total</div></div>' +
                '<div class="resumen-item"><div class="num">' + r.avisos_pendientes + '</div><div class="lbl">Avisos pendientes</div></div>' +
                '<div class="resumen-item"><div class="num">' + r.avisos_vencidos + '</div><div class="lbl">Vencidos</div></div>'
            );
        });

        $.get('@Url.Action("ListarAvisos", "Portal")', function (res) {
            var tb = $('#tbodyAvisos'); tb.empty();
            if (!res.exito || !res.avisos.length) {
                tb.html('<tr><td colspan="7" class="sin-datos">No tienes avisos registrados.</td></tr>');
                return;
            }
            $.each(res.avisos, function (_, a) {
                var badge;
                if (a.estado === 'PAGADO')       badge = '<span class="badge-estado badge-PAGADO">PAGADO</span>';
                else if (a.estado === 'ANULADO') badge = '<span class="badge-estado badge-ANULADO">ANULADO</span>';
                else if (a.vencido)              badge = '<span class="badge-estado badge-vencido">VENCIDO</span>';
                else                             badge = '<span class="badge-estado badge-pendiente">PENDIENTE</span>';
                tb.append('<tr>' +
                    '<td>' + a.nombre_periodo + '</td>' +
                    '<td>' + ffecha(a.fecha_emision) + '</td>' +
                    '<td>' + ffecha(a.fecha_vencimiento) + '</td>' +
                    '<td style="text-align:right">' + (a.consumo_m3 != null ? fmt(a.consumo_m3) + ' m&sup3;' : '-') + '</td>' +
                    '<td>' + badge + '</td>' +
                    '<td style="text-align:right" class="monto">Bs. ' + fmt(a.total_aviso) + '</td>' +
                    '<td style="text-align:right" class="monto">Bs. ' + fmt(a.deuda_actual) + '</td>' +
                    '</tr>');
            });
        });
    });
</script>
}
