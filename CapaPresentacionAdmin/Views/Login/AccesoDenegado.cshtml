@{
    ViewBag.Title = "Acceso denegado";
    Layout = null;

    var rol     = Session["RolUsuario"] as string;
    var permiso = Request.QueryString["permiso"];
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Content/app.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: transparent; }
    </style>
</head>
<body>
    <div class="flex items-center justify-center p-6" style="min-height:100vh">
        <div class="max-w-sm w-full text-center">

            <div class="w-20 h-20 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-5">
                <svg style="width:40px;height:40px;" class="text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>

            <h1 class="text-2xl font-bold text-gray-800">Acceso denegado</h1>
            <p class="text-sm text-gray-500 mt-2 leading-relaxed">
                @if (!string.IsNullOrEmpty(rol))
                {
                    <text>Tu rol <span class="font-semibold text-gray-700">@rol</span> no tiene permiso para acceder a esta sección.</text>
                }
                else
                {
                    <text>Tu usuario no tiene permiso para acceder a esta sección.</text>
                }
            </p>

            @if (!string.IsNullOrEmpty(permiso))
            {
                <div class="mt-4 inline-flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-700 text-xs font-medium px-3 py-1.5 rounded-full">
                    <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                    Permiso requerido: <span class="font-semibold">@permiso</span>
                </div>
            }

            <p class="text-xs text-gray-400 mt-5">
                Si crees que se trata de un error, comunícate con el administrador del sistema.
            </p>

            <div class="flex items-center justify-center gap-3 mt-6">
                <button type="button" id="btnVolver" onclick="volverAtras()"
                        class="px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">
                    Volver atrás
                </button>
                <button type="button" onclick="irInicio()"
                        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white transition"
                        style="background:linear-gradient(135deg,#22c55e 0%,#16a34a 100%)">
                    <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    Ir al inicio
                </button>
            </div>

        </div>
    </div>

    <script>
        // La vista puede cargarse en pantalla completa o DENTRO de un iframe (modal).
        // window.frameElement es el <iframe> en la página padre (null si es página completa).
        var _frame = null;
        try { _frame = window.frameElement; } catch (e) { _frame = null; }
        var _enModal = !!_frame;

        // Si estamos dentro de un modal, el botón "atrás" en realidad cierra el modal.
        if (_enModal) {
            var b = document.getElementById('btnVolver');
            if (b) b.textContent = 'Cerrar';
        }

        function irInicio() {
            // Salir del modal (si aplica) y navegar la ventana superior al inicio.
            (window.top || window).location.href = '@Url.Action("Index", "Home")';
        }

        function volverAtras() {
            if (_enModal) {
                // Cerrar el modal padre: ocultar el contenedor overlay que envuelve al iframe.
                var overlay = _frame.closest('.fixed');
                if (overlay) {
                    overlay.classList.add('hidden');
                    overlay.classList.remove('flex');
                }
                _frame.removeAttribute('src');   // liberar el iframe
                return;
            }
            // Página completa: retroceder normalmente.
            window.history.back();
        }
    </script>
</body>
</html>
