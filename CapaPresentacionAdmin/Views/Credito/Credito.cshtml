@{
    ViewBag.Title = "Credito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-6">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Créditos de Inscripción</h1>
        <p class="text-sm text-gray-500 mt-1">Socios con cuotas de inscripción pendientes</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
        <div class="p-4 border-b border-gray-100">
            <input type="text" id="txtBuscar" placeholder="Buscar por nombre o código..."
                   class="w-full sm:w-80 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-gray-500">
                    <tr>
                        <th class="px-4 py-3 text-left  font-semibold uppercase text-xs">Socio</th>
                        <th class="px-4 py-3 text-left  font-semibold uppercase text-xs">Código</th>
                        <th class="px-4 py-3 text-right font-semibold uppercase text-xs">Total</th>
                        <th class="px-4 py-3 text-right font-semibold uppercase text-xs">Pagado</th>
                        <th class="px-4 py-3 text-right font-semibold uppercase text-xs">Saldo</th>
                        <th class="px-4 py-3 text-center font-semibold uppercase text-xs">Cuotas pend.</th>
                        <th class="px-4 py-3 text-left  font-semibold uppercase text-xs">Próxima cuota</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody id="tbody" class="divide-y divide-gray-100"></tbody>
            </table>
        </div>
        <div class="p-4 border-t border-gray-100 flex items-center justify-between">
            <span id="lblInfo" class="text-xs text-gray-400"></span>
            <div id="divPag" class="flex gap-1"></div>
        </div>
    </div>
</div>

<div id="modalDetalle" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40" onclick="cerrarModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between">
            <h3 class="text-base font-bold text-gray-800" id="modalTitulo">Cuotas</h3>
            <button onclick="cerrarModal()" class="p-1 hover:bg-gray-100 rounded-lg text-gray-500">&times;</button>
        </div>
        <div id="modalBody" class="px-5 py-4 overflow-y-auto"></div>
    </div>
</div>

@section scripts {
<script>
    var pagina = 1, total = 0, tam = 10, timer;

    $(function () {
        cargar();
        $('#txtBuscar').on('input', function () {
            clearTimeout(timer);
            timer = setTimeout(function () { pagina = 1; cargar(); }, 350);
        });
    });

    function fmt(n) { return (n == null ? 0 : n).toLocaleString('es-BO'); }

    function cargar() {
        $.get('@Url.Action("Listar", "Credito")', {
            busqueda: $('#txtBuscar').val(), pagina: pagina, tamanoPagina: tam
        }, function (res) {
            var tb = $('#tbody'); tb.empty();
            if (!res.exito) { tb.html('<tr><td colspan="8" class="text-center py-6 text-red-500">' + (res.mensaje || 'Error') + '</td></tr>'); return; }
            if (res.creditos.length === 0) {
                tb.html('<tr><td colspan="8" class="text-center py-6 text-gray-400">Sin cuotas pendientes</td></tr>');
                $('#divPag').empty(); $('#lblInfo').text(''); return;
            }
            total = res.totalRegistros;
            $.each(res.creditos, function (_, c) {
                tb.append(
                    '<tr class="hover:bg-gray-50">' +
                    '<td class="px-4 py-3 font-medium text-gray-800">' + c.nombre_socio + '</td>' +
                    '<td class="px-4 py-3 text-gray-500">' + c.codigo_fijo + '</td>' +
                    '<td class="px-4 py-3 text-right font-mono text-gray-600">Bs. ' + fmt(c.total_inscripcion) + '</td>' +
                    '<td class="px-4 py-3 text-right font-mono text-green-700">Bs. ' + fmt(c.pagado) + '</td>' +
                    '<td class="px-4 py-3 text-right font-mono font-semibold text-amber-700">Bs. ' + fmt(c.saldo) + '</td>' +
                    '<td class="px-4 py-3 text-center"><span class="inline-block px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold">' + c.cuotas_pendientes + '</span></td>' +
                    '<td class="px-4 py-3 text-gray-600">' + (c.proximo_periodo ? (c.proximo_periodo + ' &middot; Bs. ' + fmt(c.proximo_monto)) : '-') + '</td>' +
                    '<td class="px-4 py-3 text-right"><button onclick="verDetalle(' + c.id_socio + ',\'' + c.nombre_socio.replace(/'/g, "\\'") + '\')" class="text-blue-600 hover:text-blue-800 text-xs font-semibold">Ver cuotas</button></td>' +
                    '</tr>'
                );
            });
            renderPag();
        });
    }

    function renderPag() {
        var totalP = Math.ceil(total / tam);
        $('#lblInfo').text(((pagina - 1) * tam + 1) + '–' + Math.min(pagina * tam, total) + ' de ' + total);
        var div = $('#divPag'); div.empty();
        var b = 'px-2.5 py-1 text-xs rounded border transition ';
        div.append('<button ' + (pagina === 1 ? 'disabled' : '') + ' onclick="pagina--;cargar()" class="' + b + (pagina === 1 ? 'text-gray-300 border-gray-200' : 'text-gray-600 border-gray-300 hover:bg-gray-100') + '">‹</button>');
        for (var p = 1; p <= totalP; p++)
            div.append('<button onclick="pagina=' + p + ';cargar()" class="' + b + (p === pagina ? 'bg-blue-600 text-white border-blue-600' : 'text-gray-600 border-gray-300 hover:bg-gray-100') + '">' + p + '</button>');
        div.append('<button ' + (pagina === totalP ? 'disabled' : '') + ' onclick="pagina++;cargar()" class="' + b + (pagina === totalP ? 'text-gray-300 border-gray-200' : 'text-gray-600 border-gray-300 hover:bg-gray-100') + '">›</button>');
    }

    function verDetalle(idSocio, nombre) {
        $('#modalTitulo').text('Cuotas de ' + nombre);
        $('#modalBody').html('<div class="text-center py-6 text-gray-400">Cargando...</div>');
        $('#modalDetalle').removeClass('hidden');
        $.get('@Url.Action("Detalle", "Credito")', { idSocio: idSocio }, function (res) {
            if (!res.exito) { $('#modalBody').html('<div class="text-red-500 py-4 text-center">' + (res.mensaje || 'Error') + '</div>'); return; }
            var reciboUrl = '@Url.Action("ImprimirReciboInscripcion", "Credito")';
            var rows = res.cuotas.map(function (q) {
                var badge = q.estado === 'CANCELADO'
                    ? '<span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold">CANCELADO</span>'
                    : '<span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold">PENDIENTE</span>';
                var av = q.en_aviso ? '<span class="text-xs text-gray-400 ml-1">(aviso #' + q.aviso_id_aviso + ')</span>' : '';
                // La cuota inicial (pago directo en caja) tiene su recibo; las demás se cobran en el aviso
                var recibo = q.pago_id_pago
                    ? '<a href="' + reciboUrl + '?idPago=' + q.pago_id_pago + '" target="_blank" ' +
                      'class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-800 text-xs font-semibold">' +
                      '<svg style="width:13px;height:13px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
                      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
                      'd="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>' +
                      '</svg>Recibo</a>'
                    : '';
                return '<div class="flex items-center justify-between py-2 border-b border-gray-100">' +
                    '<div><span class="font-semibold text-gray-700">Cuota ' + q.num_cuota + '</span> ' +
                    '<span class="text-xs text-gray-500 ml-1">' + q.nombre_periodo + '</span> ' + av +
                    (recibo ? '<div class="mt-0.5">' + recibo + '</div>' : '') + '</div>' +
                    '<div class="flex items-center gap-3"><span class="font-mono text-gray-700">Bs. ' + fmt(q.monto_pago) + '</span>' + badge + '</div>' +
                    '</div>';
            }).join('');
            $('#modalBody').html(rows || '<div class="text-gray-400 py-4 text-center">Sin cuotas.</div>');
        }).fail(function () { $('#modalBody').html('<div class="text-red-500 py-4 text-center">Error de conexión.</div>'); });
    }

    function cerrarModal() { $('#modalDetalle').addClass('hidden'); }
</script>
}
