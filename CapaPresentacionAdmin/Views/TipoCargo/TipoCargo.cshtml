@{
    ViewBag.Title = "TipoCargo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-xl font-semibold text-gray-800">Gestión de Tipos de Cargo</h1>
        <p class="text-sm text-gray-400 mt-0.5">Administra los tipos de cargo del sistema</p>
    </div>
    <button onclick="abrirCrear()"
            class="btn-primary inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white">
        <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Nuevo Tipo de Cargo
    </button>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <span class="text-sm font-semibold text-gray-700">Lista de Tipos de Cargo</span>
        <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-1.5 w-52">
            <svg style="width:15px;height:15px;" class="text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="buscador" placeholder="Buscar..."
                   class="bg-transparent text-sm text-gray-600 outline-none w-full placeholder-gray-400">
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">#</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Nombre</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Monto</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Estado</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="bodyTipoCargo" class="divide-y divide-gray-100">
                <tr>
                    <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-400">
                        <svg class="animate-spin mx-auto mb-2" style="width:22px;height:22px;" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                        </svg>
                        Cargando tipos de cargo...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="px-6 py-3 border-t border-gray-100">
        <span class="text-xs text-gray-400" id="contadorTipoCargo"></span>
    </div>
</div>

<!-- Modal Crear -->
<div id="modalCrear" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarCrear()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Nuevo Tipo de Cargo</h3>
                <button onclick="cerrarCrear()" class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Nombre</label>
                <input type="text" id="c_nombre" placeholder="Ej: Cuota mensual"
                       class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Monto (Bs.)</label>
                <input type="number" step="0.001" min="0" id="c_monto" placeholder="Ej: 150.000"
                       class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Estado</label>
                <select id="c_estado" class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    <option value=""> Seleccionar </option>
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
            </div>
            <div id="c_errorMsg" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span id="c_errorText"></span>
            </div>
            <button id="c_btnGuardar" onclick="registrar()"
                    class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
                <span id="c_btnText">Guardar</span>
                <svg id="c_btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div id="modalEditar" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarEditar()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Editar Tipo de Cargo</h3>
                <button onclick="cerrarEditar()" class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <input type="hidden" id="e_idTipo">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Nombre</label>
                <input type="text" id="e_nombre" placeholder="Ej: Cuota mensual"
                       class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Monto (Bs.)</label>
                <input type="number" step="0.001" min="0" id="e_monto" placeholder="Ej: 150.000"
                       class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Estado</label>
                <select id="e_estado" class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
            </div>
            <div id="e_errorMsg" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span id="e_errorText"></span>
            </div>
            <button id="e_btnGuardar" onclick="editar()"
                    class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
                <span id="e_btnText">Guardar Cambios</span>
                <svg id="e_btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div id="modalEliminar" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarEliminar()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-red-400 to-red-600"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Desactivar Tipo de Cargo</h3>
                <button onclick="cerrarEliminar()" class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <input type="hidden" id="d_idTipo">
            <div class="flex flex-col items-center text-center mb-5">
                <div class="w-14 h-14 rounded-full bg-red-100 flex items-center justify-center mb-3">
                    <svg style="width:28px;height:28px;" class="text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                    </svg>
                </div>
                <p class="text-sm text-gray-600">
                    ¿Estás seguro de que deseas desactivar el tipo de cargo
                    <span id="d_nombre" class="font-semibold text-gray-800"></span>?
                </p>
                <p class="text-xs text-gray-400 mt-1">Quedará inactivo y no podrá asignarse.</p>
            </div>
            <div id="d_errorMsg" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span id="d_errorText"></span>
            </div>
            <div class="flex gap-3">
                <button onclick="cerrarEliminar()"
                        class="flex-1 py-2.5 rounded-xl text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">
                    Cancelar
                </button>
                <button id="d_btnEliminar" onclick="eliminar()"
                        class="btn-danger flex-1 py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
                    <span id="d_btnText">Sí, desactivar</span>
                    <svg id="d_btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    }

        .btn-primary:hover:not(:disabled) {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(34,197,94,0.30);
        }

        .btn-primary:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    .btn-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        transition: opacity 0.2s, transform 0.15s;
    }

        .btn-danger:hover:not(:disabled) {
            opacity: 0.92;
            transform: translateY(-1px);
        }

        .btn-danger:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    .input-field {
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .input-field:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
            outline: none;
        }
</style>

@section scripts {
    <script>
    // -- Cargar tabla --
    function cargarTipoCargo() {
        $.ajax({
            url: '@Url.Action("ListarTipoCargo", "TipoCargo")',
            type: 'GET',
            success: function (res) {
                var filas = '';
                if (!res.data || res.data.length === 0) {
                    filas = '<tr><td colspan="5" class="px-6 py-10 text-center text-sm text-gray-400">No hay tipos de cargo registrados.</td></tr>';
                    $('#contadorTipoCargo').text('');
                } else {
                    $.each(res.data, function (i, r) {
                        var badge = r.estado
                            ? '<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Activo</span>'
                            : '<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Inactivo</span>';
                        var monto = parseFloat(r.monto).toFixed(2);
                        filas += '<tr class="hover:bg-gray-50 transition fila-tipocargo">' +
                            '<td class="px-6 py-3.5 text-gray-400 text-xs">' + (i + 1) + '</td>' +
                            '<td class="px-6 py-3.5 font-medium text-gray-800">' + r.nombre + '</td>' +
                            '<td class="px-6 py-3.5 text-gray-600">Bs. ' + monto + '</td>' +
                            '<td class="px-6 py-3.5">' + badge + '</td>' +
                            '<td class="px-6 py-3.5 text-center">' +
                            '  <div class="inline-flex items-center gap-1">' +
                            '    <button onclick="abrirEditar(' + r.id_tipo + ')" title="Editar"' +
                            '            class="p-1.5 rounded-lg text-gray-400 hover:bg-green-50 hover:text-green-600 transition">' +
                            '      <svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
                            '        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>' +
                            '      </svg>' +
                            '    </button>' +
                            '    <button onclick="abrirEliminar(' + r.id_tipo + ',\'' + r.nombre.replace(/'/g, "\\'") + '\')" title="Desactivar"' +
                            '            class="p-1.5 rounded-lg text-gray-400 hover:bg-red-50 hover:text-red-500 transition">' +
                            '      <svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
                            '        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>' +
                            '      </svg>' +
                            '    </button>' +
                            '  </div>' +
                            '</td></tr>';
                    });
                    $('#contadorTipoCargo').text(res.data.length + ' tipo(s) de cargo');
                }
                $('#bodyTipoCargo').html(filas);
            },
            error: function () {
                $('#bodyTipoCargo').html('<tr><td colspan="5" class="px-6 py-10 text-center text-sm text-red-500">Error al cargar los datos.</td></tr>');
            }
        });
    }

    $('#buscador').on('input', function () {
        var t = $(this).val().toLowerCase();
        $('.fila-tipocargo').each(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(t) !== -1);
        });
    });

    // -- Crear --
    function abrirCrear() {
        $('#c_nombre').val(''); $('#c_monto').val(''); $('#c_estado').val('');
        ocultarError('c'); setLoading('c', false);
        $('#modalCrear').removeClass('hidden').addClass('flex');
    }
    function cerrarCrear() {
        $('#modalCrear').removeClass('flex').addClass('hidden');
        setLoading('c', false);
    }

    function registrar() {
        var nombre = $.trim($('#c_nombre').val());
        var monto  = $('#c_monto').val();
        var estado = $('#c_estado').val();

        if (!nombre)            { mostrarError('c', 'El nombre es obligatorio.'); return; }
        if (!monto || parseFloat(monto) <= 0) { mostrarError('c', 'El monto debe ser mayor a cero.'); return; }
        if (estado === '')      { mostrarError('c', 'Selecciona el estado.'); return; }

        ocultarError('c'); setLoading('c', true);

        $.ajax({
            url: '@Url.Action("RegistrarTipoCargo", "TipoCargo")',
            type: 'POST',
            data: { nombre: nombre, monto: monto, estado: estado },
            success: function (res) {
                if (res.resultado > 0) { cerrarCrear(); cargarTipoCargo(); }
                else { mostrarError('c', res.mensaje || 'No se pudo registrar.'); setLoading('c', false); }
            },
            error: function () { mostrarError('c', 'Error de conexión.'); setLoading('c', false); }
        });
    }

    // -- Editar --
    function abrirEditar(id) {
        ocultarError('e'); setLoading('e', false);
        $.ajax({
            url: '@Url.Action("ListarTipoCargo", "TipoCargo")',
            type: 'GET',
            success: function (res) {
                var r = $.grep(res.data, function (x) { return x.id_tipo === id; })[0];
                if (r) {
                    $('#e_idTipo').val(r.id_tipo);
                    $('#e_nombre').val(r.nombre);
                    $('#e_monto').val(parseFloat(r.monto).toFixed(3));
                    $('#e_estado').val(r.estado.toString());
                }
                $('#modalEditar').removeClass('hidden').addClass('flex');
            }
        });
    }
    function cerrarEditar() {
        $('#modalEditar').removeClass('flex').addClass('hidden');
        setLoading('e', false);
    }

    function editar() {
        var id     = $('#e_idTipo').val();
        var nombre = $.trim($('#e_nombre').val());
        var monto  = $('#e_monto').val();
        var estado = $('#e_estado').val();

        if (!nombre)            { mostrarError('e', 'El nombre es obligatorio.'); return; }
        if (!monto || parseFloat(monto) <= 0) { mostrarError('e', 'El monto debe ser mayor a cero.'); return; }

        ocultarError('e'); setLoading('e', true);

        $.ajax({
            url: '@Url.Action("EditarTipoCargo", "TipoCargo")',
            type: 'POST',
            data: { id_tipo: id, nombre: nombre, monto: monto, estado: estado },
            success: function (res) {
                if (res.resultado === true) { cerrarEditar(); cargarTipoCargo(); }
                else { mostrarError('e', res.mensaje || 'No se pudo actualizar.'); setLoading('e', false); }
            },
            error: function () { mostrarError('e', 'Error de conexión.'); setLoading('e', false); }
        });
    }

    // -- Eliminar --
    function abrirEliminar(id, nombre) {
        $('#d_idTipo').val(id);
        $('#d_nombre').text('"' + nombre + '"');
        ocultarError('d'); setLoading('d', false);
        $('#modalEliminar').removeClass('hidden').addClass('flex');
    }
    function cerrarEliminar() {
        $('#modalEliminar').removeClass('flex').addClass('hidden');
        setLoading('d', false);
    }

    function eliminar() {
        var id = $('#d_idTipo').val();
        ocultarError('d'); setLoading('d', true);

        $.ajax({
            url: '@Url.Action("EliminarTipoCargo", "TipoCargo")',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res.resultado === true) { cerrarEliminar(); cargarTipoCargo(); }
                else { mostrarError('d', res.mensaje || 'No se pudo desactivar.'); setLoading('d', false); }
            },
            error: function () { mostrarError('d', 'Error de conexión.'); setLoading('d', false); }
        });
    }

    // -- Helpers --
    function mostrarError(p, msg) { $('#' + p + '_errorText').text(msg); $('#' + p + '_errorMsg').removeClass('hidden'); }
    function ocultarError(p)      { $('#' + p + '_errorMsg').addClass('hidden'); }
    function setLoading(p, v) {
        var textos = { c: ['Guardar', 'Guardando...'], e: ['Guardar Cambios', 'Guardando...'], d: ['Sí, desactivar', 'Desactivando...'] };
        var btn    = p === 'd' ? 'd_btnEliminar' : p + '_btnGuardar';
        $('#' + btn).prop('disabled', v);
        $('#' + p + '_btnText').text(v ? textos[p][1] : textos[p][0]);
        $('#' + p + '_btnSpinner').toggleClass('hidden', !v);
    }

    $(function () { cargarTipoCargo(); });
    </script>
}

