
@{
    ViewBag.Title = "Ruta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-xl font-semibold text-gray-800">Gestión de Rutas</h1>
        <p class="text-sm text-gray-400 mt-0.5">Administra las rutas del sistema</p>
    </div>
    <button onclick="abrirCrear()"
            class="btn-primary inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white">
        <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Nueva Ruta
    </button>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <span class="text-sm font-semibold text-gray-700">Lista de Rutas</span>
        <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-1.5 w-52">
            <svg style="width:15px;height:15px;" class="text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="buscador" placeholder="Buscar ruta..."
                   class="bg-transparent text-sm text-gray-600 outline-none w-full placeholder-gray-400">
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">#</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">N° Ruta</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Descripción</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="bodyRutas" class="divide-y divide-gray-100">
                <tr>
                    <td colspan="4" class="px-6 py-10 text-center text-sm text-gray-400">
                        <svg class="animate-spin mx-auto mb-2" style="width:22px;height:22px;" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                        </svg>
                        Cargando rutas...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="px-6 py-3 border-t border-gray-100">
        <span class="text-xs text-gray-400" id="contadorRutas"></span>
    </div>
</div>

<!-- Modal Crear -->
<div id="modalCrear" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarCrear()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Nueva Ruta</h3>
                <button onclick="cerrarCrear()" class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Formulario Crear inline -->
            <div id="formCrear">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">N° de Ruta <span class="text-red-500">*</span></label>
                    <input type="number" id="c_ruta" placeholder="Ej: 101"
                           class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Descripción</label>
                    <input type="text" id="c_descripcion" placeholder="Ej: Ruta norte - centro"
                           class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
                </div>
                <div id="c_errorMsg" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span id="c_errorText"></span>
                </div>
                <button id="c_btnGuardar" onclick="registrar()"
                        class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
                    <span id="c_btnText">Guardar Ruta</span>
                    <svg id="c_btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div id="modalEditar" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarEditar()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Editar Ruta</h3>
                <button onclick="cerrarEditar()" class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Formulario Editar inline -->
            <div id="formEditar">
                <input type="hidden" id="e_idRuta">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">N° de Ruta <span class="text-red-500">*</span></label>
                    <input type="number" id="e_ruta" placeholder="Ej: 101"
                           class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Descripción</label>
                    <input type="text" id="e_descripcion" placeholder="Ej: Ruta norte - centro"
                           class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
                </div>
                <div id="e_errorMsg" class="hidden mb-4 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span id="e_errorText"></span>
                </div>
                <button id="e_btnGuardar" onclick="editar()"
                        class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
                    <span id="e_btnText">Guardar Cambios</span>
                    <svg id="e_btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    }

        .btn-primary:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(34,197,94,0.30);
        }

    .input-field {
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .input-field:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
            outline: none;
        }
</style>

@section scripts {
    <script>
    function cargarRutas() {
        $.ajax({
            url: '@Url.Action("ListarRutas", "Ruta")',
            type: 'GET',
            success: function (res) {
                var filas = '';
                if (!res.data || res.data.length === 0) {
                    filas = '<tr><td colspan="4" class="px-6 py-10 text-center text-sm text-gray-400">No hay rutas registradas.</td></tr>';
                    $('#contadorRutas').text('');
                } else {
                    $.each(res.data, function (i, r) {
                        filas += '<tr class="hover:bg-gray-50 transition fila-ruta">' +
                            '<td class="px-6 py-3.5 text-gray-400 text-xs">' + (i + 1) + '</td>' +
                            '<td class="px-6 py-3.5 font-medium text-gray-800">' + r.ruta + '</td>' +
                            '<td class="px-6 py-3.5 text-gray-500">' + (r.descripcion || '') + '</td>' +
                            '<td class="px-6 py-3.5 text-center">' +
                            '  <button onclick="abrirEditar(' + r.id_ruta + ')" title="Editar" ' +
                            '          class="p-1.5 rounded-lg text-gray-400 hover:bg-green-50 hover:text-green-600 transition">' +
                            '    <svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
                            '      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>' +
                            '    </svg>' +
                            '  </button>' +
                            '</td></tr>';
                    });
                    $('#contadorRutas').text(res.data.length + ' ruta(s)');
                }
                $('#bodyRutas').html(filas);
            },
            error: function () {
                $('#bodyRutas').html('<tr><td colspan="4" class="px-6 py-10 text-center text-sm text-red-500">Error al cargar los datos.</td></tr>');
            }
        });
    }

    $('#buscador').on('input', function () {
        var t = $(this).val().toLowerCase();
        $('.fila-ruta').each(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(t) !== -1);
        });
    });

    // -- Crear --
    function abrirCrear() {
        $('#c_ruta').val(''); $('#c_descripcion').val(''); ocultarError('c');
        $('#modalCrear').removeClass('hidden').addClass('flex');
    }
        function cerrarCrear() {
            $('#modalCrear').removeClass('flex').addClass('hidden');
            setLoading('c', false);
        }

    function registrar() {
        var ruta        = $.trim($('#c_ruta').val());
        var descripcion = $.trim($('#c_descripcion').val());

        if (!ruta || parseInt(ruta) <= 0) { mostrarError('c', 'El número de ruta es obligatorio y debe ser mayor a cero.'); return; }

        ocultarError('c'); setLoading('c', true);

        $.ajax({
            url: '@Url.Action("RegistrarRuta", "Ruta")',
            type: 'POST',
            data: { ruta: ruta, descripcion: descripcion },
            success: function (res) {
                if (res.resultado > 0) { cerrarCrear(); cargarRutas(); }
                else { mostrarError('c', res.mensaje || 'No se pudo registrar la ruta.'); setLoading('c', false); }
            },
            error: function () { mostrarError('c', 'Error de conexión. Intenta nuevamente.'); setLoading('c', false); }
        });
    }

    // -- Editar --
    function abrirEditar(id) {
        ocultarError('e');
        $.ajax({
            url: '@Url.Action("ListarRutas", "Ruta")',
            type: 'GET',
            success: function (res) {
                var r = $.grep(res.data, function (x) { return x.id_ruta === id; })[0];
                if (r) {
                    $('#e_idRuta').val(r.id_ruta);
                    $('#e_ruta').val(r.ruta);
                    $('#e_descripcion').val(r.descripcion);
                }
                $('#modalEditar').removeClass('hidden').addClass('flex');
            }
        });
    }
        function cerrarEditar() {
            $('#modalEditar').removeClass('flex').addClass('hidden');
            setLoading('e', false); 
        }

    function editar() {
        var id          = $('#e_idRuta').val();
        var ruta        = $.trim($('#e_ruta').val());
        var descripcion = $.trim($('#e_descripcion').val());

        if (!ruta || parseInt(ruta) <= 0) { mostrarError('e', 'El número de ruta es obligatorio y debe ser mayor a cero.'); return; }

        ocultarError('e'); setLoading('e', true);

        $.ajax({
            url: '@Url.Action("EditarRuta", "Ruta")',
            type: 'POST',
            data: { id_ruta: id, ruta: ruta, descripcion: descripcion },
            success: function (res) {
                if (res.resultado === true) { cerrarEditar(); cargarRutas(); }
                else { mostrarError('e', res.mensaje || 'No se pudo actualizar la ruta.'); setLoading('e', false); }
            },
            error: function () { mostrarError('e', 'Error de conexión. Intenta nuevamente.'); setLoading('e', false); }
        });
    }

    // -- Helpers --
    function mostrarError(p, msg) { $('#' + p + '_errorText').text(msg); $('#' + p + '_errorMsg').removeClass('hidden'); }
    function ocultarError(p)      { $('#' + p + '_errorMsg').addClass('hidden'); }
    function setLoading(p, v) {
        $('#' + p + '_btnGuardar').prop('disabled', v);
        $('#' + p + '_btnText').text(v ? 'Guardando...' : (p === 'c' ? 'Guardar Ruta' : 'Guardar Cambios'));
        $('#' + p + '_btnSpinner').toggleClass('hidden', !v);
    }

    $(function () { cargarRutas(); });
    </script>
}

