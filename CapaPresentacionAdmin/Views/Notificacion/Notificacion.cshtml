@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-xl font-semibold text-gray-800">Notificaciones</h1>
        <p class="text-sm text-gray-400 mt-0.5">Administra las notificaciones del sistema</p>
    </div>
    <button onclick="abrirModal()"
            class="btn-primary inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white">
        <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Nueva Notificación
    </button>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <span class="text-sm font-semibold text-gray-700">Lista de Notificaciones</span>
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-1.5 w-52">
                <svg style="width:15px;height:15px;" class="text-gray-400 flex-shrink-0"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" id="txtBusqueda" placeholder="Buscar..."
                       class="bg-transparent text-sm text-gray-600 outline-none w-full placeholder-gray-400">
            </div>
            <select id="selTamano"
                    class="text-sm border border-gray-300 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-primary-500 outline-none">
                <option value="10">10 por página</option>
                <option value="25">25 por página</option>
                <option value="50">50 por página</option>
            </select>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">ID</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Título</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Mensaje</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Tipo</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Fecha</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyNotificaciones" class="divide-y divide-gray-100">
                <!-- Se llenará con Ajax -->
            </tbody>
        </table>
    </div>

    <div class="px-6 py-3 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-2">
        <span class="text-xs text-gray-400" id="infoPaginacion"></span>
        <div id="controlesPaginacion" class="flex items-center gap-1"></div>
    </div>
</div>

<!-- MODAL FORMULARIO -->
<div id="modalFormulario" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700"></div>
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800" id="modalTitulo">Nueva Notificación</h3>
                <button onclick="cerrarModal()"
                        class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            
            <input type="hidden" id="txtId" value="0" />
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Título <span class="text-red-500">*</span></label>
                    <input type="text" id="txtTitulo" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Ej: Aviso de corte" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mensaje <span class="text-red-500">*</span></label>
                    <textarea id="txtMensaje" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Detalle de la notificación..."></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Tipo <span class="text-red-500">*</span></label>
                    <select id="cboTipo" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <option value="Informativo">Informativo</option>
                        <option value="Alerta">Alerta</option>
                        <option value="Cobro">Cobro</option>
                    </select>
                </div>
                
                <div class="border-t border-gray-100 pt-4 mt-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Destinatarios</label>
                    <div class="flex gap-4 mb-3">
                        <label class="inline-flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="tipoDestinatario" value="todos" class="text-primary-600 focus:ring-primary-500" checked onchange="toggleDestinatarios()">
                            <span class="text-sm text-gray-700">Todos los socios</span>
                        </label>
                        <label class="inline-flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="tipoDestinatario" value="especificos" class="text-primary-600 focus:ring-primary-500" onchange="toggleDestinatarios()">
                            <span class="text-sm text-gray-700">Socios específicos</span>
                        </label>
                    </div>
                    
                    <div id="divSociosEspecificos" class="hidden">
                        <button type="button" onclick="abrirModalSocio()"
                                class="mb-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-lg transition inline-flex items-center gap-1.5">
                            <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                            Agregar Socios
                        </button>
                        <div id="listaSociosSeleccionados" class="flex flex-wrap gap-2 max-h-32 overflow-y-auto p-2 border border-gray-200 rounded-lg bg-gray-50 empty:hidden">
                            <!-- Los socios seleccionados aparecerán aquí como chips -->
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <button onclick="cerrarModal()" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition">Cancelar</button>
                <button onclick="guardar()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL BUSCAR SOCIO -->
<div id="modalSocio" class="fixed inset-0 z-[60] hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarModalSocio()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-200 flex items-center justify-between">
            <span class="text-sm font-semibold text-gray-800">Buscar Socio</span>
            <button onclick="cerrarModalSocio()" class="p-1.5 hover:bg-gray-100 rounded-lg transition">
                <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="px-5 py-2 border-b border-gray-100">
            <input type="text" id="txtBuscarSocio" placeholder="Nombre, CI o código fijo..."
                   class="w-full px-3 py-1.5 border border-gray-300 rounded-lg text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500">
        </div>
        <div class="overflow-y-auto flex-1">
            <table class="w-full text-xs">
                <thead class="bg-gray-50 sticky top-0">
                    <tr>
                        <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">Nombre</th>
                        <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">Cód. Fijo</th>
                        <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">CI Persona</th>
                        <th class="px-4 py-2"></th>
                    </tr>
                </thead>
                <tbody id="tbodySocios" class="divide-y divide-gray-100"></tbody>
            </table>
        </div>
        <div class="px-5 py-2 border-t border-gray-100 flex items-center justify-between bg-gray-50">
            <span id="lblInfoSocio" class="text-xs text-gray-400"></span>
            <div id="divPagSocio" class="flex gap-1"></div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    }
    .btn-primary:hover {
        opacity: 0.92;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(34,197,94,0.30);
    }
</style>

@section scripts {
    <script>
        var paginaActual = 1;
        var totalPaginas = 1;
        var busquedaActual = '';
        var tamanoPagina = 10;

        $(function () {
            cargarDatos();

            var timer;
            $('#txtBusqueda').on('input', function () {
                clearTimeout(timer);
                timer = setTimeout(function () {
                    busquedaActual = $('#txtBusqueda').val().trim();
                    paginaActual = 1;
                    cargarDatos();
                }, 400);
            });

            $('#selTamano').on('change', function () {
                tamanoPagina = parseInt($(this).val());
                paginaActual = 1;
                cargarDatos();
            });
        });

        function cargarDatos() {
            $('#tbodyNotificaciones').html('<tr><td colspan="6" class="px-6 py-10 text-center text-gray-400">Cargando...</td></tr>');
            $.ajax({
                url: '@Url.Action("Listar", "Notificacion")',
                type: 'GET',
                data: { busqueda: busquedaActual, pagina: paginaActual, tamanoPagina: tamanoPagina },
                success: function (res) {
                    if (!res.exito) { mostrarToast(res.mensaje, 'error'); return; }
                    var tbody = $('#tbodyNotificaciones');
                    tbody.empty();
                    
                    if (res.notificaciones.length === 0) {
                        tbody.append('<tr><td colspan="6" class="px-6 py-10 text-center text-gray-400">No hay registros.</td></tr>');
                    } else {
                        $.each(res.notificaciones, function (i, item) {
                            var btnEditar = '<button onclick="abrirModal(' + item.id_notificacion + ', \'' + item.titulo.replace(/'/g, "\\'") + '\', \'' + item.mensaje.replace(/'/g, "\\'") + '\', \'' + item.tipo + '\')" class="p-1.5 rounded-lg text-gray-400 hover:text-green-600 transition"><svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></button>';
                            var btnEliminar = '<button onclick="eliminar(' + item.id_notificacion + ')" class="p-1.5 rounded-lg text-gray-400 hover:text-red-500 transition"><svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>';

                            tbody.append(
                                '<tr class="hover:bg-gray-50">' +
                                '<td class="px-6 py-3.5 text-xs text-gray-500">' + item.id_notificacion + '</td>' +
                                '<td class="px-6 py-3.5 font-medium text-gray-800">' + item.titulo + '</td>' +
                                '<td class="px-6 py-3.5 text-gray-600">' + item.mensaje.substring(0, 50) + '...</td>' +
                                '<td class="px-6 py-3.5 text-gray-600">' + item.tipo + '</td>' +
                                '<td class="px-6 py-3.5 text-gray-600">' + parsearFechaNet(item.fecha_publicacion) + '</td>' +
                                '<td class="px-6 py-3.5 text-center"><div class="inline-flex items-center gap-1">' + btnEditar + btnEliminar + '</div></td>' +
                                '</tr>'
                            );
                        });
                    }

                    totalPaginas = Math.ceil(res.totalRegistros / tamanoPagina) || 1;
                    renderPaginacion(res.totalRegistros);
                }
            });
        }

        function renderPaginacion(total) {
            var inicio = total === 0 ? 0 : (paginaActual - 1) * tamanoPagina + 1;
            var fin = Math.min(paginaActual * tamanoPagina, total);
            $('#infoPaginacion').text('Mostrando ' + inicio + ' a ' + fin + ' de ' + total + ' registros');

            var ctrl = $('#controlesPaginacion');
            ctrl.empty();
            var base = 'px-3 py-1.5 text-xs rounded-lg border transition font-medium ';

            ctrl.append('<button ' + (paginaActual === 1 ? 'disabled' : '') +
                ' onclick="irPagina(' + (paginaActual - 1) + ')" class="' + base +
                (paginaActual === 1 ? 'opacity-40 cursor-not-allowed border-gray-200 text-gray-400'
                                    : 'border-gray-300 text-gray-600 hover:bg-gray-100') + '">< Ant</button>');

            var desde = Math.max(1, paginaActual - 2);
            var hasta = Math.min(totalPaginas, paginaActual + 2);
            for (var p = desde; p <= hasta; p++) {
                ctrl.append('<button onclick="irPagina(' + p + ')" class="' + base +
                    (p === paginaActual
                        ? 'bg-primary-500 text-white border-primary-500'
                        : 'border-gray-300 text-gray-600 hover:bg-gray-100') + '">' + p + '</button>');
            }

            ctrl.append('<button ' + (paginaActual === totalPaginas ? 'disabled' : '') +
                ' onclick="irPagina(' + (paginaActual + 1) + ')" class="' + base +
                (paginaActual === totalPaginas ? 'opacity-40 cursor-not-allowed border-gray-200 text-gray-400'
                                               : 'border-gray-300 text-gray-600 hover:bg-gray-100') + '">Sig ></button>');
        }

        function irPagina(p) {
            if (p < 1 || p > totalPaginas) return;
            paginaActual = p;
            cargarDatos();
        }

        var sociosSeleccionados = [];

        function toggleDestinatarios() {
            var tipo = $('input[name="tipoDestinatario"]:checked').val();
            if (tipo === 'especificos') {
                $('#divSociosEspecificos').removeClass('hidden');
            } else {
                $('#divSociosEspecificos').addClass('hidden');
            }
        }

        function abrirModal(id = 0, titulo = '', mensaje = '', tipo = 'Informativo') {
            $('#txtId').val(id);
            $('#txtTitulo').val(titulo);
            $('#txtMensaje').val(mensaje);
            $('#cboTipo').val(tipo);
            $('#modalTitulo').text(id == 0 ? "Nueva Notificación" : "Editar Notificación");
            
            // Reset destinatarios
            $('input[name="tipoDestinatario"][value="todos"]').prop('checked', true);
            sociosSeleccionados = [];
            renderSociosSeleccionados();
            toggleDestinatarios();

            if (id > 0) {
                // Cargar destinatarios actuales
                $.get('@Url.Action("ObtenerSociosAsignados", "Notificacion")', { idNotificacion: id }, function(res) {
                    if (res.exito && res.socios) {
                        if (res.socios.length > 0) {
                            $('input[name="tipoDestinatario"][value="especificos"]').prop('checked', true);
                            sociosSeleccionados = res.socios.map(function(s) { 
                                return { id: s.socio_id_socio, nombre: s.nombre_socio, codigo: s.codigo_fijo };
                            });
                            renderSociosSeleccionados();
                            toggleDestinatarios();
                        }
                    }
                });
            }

            $('#modalFormulario').removeClass('hidden').addClass('flex');
        }

        function cerrarModal() {
            $('#modalFormulario').removeClass('flex').addClass('hidden');
        }

        function guardar() {
            var isTodos = $('input[name="tipoDestinatario"]:checked').val() === 'todos';
            var ids = sociosSeleccionados.map(function(s) { return s.id; }).join(',');

            var obj = {
                id_notificacion: $('#txtId').val(),
                titulo: $('#txtTitulo').val(),
                mensaje: $('#txtMensaje').val(),
                tipo: $('#cboTipo').val(),
                enviar_a_todos: isTodos,
                ids_socios: isTodos ? "" : ids
            };

            $.ajax({
                url: '@Url.Action("Guardar", "Notificacion")',
                type: 'POST',
                data: obj,
                success: function (res) {
                    if (res.exito) {
                        mostrarToast(res.mensaje, 'success');
                        cerrarModal();
                        cargarDatos();
                    } else {
                        mostrarToast(res.mensaje, 'error');
                    }
                }
            });
        }

        function eliminar(id) {
            if (confirm('¿Está seguro de eliminar esta notificación?')) {
                $.ajax({
                    url: '@Url.Action("Eliminar", "Notificacion")',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.exito) {
                            mostrarToast(res.mensaje, 'success');
                            cargarDatos();
                        } else {
                            mostrarToast(res.mensaje, 'error');
                        }
                    }
                });
            }
        }

        function mostrarToast(msg, tipo) {
            var bg = tipo === 'success' ? 'bg-green-500' : 'bg-red-500';
            var toast = $('<div>').addClass('fixed bottom-6 right-6 z-50 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg ' + bg).text(msg);
            $('body').append(toast);
            setTimeout(function () { toast.fadeOut(400, function () { $(this).remove(); }); }, 3000);
        }

        function parsearFechaNet(val) {
            if (!val) return '—';
            var m = /\/Date\((\d+)\)\//.exec(val);
            if (m) return new Date(parseInt(m[1])).toISOString().substring(0, 10);
            return typeof val === 'string' ? val.substring(0, 10) : '—';
        }

        // --- LÓGICA DEL MODAL DE SOCIOS ---
        var timerSocio;
        var pagSocio = 1;
        var totalSocio = 0;

        $(function() {
            $('#txtBuscarSocio').on('input', function () {
                clearTimeout(timerSocio);
                timerSocio = setTimeout(function () {
                    pagSocio = 1;
                    cargarSociosModal();
                }, 400);
            });
        });

        function abrirModalSocio() {
            $('#txtBuscarSocio').val('');
            pagSocio = 1;
            cargarSociosModal();
            $('#modalSocio').removeClass('hidden').addClass('flex');
            setTimeout(function() { $('#txtBuscarSocio').focus(); }, 100);
        }

        function cerrarModalSocio() {
            $('#modalSocio').removeClass('flex').addClass('hidden');
        }

        function cargarSociosModal() {
            var busqueda = $('#txtBuscarSocio').val().trim();
            $('#tbodySocios').html('<tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">Cargando...</td></tr>');
            $.get('@Url.Action("ListarSocios", "CuentaSocio")', { busqueda: busqueda, pagina: pagSocio, tamanoPagina: 8 }, function (res) {
                if (!res.exito) return;
                totalSocio = res.totalRegistros;
                var tbody = $('#tbodySocios'); tbody.empty();
                if (res.socios.length === 0) {
                    tbody.append('<tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">No se encontraron socios.</td></tr>');
                    renderPagSocio(); return;
                }
                $.each(res.socios, function (i, s) {
                    // Verificar si ya está seleccionado
                    var yaSeleccionado = sociosSeleccionados.some(function(sel) { return sel.id == s.id_socio; });
                    var btnText = yaSeleccionado ? "Agregado" : "Seleccionar";
                    var btnClass = yaSeleccionado ? "bg-gray-200 text-gray-500 cursor-default" : "bg-primary-600 text-white hover:bg-primary-700";
                    var onclick = yaSeleccionado ? "" : 'onclick="agregarSocio(' + s.id_socio + ',\'' + s.nombre_socio.replace(/'/g, "\\'") + '\', \'' + s.codigo_fijo + '\')"';

                    tbody.append(
                        '<tr class="hover:bg-green-50 transition">' +
                        '<td class="px-4 py-2.5 font-medium text-gray-800">' + s.nombre_socio + '</td>' +
                        '<td class="px-4 py-2.5 text-gray-600 font-mono">' + s.codigo_fijo + '</td>' +
                        '<td class="px-4 py-2.5 text-gray-500">' + (s.ci_cliente || '-') + '</td>' +
                        '<td class="px-4 py-2.5 text-center">' +
                        '<button ' + onclick + ' class="text-xs px-2.5 py-1 rounded-lg transition ' + btnClass + '">' + btnText + '</button>' +
                        '</td></tr>'
                    );
                });
                renderPagSocio();
            });
        }

        function agregarSocio(id, nombre, codigo) {
            if (!sociosSeleccionados.some(function(s) { return s.id == id; })) {
                sociosSeleccionados.push({ id: id, nombre: nombre, codigo: codigo });
                renderSociosSeleccionados();
                // Actualizar botón en la tabla sin recargar todo
                cargarSociosModal(); 
            }
        }

        function quitarSocio(id) {
            sociosSeleccionados = sociosSeleccionados.filter(function(s) { return s.id != id; });
            renderSociosSeleccionados();
        }

        function renderSociosSeleccionados() {
            var div = $('#listaSociosSeleccionados');
            div.empty();
            if (sociosSeleccionados.length === 0) return;

            $.each(sociosSeleccionados, function(i, s) {
                div.append(
                    '<div class="inline-flex items-center gap-1.5 bg-white border border-gray-200 px-2.5 py-1 rounded-md shadow-sm">' +
                    '<span class="text-xs font-medium text-gray-700">' + s.nombre + ' <span class="text-gray-400 font-mono">(' + s.codigo + ')</span></span>' +
                    '<button type="button" onclick="quitarSocio(' + s.id + ')" class="text-gray-400 hover:text-red-500 p-0.5 rounded-md hover:bg-gray-100 transition">' +
                    '<svg style="width:12px;height:12px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>' +
                    '</button></div>'
                );
            });
        }

        function renderPagSocio() {
            var tam = 8;
            var totalP = Math.ceil(totalSocio / tam) || 1;
            var inicio = totalSocio === 0 ? 0 : (pagSocio - 1) * tam + 1;
            var fin = Math.min(pagSocio * tam, totalSocio);
            $('#lblInfoSocio').text(inicio + '–' + fin + ' de ' + totalSocio);
            var div = $('#divPagSocio'); div.empty();
            var b = 'px-2 py-1 text-xs rounded border transition font-medium ';
            div.append('<button ' + (pagSocio === 1 ? 'disabled' : '') + ' onclick="pagSocio--; cargarSociosModal()" class="' + b + (pagSocio === 1 ? 'text-gray-300 border-gray-200' : 'text-gray-600 border-gray-300 hover:bg-gray-100') + '">‹</button>');
            for (var p = Math.max(1, pagSocio - 2); p <= Math.min(totalP, pagSocio + 2); p++)
                div.append('<button onclick="pagSocio=' + p + '; cargarSociosModal()" class="' + b + (p === pagSocio ? 'bg-primary-500 text-white border-primary-500' : 'text-gray-600 border-gray-300 hover:bg-gray-100') + '">' + p + '</button>');
            div.append('<button ' + (pagSocio === totalP ? 'disabled' : '') + ' onclick="pagSocio++; cargarSociosModal()" class="' + b + (pagSocio === totalP ? 'text-gray-300 border-gray-200' : 'text-gray-600 border-gray-300 hover:bg-gray-100') + '">›</button>');
        }
    </script>
}
