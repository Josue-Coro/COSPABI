@{
    ViewBag.Title = "Bitacora";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-6">
    <h1 class="text-xl font-semibold text-gray-800">Bitácora del Sistema</h1>
    <p class="text-sm text-gray-400 mt-0.5">Registro de todas las acciones realizadas por los usuarios</p>
</div>

<!-- Panel de Filtros -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 mb-5">
    <p class="text-sm font-semibold text-gray-700 mb-4">Filtrar registros</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Fecha inicio -->
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Desde</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                    <svg style="width:14px;height:14px;" class="text-gray-400" fill="none"
                         stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </span>
                <input type="date" id="fechaInicio"
                       class="input-field w-full pl-9 pr-3 py-2.5 border border-gray-300 rounded-xl
                              text-sm bg-gray-50 text-gray-800">
            </div>
        </div>

        <!-- Fecha fin -->
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Hasta</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                    <svg style="width:14px;height:14px;" class="text-gray-400" fill="none"
                         stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </span>
                <input type="date" id="fechaFin"
                       class="input-field w-full pl-9 pr-3 py-2.5 border border-gray-300 rounded-xl
                              text-sm bg-gray-50 text-gray-800">
            </div>
        </div>

        <!-- Filtro por usuario -->
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Usuario</label>
            <select id="filtroUsuario"
                    class="input-field w-full px-3 py-2.5 border border-gray-300 rounded-xl
                           text-sm bg-gray-50 text-gray-800">
                <option value="0">— Todos los usuarios —</option>
            </select>
        </div>

        <!-- Botones -->
        <div class="flex items-end gap-2">
            <button onclick="buscar()"
                    class="btn-primary flex-1 py-2.5 rounded-xl text-sm font-semibold
                           text-white flex items-center justify-center gap-2">
                <svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Buscar
            </button>
            <button onclick="limpiarFiltros()" title="Limpiar filtros"
                    class="p-2.5 rounded-xl border border-gray-300 text-gray-500
                           hover:bg-gray-100 transition">
                <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Tabla de resultados -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <span class="text-sm font-semibold text-gray-700">Registros de actividad</span>
        <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-1.5 w-52">
            <svg style="width:14px;height:14px;" class="text-gray-400 flex-shrink-0"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="buscadorTabla" placeholder="Filtrar en tabla..."
                   class="bg-transparent text-sm text-gray-600 outline-none w-full placeholder-gray-400">
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">#</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Usuario</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Acción</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Fecha</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Hora</th>
                </tr>
            </thead>
            <tbody id="bodyBitacora" class="divide-y divide-gray-100">
                <tr>
                    <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-400">
                        Aplica los filtros y presiona <span class="font-medium">Buscar</span>
                        para ver los registros.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="px-6 py-3 border-t border-gray-100 flex items-center justify-between">
        <span class="text-xs text-gray-400" id="contadorBitacora"></span>
        <!-- Indicador de rango visible cuando hay filtro de fechas activo -->
        <span class="text-xs text-gray-400" id="rangoActivo"></span>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    }

        .btn-primary:hover:not(:disabled) {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(34,197,94,0.30);
        }

        .btn-primary:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    .input-field {
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .input-field:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
            outline: none;
        }
</style>

@section scripts {
    <script>
    // -- Cargar usuarios en el select de filtro ------------------------------
    $(function () {
        $.ajax({
            url: '@Url.Action("ListarUsuarios", "Bitacora")',
            type: 'GET',
            success: function (res) {
                $.each(res.data, function (i, u) {
                    $('#filtroUsuario').append(
                        '<option value="' + u.id_usuario_admin + '">' +
                        u.nombre + ' ' + u.apellido + ' (' + u.usuario + ')' +
                        '</option>'
                    );
                });
            }
        });

        // Cargar hoy por defecto
        var hoy = new Date().toISOString().split('T')[0];
        $('#fechaInicio').val(hoy);
        $('#fechaFin').val(hoy);
        buscar();
    });

    // -- Buscar --------------------------------------------------------------
    function buscar() {
        var fechaInicio = $('#fechaInicio').val();
        var fechaFin    = $('#fechaFin').val();
        var idUsuario   = $('#filtroUsuario').val();

        $('#bodyBitacora').html(
            '<tr><td colspan="5" class="px-6 py-10 text-center text-sm text-gray-400">' +
            '<svg class="animate-spin mx-auto mb-2" style="width:20px;height:20px;" fill="none" viewBox="0 0 24 24">' +
            '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>' +
            '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/></svg>' +
            'Cargando registros...</td></tr>'
        );
        $('#contadorBitacora').text('');
        $('#rangoActivo').text('');

        $.ajax({
            url: '@Url.Action("ListarBitacora", "Bitacora")',
            type: 'GET',
            data: {
                fechaInicio: fechaInicio,
                fechaFin:    fechaFin,
                idUsuario:   idUsuario
            },
            success: function (res) {
                renderizarTabla(res.data, fechaInicio, fechaFin);
            },
            error: function () {
                $('#bodyBitacora').html(
                    '<tr><td colspan="5" class="px-6 py-10 text-center text-sm text-red-500">' +
                    'Error al cargar los registros.</td></tr>'
                );
            }
        });
    }

    // -- Renderizar tabla ----------------------------------------------------
    function renderizarTabla(data, fechaInicio, fechaFin) {
        if (!data || data.length === 0) {
            $('#bodyBitacora').html(
                '<tr><td colspan="5" class="px-6 py-10 text-center text-sm text-gray-400">' +
                'No se encontraron registros para los filtros aplicados.</td></tr>'
            );
            $('#contadorBitacora').text('0 registros');
            return;
        }

        var filas = '';
        $.each(data, function (i, b) {

            var fecha = formatearFecha(b.fecha);
            var hora  = formatearHora(b.hora);

            // Iniciales del usuario
            var partes   = b.nombre_completo.split(' ');
            var iniciales = ((partes[0] || ' ')[0] + (partes[1] || ' ')[0]).toUpperCase();

            filas += '<tr class="hover:bg-gray-50 transition fila-bitacora">' +
                '<td class="px-6 py-3.5 text-gray-400 text-xs">' + (i+1) + '</td>' +
                '<td class="px-6 py-3.5">' +
                '  <div class="flex items-center gap-2.5">' +
                '    <div class="w-7 h-7 rounded-full bg-primary-100 flex items-center justify-center ' +
                '               text-primary-700 text-xs font-bold flex-shrink-0">' + iniciales + '</div>' +
                '    <div class="leading-none">' +
                '      <p class="text-sm font-medium text-gray-800">' + b.nombre_completo + '</p>' +
                '      <p class="text-xs text-gray-400 mt-0.5">@@' + b.usuario + '</p>' +
                '    </div>' +
                '  </div>' +
                '</td>' +
                '<td class="px-6 py-3.5 text-gray-600 max-w-xs">' +
                '  <span class="inline-flex items-center gap-1.5">' +
                '    <span class="w-1.5 h-1.5 rounded-full bg-primary-400 flex-shrink-0"></span>' +
                '    ' + b.accion +
                '  </span>' +
                '</td>' +
                '<td class="px-6 py-3.5 text-gray-500 text-xs whitespace-nowrap">' + fecha + '</td>' +
                '<td class="px-6 py-3.5 text-gray-500 text-xs whitespace-nowrap">' +
                '  <span class="px-2 py-0.5 bg-gray-100 rounded-lg font-mono">' + hora + '</span>' +
                '</td>' +
                '</tr>';
        });

        $('#bodyBitacora').html(filas);
        $('#contadorBitacora').text(data.length + ' registro(s)');

        if (fechaInicio && fechaFin) {
            $('#rangoActivo').text(
                fechaInicio === fechaFin
                    ? 'Mostrando: ' + fechaInicio
                    : 'Mostrando: ' + fechaInicio + ' — ' + fechaFin
            );
        }
    }

    // -- Buscador en tabla ---------------------------------------------------
    $('#buscadorTabla').on('input', function () {
        var t = $(this).val().toLowerCase();
        $('.fila-bitacora').each(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(t) !== -1);
        });
    });

    // -- Limpiar filtros -----------------------------------------------------
    function limpiarFiltros() {
        var hoy = new Date().toISOString().split('T')[0];
        $('#fechaInicio').val(hoy);
        $('#fechaFin').val(hoy);
        $('#filtroUsuario').val('0');
        $('#buscadorTabla').val('');
        $('.fila-bitacora').show();
        buscar();
    }

    // -- Helpers de formato --------------------------------------------------
    function formatearFecha(val) {
        if (!val) return '—';
        var ms   = parseInt(val.replace('/Date(', '').replace(')/', ''));
        var d    = new Date(ms);
        return d.toLocaleDateString('es-BO', { day:'2-digit', month:'2-digit', year:'numeric' });
    }

    function formatearHora(val) {
        if (!val) return '—';
        var ms  = parseInt(val.replace('/Date(', '').replace(')/', ''));
        var d   = new Date(ms);
        return d.toLocaleTimeString('es-BO', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    }
    </script>
}

