

@{
    ViewBag.Title = "CrearSocio";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link href="~/Content/app.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: transparent;
        }

        .input-field {
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .input-field:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
                outline: none;
            }

        .btn-primary {
            background: linear-gradient(135deg,#2563eb 0%,#1d4ed8 100%);
            transition: opacity 0.2s, transform 0.15s;
        }

            .btn-primary:hover:not(:disabled) {
                opacity: 0.92;
                transform: translateY(-1px);
            }

            .btn-primary:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }

        .section-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #6b7280;
            margin-bottom: 10px;
        }

            .section-title.blue {
                color: #2563eb;
            }
    </style>
</head>
<body class="p-3">

    <div class="mb-4">
        <div class="section-title">Datos del Cliente</div>
        <input type="hidden" id="hdnClienteId" />
        <div class="flex items-center gap-2">
            <div class="flex-1 px-3 py-2 border border-gray-300 rounded-xl bg-gray-50 text-sm min-h-[36px]">
                <span id="lblCliente" class="text-gray-400">Ningún cliente seleccionado</span>
            </div>
            <button type="button" onclick="abrirModalCliente()"
                    class="btn-primary px-3 py-2 rounded-xl text-xs font-semibold text-white">
                Buscar Cliente
            </button>
        </div>
        <span id="errCliente" class="hidden text-xs text-red-500">Debe seleccionar un cliente.</span>
    </div>

    <div class="mb-4 border border-blue-200 rounded-xl p-3">
        <div class="section-title blue">Contrato para el Socio</div>
        <div class="grid grid-cols-2 gap-3">

            <div class="col-span-2">
                <label class="block text-xs font-medium text-gray-700 mb-1">Nombre del Socio *</label>
                <input type="text" id="txtNombreSocio" placeholder="Nombre completo del socio"
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
                <span id="errNombreSocio" class="hidden text-xs text-red-500">Obligatorio.</span>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Rol del Socio *</label>
                <select id="selRol" class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    <option value="">-- Seleccionar --</option>
                </select>
                <span id="errRol" class="hidden text-xs text-red-500">Obligatorio.</span>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Ruta *</label>
                <select id="selRuta" class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    <option value="">-- Seleccionar --</option>
                </select>
                <span id="errRuta" class="hidden text-xs text-red-500">Obligatorio.</span>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Medidor *</label>
                <input type="hidden" id="hdnMedidorId" />
                <div class="flex items-center gap-2">
                    <div class="flex-1 px-3 py-2 border border-gray-300 rounded-xl bg-gray-50 text-sm min-h-[36px]">
                        <span id="lblMedidor" class="text-gray-400">Sin medidor</span>
                    </div>
                    <button type="button" onclick="abrirModalMedidor()"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold px-3 py-2 rounded-xl transition">
                        Seleccionar
                    </button>
                </div>
                <span id="errMedidor" class="hidden text-xs text-red-500">Obligatorio.</span>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Código Fijo *</label>
                <input type="number" id="txtCodigoFijo" placeholder="Ej: 1001"
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
                <span id="errCodigoFijo" class="hidden text-xs text-red-500">Obligatorio.</span>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Actividad *</label>
                <input type="text" id="txtActividad" placeholder="Ej: Doméstica"
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
                <span id="errActividad" class="hidden text-xs text-red-500">Obligatorio.</span>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Categoría *</label>
                <select id="selCategoria" class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    <option value="">-- Seleccionar --</option>
                    <option value="Doméstico">Doméstico</option>
                    <option value="Comercial">Comercial</option>
                    <option value="Industrial">Industrial</option>
                    <option value="Social">Social</option>
                </select>
                <span id="errCategoria" class="hidden text-xs text-red-500">Obligatorio.</span>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Fecha de Registro *</label>
                <input type="date" id="txtFechaRegistro"
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
            </div>

        </div>
    </div>

    <div class="mb-4 border border-emerald-200 rounded-xl p-3">
        <div class="section-title" style="color:#059669">Inscripción del Socio</div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Costo de inscripción</label>
                <div class="px-3 py-2 border border-gray-300 rounded-xl bg-gray-50 text-sm text-gray-800">
                    Bs. <span id="lblCosto" class="font-mono font-semibold">—</span>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Método de pago *</label>
                <select id="selMetodoPago" class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    <option value="">-- Seleccionar --</option>
                </select>
                <span id="errMetodo" class="hidden text-xs text-red-500">Seleccione un método de pago.</span>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Pago inicial (Bs.) *</label>
                <input type="number" id="txtMontoInicial" placeholder="mín. 500" min="500" step="1"
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
                <span id="errInicial" class="hidden text-xs text-red-500">Mín. 500, entero y no mayor al costo.</span>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">N° de cuotas *</label>
                <select id="selNumCuotas" class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800">
                    <option value="1">1 (pago total)</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>
            <div class="col-span-2 text-xs text-gray-500 bg-gray-50 rounded-lg px-3 py-2">
                Saldo a financiar: <span id="lblSaldo" class="font-mono font-semibold text-gray-700">Bs. 0</span>
                <span id="hintCuotas" class="ml-1 text-gray-400"></span>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div class="section-title">Datos de Instalación <span class="font-normal normal-case text-gray-400">(opcional)</span></div>
        <div class="grid grid-cols-3 gap-3">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Ubicación</label>
                <input type="number" id="txtUbicacion" placeholder="Nro."
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">N° Casa</label>
                <input type="number" id="txtNumCasa" placeholder="Nro."
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">N° Ocupantes</label>
                <input type="number" id="txtNumOcupantes" placeholder="Cant."
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Tipo Instalación</label>
                <input type="text" id="txtTipoInstalacion" placeholder="Ej: Superficial"
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
            <div class="col-span-2">
                <label class="block text-xs font-medium text-gray-700 mb-1">Dimensión Instalación</label>
                <input type="text" id="txtDimInstalacion" placeholder='Ej: 1/2"'
                       class="input-field w-full px-3 py-2 border border-gray-300 rounded-xl text-sm bg-gray-50 text-gray-800 placeholder-gray-400">
            </div>
        </div>
    </div>

    <div id="errorMsg" class="hidden mb-3 flex items-start gap-2 text-red-700 text-sm bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl">
        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span id="errorText"></span>
    </div>

    <button id="btnGuardar" onclick="registrar()"
            class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
        <span id="btnText">Registrar Socio</span>
        <svg id="btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
        </svg>
    </button>

    <div id="modalCliente" class="fixed inset-0 z-50 hidden items-center justify-center p-3">
        <div class="absolute inset-0 bg-black/40" onclick="cerrarModalCliente()"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
                <span class="text-sm font-semibold text-gray-800">Buscar Cliente</span>
                <button onclick="cerrarModalCliente()" class="p-1 hover:bg-gray-100 rounded-lg transition">
                    <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="px-4 py-2 border-b border-gray-100">
                <input type="text" id="txtBuscarCliente" placeholder="Nombre o CI..."
                       class="input-field w-full px-3 py-1.5 border border-gray-300 rounded-lg text-sm bg-gray-50">
            </div>
            <div class="overflow-y-auto flex-1">
                <table class="w-full text-xs">
                    <thead class="bg-gray-50 sticky top-0">
                        <tr>
                            <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">Nombre</th>
                            <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">CI</th>
                            <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">Teléfono</th>
                            <th class="px-4 py-2"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyClientes" class="divide-y divide-gray-100"></tbody>
                </table>
            </div>
            <div class="px-4 py-2 border-t border-gray-100 flex items-center justify-between bg-gray-50">
                <span id="lblInfoCliente" class="text-xs text-gray-400"></span>
                <div id="divPagCliente" class="flex gap-1"></div>
            </div>
        </div>
    </div>

    <div id="modalMedidor" class="fixed inset-0 z-50 hidden items-center justify-center p-3">
        <div class="absolute inset-0 bg-black/40" onclick="cerrarModalMedidor()"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md max-h-[80vh] flex flex-col overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
                <span class="text-sm font-semibold text-gray-800">Buscar Medidor</span>
                <button onclick="cerrarModalMedidor()" class="p-1 hover:bg-gray-100 rounded-lg transition">
                    <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="px-4 py-2 border-b border-gray-100">
                <input type="text" id="txtBuscarMedidor" placeholder="Serie o número..."
                       class="input-field w-full px-3 py-1.5 border border-gray-300 rounded-lg text-sm bg-gray-50">
            </div>
            <div class="overflow-y-auto flex-1">
                <table class="w-full text-xs">
                    <thead class="bg-gray-50 sticky top-0">
                        <tr>
                            <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">Serie</th>
                            <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">Número</th>
                            <th class="px-4 py-2 text-left text-gray-500 font-semibold uppercase">F. Instalación</th>
                            <th class="px-4 py-2"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyMedidores" class="divide-y divide-gray-100"></tbody>
                </table>
            </div>
            <div class="px-4 py-2 border-t border-gray-100 flex items-center justify-between bg-gray-50">
                <span id="lblInfoMedidor" class="text-xs text-gray-400"></span>
                <div id="divPagMedidor" class="flex gap-1"></div>
            </div>
        </div>
    </div>

    <script>
    var pagCliente = 1, totalCliente = 0, timerCliente;
    var pagMedidor = 1, totalMedidor = 0, timerMedidor;
    var costoInscripcion = 0;

    $(function () {
        $('#txtFechaRegistro').val(new Date().toISOString().split('T')[0]);
        cargarRoles();
        cargarRutas();
        cargarDatosInscripcion();
        $('#txtMontoInicial').on('input', actualizarSaldo);

        $('#txtBuscarCliente').on('input', function () {
            clearTimeout(timerCliente);
            timerCliente = setTimeout(function () { pagCliente = 1; cargarClientes(); }, 350);
        });
        $('#txtBuscarMedidor').on('input', function () {
            clearTimeout(timerMedidor);
            timerMedidor = setTimeout(function () { pagMedidor = 1; cargarMedidores(); }, 350);
        });
    });

    function cargarRoles() {
        $.get('@Url.Action("ListarRolSocio", "Socio")', function (res) {
            $.each(res.data, function (_, r) {
                $('#selRol').append('<option value="' + r.id_rol_socio + '">' + r.rol_socio + '</option>');
            });
        });
    }

    function cargarRutas() {
        $.get('@Url.Action("ListarRutas", "Socio")', function (res) {
            $.each(res.data, function (_, r) {
                $('#selRuta').append('<option value="' + r.id_ruta + '">' + r.ruta + '</option>');
            });
        });
    }

    function cargarDatosInscripcion() {
        $.get('@Url.Action("DatosInscripcion", "Socio")', function (res) {
            if (!res.exito) return;
            costoInscripcion = res.costo;
            $('#lblCosto').text(res.costo);
            $.each(res.metodos, function (_, m) {
                $('#selMetodoPago').append('<option value="' + m.id_metodo_pago + '">' + m.metodo + '</option>');
            });
            actualizarSaldo();
            if (!res.cajaAbierta) {
                mostrarError('Debes abrir tu caja antes de registrar un socio (el pago de inscripción entra a caja).');
                $('#btnGuardar').prop('disabled', true);
            }
        });
    }

    function actualizarSaldo() {
        var ini   = parseInt($('#txtMontoInicial').val()) || 0;
        var saldo = Math.max(0, costoInscripcion - ini);
        $('#lblSaldo').text('Bs. ' + saldo);
        $('#hintCuotas').text(saldo === 0 ? '(pago total → 1 cuota)' : '(elija entre 2 y 4 cuotas)');
    }

    // ── Modal Cliente ───────────────────────────
    function abrirModalCliente() {
        pagCliente = 1; $('#txtBuscarCliente').val('');
        $('#modalCliente').removeClass('hidden').addClass('flex');
        cargarClientes();
        setTimeout(function () { $('#txtBuscarCliente').focus(); }, 100);
    }
    function cerrarModalCliente() { $('#modalCliente').removeClass('flex').addClass('hidden'); }

    function cargarClientes() {
        $.get('@Url.Action("ListarCliente", "Socio")', {
            busqueda: $('#txtBuscarCliente').val(), pagina: pagCliente, tamanoPagina: 8
        }, function (res) {
            var tbody = $('#tbodyClientes');
            tbody.empty();
            if (!res.exito || res.clientes.length === 0) {
                tbody.html('<tr><td colspan="4" class="text-center py-4 text-gray-400">Sin resultados</td></tr>');
                return;
            }
            totalCliente = res.totalRegistros;
            $.each(res.clientes, function (_, c) {
                tbody.append(
                    '<tr class="hover:bg-blue-50 cursor-pointer transition" ' +
                    'onclick="seleccionarCliente(' + c.id_cliente + ',\'' + c.nombre_completo.replace(/'/g,"\\'") + '\',\'' + c.ci + '\')">' +
                    '<td class="px-4 py-2 font-medium text-gray-800">' + c.nombre_completo + '</td>' +
                    '<td class="px-4 py-2 text-gray-500">' + c.ci + '</td>' +
                    '<td class="px-4 py-2 text-gray-500">' + (c.telefono || '-') + '</td>' +
                    '<td class="px-4 py-2 text-center">' +
                    '<button class="bg-blue-600 text-white text-xs px-2 py-1 rounded-lg hover:bg-blue-700 transition">Seleccionar</button>' +
                    '</td></tr>'
                );
            });
            renderPagModal(totalCliente, pagCliente, 8, '#divPagCliente', '#lblInfoCliente', 'pagCliente', 'cargarClientes');
        });
    }
    function seleccionarCliente(id, nombre, ci) {
        $('#hdnClienteId').val(id);
        $('#lblCliente').html('<span class="font-medium text-gray-800">' + nombre + '</span> <span class="text-gray-400 text-xs ml-1">CI: ' + ci + '</span>');
        $('#errCliente').addClass('hidden');
        cerrarModalCliente();
    }

    // ── Modal Medidor ───────────────────────────
    function abrirModalMedidor() {
        pagMedidor = 1; $('#txtBuscarMedidor').val('');
        $('#modalMedidor').removeClass('hidden').addClass('flex');
        cargarMedidores();
        setTimeout(function () { $('#txtBuscarMedidor').focus(); }, 100);
    }
    function cerrarModalMedidor() { $('#modalMedidor').removeClass('flex').addClass('hidden'); }

    function cargarMedidores() {
        $.get('@Url.Action("ListarMedidores", "Socio")', {
            busqueda: $('#txtBuscarMedidor').val(), pagina: pagMedidor, tamanoPagina: 8
        }, function (res) {
            var tbody = $('#tbodyMedidores');
            tbody.empty();
            if (!res.data || res.data.length === 0) {
                tbody.html('<tr><td colspan="4" class="text-center py-4 text-gray-400">Sin resultados</td></tr>');
                return;
            }
            totalMedidor = res.totalRegistros;
            $.each(res.data, function (_, m) {
                var fecha = parsearFechaNet(m.fecha_instalacion);
                tbody.append(
                    '<tr class="hover:bg-blue-50 cursor-pointer transition" ' +
                    'onclick="seleccionarMedidor(' + m.id_medidor + ',\'' + m.serie + '\',' + m.numero + ')">' +
                    '<td class="px-4 py-2 font-mono font-medium text-gray-800">' + m.serie + '</td>' +
                    '<td class="px-4 py-2 text-gray-600">' + m.numero + '</td>' +
                    '<td class="px-4 py-2 text-gray-500">' + fecha + '</td>' +
                    '<td class="px-4 py-2 text-center">' +
                    '<button class="bg-blue-600 text-white text-xs px-2 py-1 rounded-lg hover:bg-blue-700 transition">Seleccionar</button>' +
                    '</td></tr>'
                );
            });
            renderPagModal(totalMedidor, pagMedidor, 8, '#divPagMedidor', '#lblInfoMedidor', 'pagMedidor', 'cargarMedidores');
        });
    }
    function seleccionarMedidor(id, serie, numero) {
        $('#hdnMedidorId').val(id);
        $('#lblMedidor').html('<span class="font-mono font-medium text-gray-800">' + serie + '</span> <span class="text-gray-400 text-xs ml-1">N° ' + numero + '</span>');
        $('#errMedidor').addClass('hidden');
        cerrarModalMedidor();
    }

    // ── Paginación modal genérica ───────────────
    function renderPagModal(total, pagActual, tam, divSel, lblSel, varPag, fnCargar) {
        var totalP = Math.ceil(total / tam);
        $(lblSel).text((pagActual-1)*tam+1 + '–' + Math.min(pagActual*tam,total) + ' de ' + total);
        var div = $(divSel); div.empty();
        var b = 'px-2 py-1 text-xs rounded border transition ';
        div.append('<button ' + (pagActual===1?'disabled':'') + ' onclick="' + varPag + '--; ' + fnCargar + '()" class="' + b + (pagActual===1?'text-gray-300 border-gray-200':'text-gray-600 border-gray-300 hover:bg-gray-100') + '">‹</button>');
        for (var p = 1; p <= totalP; p++)
            div.append('<button onclick="' + varPag + '=' + p + '; ' + fnCargar + '()" class="' + b + (p===pagActual?'bg-blue-600 text-white border-blue-600':'text-gray-600 border-gray-300 hover:bg-gray-100') + '">' + p + '</button>');
        div.append('<button ' + (pagActual===totalP?'disabled':'') + ' onclick="' + varPag + '++; ' + fnCargar + '()" class="' + b + (pagActual===totalP?'text-gray-300 border-gray-200':'text-gray-600 border-gray-300 hover:bg-gray-100') + '">›</button>');
    }

    // ── Registrar ───────────────────────────────
    function registrar() {
        var valido = true;
        ['errCliente','errNombreSocio','errRol','errRuta','errMedidor','errCodigoFijo','errActividad','errCategoria','errMetodo','errInicial']
            .forEach(function (id) { $('#'+id).addClass('hidden'); });

        if (!$('#hdnClienteId').val())            { $('#errCliente').removeClass('hidden');    valido = false; }
        if (!$.trim($('#txtNombreSocio').val()))  { $('#errNombreSocio').removeClass('hidden'); valido = false; }
        if (!$('#selRol').val())                  { $('#errRol').removeClass('hidden');        valido = false; }
        if (!$('#selRuta').val())                 { $('#errRuta').removeClass('hidden');       valido = false; }
        if (!$('#hdnMedidorId').val())            { $('#errMedidor').removeClass('hidden');    valido = false; }
        if (!$('#txtCodigoFijo').val())           { $('#errCodigoFijo').removeClass('hidden'); valido = false; }
        if (!$.trim($('#txtActividad').val()))    { $('#errActividad').removeClass('hidden');  valido = false; }
        if (!$('#selCategoria').val())            { $('#errCategoria').removeClass('hidden');  valido = false; }
        if (!$('#selMetodoPago').val())           { $('#errMetodo').removeClass('hidden');     valido = false; }
        var iniPago = parseInt($('#txtMontoInicial').val()) || 0;
        if (iniPago < 500 || (costoInscripcion > 0 && iniPago > costoInscripcion)) { $('#errInicial').removeClass('hidden'); valido = false; }
        if (!valido) return;

        ocultarError(); setLoading(true);

        $.ajax({
            url:  '@Url.Action("Registrar", "Socio")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                nombre_socio:           $.trim($('#txtNombreSocio').val()),
                cliente_id_cliente:     parseInt($('#hdnClienteId').val()),
                rol_socio_id_rol_socio: parseInt($('#selRol').val()),
                medidor_id_medidor:     parseInt($('#hdnMedidorId').val()),
                ruta_id_ruta:           parseInt($('#selRuta').val()),
                codigo_fijo:            parseInt($('#txtCodigoFijo').val()),
                actividad:              $.trim($('#txtActividad').val()),
                categoria:              $('#selCategoria').val(),
                fecha_registro:         $('#txtFechaRegistro').val(),
                ubicacion:              parseInt($('#txtUbicacion').val()) || 0,
                num_casa:               parseInt($('#txtNumCasa').val()) || 0,
                num_ocupantes:          parseInt($('#txtNumOcupantes').val()) || 0,
                tipo_instalacion:       $('#txtTipoInstalacion').val(),
                dim_instalacion:        $('#txtDimInstalacion').val(),
                monto_inicial:          parseInt($('#txtMontoInicial').val()) || 0,
                num_cuotas:             parseInt($('#selNumCuotas').val()),
                id_metodo_pago:         parseInt($('#selMetodoPago').val()) || 0
            }),
            success: function (res) {
                if (res.exito) { window.parent.onAccionCompletada(); }
                else { mostrarError(res.mensaje || 'No se pudo registrar el socio.'); setLoading(false); }
            },
            error: function () { mostrarError('Error de conexión.'); setLoading(false); }
        });
    }

    function parsearFechaNet(val) {
        if (!val) return '-';
        var m = /\/Date\((\d+)\)\//.exec(val);
        if (m) return new Date(parseInt(m[1])).toISOString().substring(0, 10);
        return typeof val === 'string' ? val.substring(0, 10) : '-';
    }
    function mostrarError(msg) { $('#errorText').text(msg); $('#errorMsg').removeClass('hidden'); }
    function ocultarError()    { $('#errorMsg').addClass('hidden'); }
    function setLoading(v)     {
        $('#btnGuardar').prop('disabled', v);
        $('#btnText').text(v ? 'Guardando...' : 'Registrar Socio');
        $('#btnSpinner').toggleClass('hidden', !v);
    }
    </script>
</body>
</html>
