
@{
    ViewBag.Title = "Tarifa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-xl font-semibold text-gray-800">Gestión de Tarifas</h1>
        <p class="text-sm text-gray-400 mt-0.5">Administra las tarifas del sistema</p>
    </div>
</div>


