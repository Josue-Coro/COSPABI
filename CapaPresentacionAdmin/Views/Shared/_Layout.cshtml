@using CapaModelo
@using System.Linq
@functions {
    bool TienePermiso(string nombreAccion)
    {
        var oUsuario = HttpContext.Current.Session["Usuario"] as CM_Usuario_Activo;
        if (oUsuario == null || oUsuario.ListaPermisos == null) return false;
        return oUsuario.ListaPermisos.Any(p => p.accion.ToUpper() == nombreAccion.ToUpper());
    }
}
@{
    CM_Usuario_Activo oUsuario = (CM_Usuario_Activo)Session["Usuario"];

    // Agrupadores de sección
    

    bool tieneOperaciones =
        TienePermiso("Gestionar Ruta") ||
        TienePermiso("Gestionar Avisos") ||
        TienePermiso("Gestionar Cargo Extra") ||
        TienePermiso("Gestionar Lecturas");

    bool tienePortalSocio =
        TienePermiso("Gestionar Cuenta Socio") ||
        TienePermiso("Gestionar Notificaciones") ||
        TienePermiso("Gestionar Metodo Pago");

    bool tieneConfiguracion =
        TienePermiso("Gestionar Tarifa") ||
        TienePermiso("Gestionar Medidor") ||
        TienePermiso("Gestionar TipoCargo");

    bool tieneComercial =
        TienePermiso("Gestionar Cliente") ||
        TienePermiso("Gestionar Socio") ||
        TienePermiso("Gestionar Credito Inscripcion") ||
        TienePermiso("Gestionar Pago");

    bool tieneAdmin =
        TienePermiso("Gestionar Caja") ||
        TienePermiso("Gestionar Usuarios") ||
        TienePermiso("Gestionar Rol") ||
        TienePermiso("Gestionar Permiso") ||
        TienePermiso("Visualizar Bitacora");
    bool tieneReporte =
        TienePermiso("Generar Reporte Caja") ||
        TienePermiso("Generar Reporte Morosidad") ;

    // Iniciales del usuario para el avatar
    var nombreSesion = Session["NombreUsuario"] as string ?? "AD";
    var iniciales = string.Join("", nombreSesion.Split(' ')
                       .Take(2)
                       .Select(p => p.Length > 0 ? p[0].ToString().ToUpper() : ""));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - COSPABI R.L.</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="~/Content/app.css" rel="stylesheet" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 99px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 14px;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 500;
            color: #94a3b8;
            text-decoration: none !important;
            transition: background 0.15s, color 0.15s;
        }

            .nav-link:hover {
                background: #2d3a4e;
                color: #e2e8f0;
            }

            .nav-link.active {
                background: rgba(34,197,94,0.12);
                color: #22c55e;
            }

        .nav-section {
            padding: 0 14px;
            margin: 20px 0 6px;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #475569;
        }

        .profile-dropdown {
            position: absolute;
            right: 0;
            top: calc(100% + 10px);
            width: 200px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.10);
            padding: 6px;
            z-index: 50;
            display: none;
        }

            .profile-dropdown.open {
                display: block;
            }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 13px;
            color: #374151;
            text-decoration: none;
            transition: background 0.15s;
        }

            .dropdown-item:hover {
                background: #f1f5f9;
            }

            .dropdown-item.danger {
                color: #dc2626;
            }

                .dropdown-item.danger:hover {
                    background: #fef2f2;
                }

        .top-accent {
            background: linear-gradient(90deg, #22c55e 0%, #15803d 100%);
        }

        #sidebarOverlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 30;
        }

            #sidebarOverlay.open {
                display: block;
            }

        main {
            animation: fadeIn 0.25s ease both;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body class="bg-slate-100 text-gray-800 antialiased">

    <div id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- SIDEBAR -->
        <aside id="sidebar"
               class="w-64 bg-sidebar flex-shrink-0 flex flex-col
                      fixed md:relative inset-y-0 left-0 z-40
                      transform -translate-x-full md:translate-x-0
                      transition-transform duration-300">

            <!-- Logo -->
            <div class="h-[68px] flex items-center gap-3 px-5 border-b border-sidebar-border flex-shrink-0">
                <div class="w-8 h-8 rounded-lg bg-primary-500 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C8.5 7 5 10.5 5 14a7 7 0 0014 0c0-3.5-3.5-7-7-12z" />
                    </svg>
                </div>
                <div class="leading-none">
                    <span class="block text-white font-bold text-base tracking-tight">COSPABI R.L.</span>
                    <span class="block text-slate-500 text-[11px] font-medium mt-0.5">Panel Administrativo</span>
                </div>
            </div>

            <!-- Navegación -->
            <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-0.5">

                <p class="nav-section">Principal</p>
                @Html.ActionLink("Inicio", "Index", "Home",
                    new { area = "" },
                    new { @class = "nav-link" })
                @if (tieneAdmin)
                {
                    <p class="nav-section">Administración</p>

                    if (TienePermiso("Gestionar Usuarios"))
                    {
                        @Html.ActionLink("Usuarios", "Usuario", "Usuario",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }

                    if (TienePermiso("Gestionar Rol"))
                    {
                        @Html.ActionLink("Roles", "Rol", "Rol",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Permiso"))
                    {
                        @Html.ActionLink("Permisos", "Permiso", "Permiso",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Caja"))
                    {
                        @Html.ActionLink("Cajas", "Caja", "Caja",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Visualizar Bitacora"))
                    {
                        @Html.ActionLink("Bitacora", "Bitacora", "Bitacora",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }

                }
                @if (tieneConfiguracion)
                {
                    <p class="nav-section">Configuración</p>


                    if (TienePermiso("Gestionar Tarifa"))
                    {
                        @Html.ActionLink("Tarifas", "Tarifa", "Tarifa",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar TipoCargo"))
                    {
                        @Html.ActionLink("Tipos de Cargo", "TipoCargo", "TipoCargo",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Medidor"))
                    {
                        @Html.ActionLink("Medidores", "Medidor", "Medidor",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }

                }
                @if (tieneComercial)
                {
                    <p class="nav-section">Atencion al Cliente</p>

                    if (TienePermiso("Gestionar Cliente"))
                    {
                        @Html.ActionLink("Clientes", "Cliente", "Cliente",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Socio"))
                    {
                        @Html.ActionLink("Socios", "Socio", "Socio",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Credito Inscripcion"))
                    {
                        @Html.ActionLink("Crédito de Inscripcion", "Credito", "Credito",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Pago"))
                    {
                        @Html.ActionLink("Pagos", "Pago", "Pago",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }

                }
                @if (tieneOperaciones)
                {
                    <p class="nav-section">Operaciones</p>
                    if (TienePermiso("Gestionar Lecturas"))
                    {
                        @Html.ActionLink("Lecturas", "Lectura", "Lectura",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Avisos"))
                    {
                        @Html.ActionLink("Avisos y Cobros", "Aviso", "Aviso",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Cargo Extra"))
                    {
                        @Html.ActionLink("Cargos Extras", "CargoExtra", "CargoExtra",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Ruta"))
                    {
                        @Html.ActionLink("Rutas", "Ruta", "Ruta",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }


                }

                @if (tienePortalSocio)
                {
                    <p class="nav-section">Portal de Socios</p>
                    if (TienePermiso("Gestionar Cuenta Socio"))
                    {
                        @Html.ActionLink("Cuentas de Socio", "CuentaSocio", "CuentaSocio",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Notificaciones"))
                    {
                        @Html.ActionLink("Notificaciones", "Notificacion", "Notificacion",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Gestionar Metodo Pago"))
                    {
                        @Html.ActionLink("Metodo de pago", "MetodoPago", "MetodoPago",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }

                }




                @if (tieneReporte)
                {
                    <p class="nav-section">Reporte</p>
                    if (TienePermiso("Generar Reporte Caja"))
                    {
                        @Html.ActionLink("Reporte de Caja", "Caja", "Reporte",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }
                    if (TienePermiso("Generar Reporte Morosidad"))
                    {
                        @Html.ActionLink("Reporte de Morosidad", "Morosidad", "Reporte",
                            new { area = "" },
                            new { @class = "nav-link" })
                    }

                }

            </nav>

            <!-- Perfil base del sidebar -->
            <div class="flex-shrink-0 border-t border-sidebar-border px-4 py-4">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                        @iniciales
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-white text-xs font-semibold truncate">@(Session["NombreUsuario"] ?? "Administrador")</p>
                        <p class="text-slate-500 text-[11px] truncate">@(Session["RolUsuario"] ?? "")</p>
                    </div>
                </div>
            </div>

        </aside>

        <!-- ÁREA DE CONTENIDO -->
        <div class="flex-1 flex flex-col overflow-hidden min-w-0">

            <div class="top-accent h-[3px] flex-shrink-0"></div>

            <!-- HEADER -->
            <header class="h-[65px] bg-white border-b border-gray-200 flex items-center justify-between px-5 flex-shrink-0 shadow-sm">

                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()"
                            class="md:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition"
                            aria-label="Abrir menú">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <div class="hidden sm:flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-2 w-56 hover:bg-gray-200 transition cursor-text">
                        <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text"
                               placeholder="Buscar..."
                               class="bg-transparent text-sm text-gray-600 outline-none w-full placeholder-gray-400">
                    </div>
                </div>

                <div class="flex items-center gap-2">

                    <button class="relative p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition"
                            aria-label="Notificaciones">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-primary-500 rounded-full ring-2 ring-white"></span>
                    </button>

                    <div class="w-px h-6 bg-gray-200 mx-1"></div>

                    <div class="relative" id="profileWrapper">
                        <button onclick="toggleDropdown()"
                                class="flex items-center gap-2.5 pl-2 pr-3 py-1.5 rounded-xl hover:bg-gray-100 transition"
                                aria-haspopup="true"
                                aria-expanded="false"
                                id="profileBtn">
                            <div class="w-8 h-8 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 text-xs font-bold">
                                @iniciales
                            </div>
                            <div class="hidden sm:block text-left leading-none">
                                <p class="text-sm font-semibold text-gray-800">@(Session["NombreUsuario"] ?? "Administrador")</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">@(Session["RolUsuario"] ?? "")</p>
                            </div>
                            <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>

                        <div class="profile-dropdown" id="profileDropdown" role="menu">
                            <a href="#" class="dropdown-item">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                Mi perfil
                            </a>
                            <div class="my-1 border-t border-gray-100"></div>
                            <a href="@Url.Action("CerrarSesion", "Login")" class="dropdown-item danger">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                                Cerrar sesión
                            </a>
                        </div>
                    </div>

                </div>
            </header>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-slate-100 p-5 sm:p-8">
                <div class="mx-auto max-w-screen-2xl">
                    @RenderBody()
                </div>
            </main>

        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")

    <script>
        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("-translate-x-full");
            document.getElementById("sidebarOverlay").classList.toggle("open");
        }

        function toggleDropdown() {
            var dd = document.getElementById("profileDropdown");
            var btn = document.getElementById("profileBtn");
            var isOpen = dd.classList.toggle("open");
            btn.setAttribute("aria-expanded", isOpen.toString());
        }

        document.addEventListener("click", function (e) {
            var wrapper = document.getElementById("profileWrapper");
            if (wrapper && !wrapper.contains(e.target)) {
                document.getElementById("profileDropdown").classList.remove("open");
                document.getElementById("profileBtn").setAttribute("aria-expanded", "false");
            }
        });

        (function () {
            var path = window.location.pathname.toLowerCase();
            var links = document.querySelectorAll(".nav-link");
            links.forEach(function (link) {
                if (link.getAttribute("href") &&
                    path.indexOf(link.getAttribute("href").toLowerCase()) !== -1) {
                    link.classList.add("active");
                }
            });
        })();
    </script>

    @RenderSection("scripts", required: false)

</body>
</html>

