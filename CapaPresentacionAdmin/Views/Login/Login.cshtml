@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión — COSPABI</title>
    <link href="~/Content/app.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Animación de entrada para la tarjeta */
        .card-enter {
            animation: cardEnter 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @@keyframes cardEnter {
            from {
                opacity: 0;
                transform: translateY(18px) scale(0.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Efecto focus mejorado en inputs */
        .input-field {
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .input-field:focus {
                border-color: #22c55e;
                box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
                outline: none;
            }

        /* Botón con estado de carga */
        .btn-primary {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        }

            .btn-primary:hover:not(:disabled) {
                opacity: 0.92;
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(34,197,94,0.30);
            }

            .btn-primary:active:not(:disabled) {
                transform: translateY(0);
            }

            .btn-primary:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }

        /* Patrón decorativo del fondo */
        .bg-pattern {
            background-color: #1c2434;
            background-image: radial-gradient(circle at 20% 20%, rgba(34,197,94,0.08) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(34,197,94,0.05) 0%, transparent 50%);
        }
    </style>
</head>
<body class="bg-pattern min-h-screen flex items-center justify-center px-4">

    <div class="w-full max-w-md card-enter">

        <!-- Logo / Encabezado -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary-500 mb-4 shadow-lg">
                <!-- Ícono de gota de agua (agua potable) -->
                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C8.5 7 5 10.5 5 14a7 7 0 0014 0c0-3.5-3.5-7-7-12z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">COSPABI</h1>
            <p class="text-sm text-gray-400 mt-1">Sistema de Gestión Administrativa</p>
        </div>

        <!-- Tarjeta principal -->
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">

            <!-- Franja superior de color -->
            <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700"></div>

            <div class="p-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-1">Bienvenido de vuelta</h2>
                <p class="text-sm text-gray-400 mb-7">Ingresa tus credenciales para continuar</p>

                <form id="loginForm" novalidate>

                    <!-- Campo: Usuario -->
                    <div class="mb-5">
                        <label for="usuario" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Usuario
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                                <svg class="w-4.5 h-4.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </span>
                            <input type="text"
                                   id="usuario"
                                   name="usuario"
                                   autocomplete="username"
                                   placeholder="Tu usuario"
                                   required
                                   autofocus
                                   class="input-field w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-xl text-sm text-gray-800 placeholder-gray-400 bg-gray-50">
                        </div>
                    </div>

                    <!-- Campo: Contraseña -->
                    <div class="mb-6">
                        <label for="contrasena" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Contraseña
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                                <svg class="w-4.5 h-4.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </span>
                            <input type="password"
                                   id="contrasena"
                                   name="contrasena"
                                   autocomplete="current-password"
                                   placeholder="••••••••"
                                   required
                                   class="input-field w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-xl text-sm text-gray-800 placeholder-gray-400 bg-gray-50">
                            <!-- Botón mostrar/ocultar contraseña -->
                            <button type="button"
                                    id="togglePassword"
                                    class="absolute inset-y-0 right-3 flex items-center text-gray-400 hover:text-gray-600 transition-colors"
                                    aria-label="Mostrar u ocultar contraseña">
                                <svg id="iconMostrar" style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <svg id="iconOcultar" style="width:18px;height:18px;display:none;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Alerta de error -->
                    <div id="errorMsg"
                         class="hidden mb-5 flex items-start gap-2.5 text-red-700 text-sm bg-red-50 border border-red-200 px-4 py-3 rounded-xl"
                         role="alert"
                         aria-live="assertive">
                        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                  clip-rule="evenodd" />
                        </svg>
                        <span id="errorText"></span>
                    </div>

                    <!-- Botón submit -->
                    <button type="submit"
                            id="btnSubmit"
                            class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2">
                        <span id="btnText">Iniciar Sesión</span>
                        <!-- Spinner (oculto por defecto) -->
                        <svg id="btnSpinner"
                             class="hidden w-4 h-4 animate-spin"
                             fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10"
                                    stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor"
                                  d="M4 12a8 8 0 018-8v8H4z" />
                        </svg>
                    </button>

                </form>
            </div>
        </div>

        <!-- Footer -->
        <p class="text-center text-xs text-gray-500 mt-6">
            &copy; @DateTime.Now.Year COSPABI &mdash; Todos los derechos reservados
        </p>

    </div>

    <script>
        $(function () {

            // ── Mostrar / ocultar contraseña ──────────────────────────────────
            $("#togglePassword").on("click", function () {
                var $input = $("#contrasena");
                var tipo = $input.attr("type") === "password" ? "text" : "password";
                $input.attr("type", tipo);

                if (tipo === "text") {
                    $("#iconMostrar").hide();
                    $("#iconOcultar").show();
                } else {
                    $("#iconMostrar").show();
                    $("#iconOcultar").hide();
                }
            });

            // ── Helpers UI ────────────────────────────────────────────────────
            function mostrarError(msg) {
                $("#errorText").text(msg);
                $("#errorMsg").removeClass("hidden");
            }

            function ocultarError() {
                $("#errorMsg").addClass("hidden");
                $("#errorText").text("");
            }

            function setLoading(loading) {
                $("#btnSubmit").prop("disabled", loading);
                $("#btnText").text(loading ? "Validando..." : "Iniciar Sesión");
                $("#btnSpinner").toggleClass("hidden", !loading);
            }

            // ── Submit del formulario ─────────────────────────────────────────
            $("#loginForm").on("submit", function (e) {
                e.preventDefault();
                ocultarError();

                var usuario   = $.trim($("#usuario").val());
                var contrasena = $("#contrasena").val();

                // Validación mínima en cliente
                if (!usuario || !contrasena) {
                    mostrarError("Por favor completa todos los campos.");
                    return;
                }

                setLoading(true);

                $.ajax({
                    url:  '@Url.Action("ValidarLogin", "Login")',
                    type: "POST",
                    data: { usuario: usuario, contrasena: contrasena },
                    success: function (response) {
                        if (response.resultado === true) {
                            // Redirigir al dashboard
                            window.location.href = '@Url.Action("Index", "Home")';
                        } else {
                            mostrarError(response.mensaje || "Credenciales incorrectas.");
                            setLoading(false);
                        }
                    },
                    error: function () {
                        mostrarError("Error de conexión. Intenta nuevamente.");
                        setLoading(false);
                    }
                });
            });

        });
    </script>

</body>
</html>
