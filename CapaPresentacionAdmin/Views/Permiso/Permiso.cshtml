@{
    ViewBag.Title = "Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-6">
    <h1 class="text-xl font-semibold text-gray-800">Gestión de Permisos</h1>
    <p class="text-sm text-gray-400 mt-0.5">Asigna o revoca permisos por rol</p>
</div>

<!-- Tabla de Roles -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <span class="text-sm font-semibold text-gray-700">Roles del sistema</span>
        <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-1.5 w-52">
            <svg style="width:15px;height:15px;" class="text-gray-400 flex-shrink-0"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="buscador" placeholder="Buscar rol..."
                   class="bg-transparent text-sm text-gray-600 outline-none w-full placeholder-gray-400">
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">#</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Rol</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Descripción</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Estado</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Permisos</th>
                </tr>
            </thead>
            <tbody id="bodyRoles" class="divide-y divide-gray-100">
                <tr>
                    <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-400">
                        <svg class="animate-spin mx-auto mb-2" style="width:22px;height:22px;"
                             fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10"
                                    stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor"
                                  d="M4 12a8 8 0 018-8v8H4z" />
                        </svg>
                        Cargando roles...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="px-6 py-3 border-t border-gray-100">
        <span class="text-xs text-gray-400" id="contadorRoles"></span>
    </div>
</div>

<!-- Modal de Permisos del Rol -->
<div id="modalPermisos" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col"
         style="max-height:90vh;">

        <div class="h-1.5 bg-gradient-to-r from-primary-500 to-primary-700 flex-shrink-0"></div>

        <!-- Header del modal -->
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
            <div>
                <h3 class="text-base font-semibold text-gray-800">Permisos del Rol</h3>
                <p class="text-xs text-gray-400 mt-0.5" id="subtituloModal"></p>
            </div>
            <button onclick="cerrarModal()"
                    class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 transition">
                <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Buscador de permisos dentro del modal -->
        <div class="px-6 py-3 border-b border-gray-100 flex-shrink-0">
            <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-2">
                <svg style="width:14px;height:14px;" class="text-gray-400 flex-shrink-0"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" id="buscadorPermiso" placeholder="Filtrar permisos..."
                       class="bg-transparent text-sm text-gray-600 outline-none w-full placeholder-gray-400">
            </div>
        </div>

        <!-- Acciones rápidas: marcar / desmarcar todos -->
        <div class="px-6 py-2 border-b border-gray-100 flex items-center gap-3 flex-shrink-0">
            <span class="text-xs text-gray-400">Selección rápida:</span>
            <button onclick="marcarTodos(true)"
                    class="text-xs text-primary-600 font-medium hover:underline">
                Marcar todos
            </button>
            <span class="text-gray-300 text-xs">|</span>
            <button onclick="marcarTodos(false)"
                    class="text-xs text-gray-500 font-medium hover:underline">
                Desmarcar todos
            </button>
            <span class="ml-auto text-xs text-gray-400" id="contadorMarcados"></span>
        </div>

        <!-- Lista de permisos con checkboxes -->
        <div class="overflow-y-auto flex-1 px-6 py-4" id="listaPermisos">
            <div class="flex items-center justify-center py-8 text-sm text-gray-400">
                <svg class="animate-spin mr-2" style="width:18px;height:18px;"
                     fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10"
                            stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                </svg>
                Cargando permisos...
            </div>
        </div>

        <!-- Alerta de error -->
        <div id="errorMsg"
             class="hidden mx-6 mb-2 flex items-start gap-2 text-red-700 text-sm
                    bg-red-50 border border-red-200 px-3 py-2.5 rounded-xl flex-shrink-0">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd"
                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                      clip-rule="evenodd" />
            </svg>
            <span id="errorText"></span>
        </div>

        <!-- Footer con botón guardar -->
        <div class="px-6 py-4 border-t border-gray-100 flex-shrink-0">
            <button id="btnGuardar" onclick="guardarPermisos()"
                    class="btn-primary w-full py-2.5 rounded-xl text-sm font-semibold
                           text-white flex items-center justify-center gap-2">
                <svg style="width:15px;height:15px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M5 13l4 4L19 7" />
                </svg>
                <span id="btnText">Guardar Permisos</span>
                <svg id="btnSpinner" class="hidden animate-spin" style="width:16px;height:16px;"
                     fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10"
                            stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Toast de éxito -->
<div id="toast"
     class="fixed bottom-6 right-6 z-[60] hidden items-center gap-3
            bg-gray-900 text-white text-sm font-medium px-4 py-3 rounded-xl shadow-xl">
    <svg style="width:16px;height:16px;" class="text-green-400 flex-shrink-0"
         fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="toastText"></span>
</div>

<style>
    .btn-primary {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    }

        .btn-primary:hover:not(:disabled) {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(34,197,94,0.30);
        }

        .btn-primary:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    .checkbox-permiso:checked {
        accent-color: #22c55e;
    }
</style>

@section scripts {
    <script>
    var rolActual = { id: 0, nombre: '' };

    // -- Cargar tabla de roles -----------------------------------------------
    function cargarRoles() {
        $.ajax({
            url: '@Url.Action("ListarRoles", "Permiso")',
            type: 'GET',
            success: function (res) {
                var filas = '';
                if (!res.data || res.data.length === 0) {
                    filas = '<tr><td colspan="5" class="px-6 py-10 text-center text-sm text-gray-400">No hay roles registrados.</td></tr>';
                } else {
                    $.each(res.data, function (i, r) {
                        var badge = r.estado
                            ? '<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Activo</span>'
                            : '<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Inactivo</span>';

                        filas += '<tr class="hover:bg-gray-50 transition fila-rol">' +
                            '<td class="px-6 py-3.5 text-gray-400 text-xs">' + (i+1) + '</td>' +
                            '<td class="px-6 py-3.5 font-medium text-gray-800">' + r.nombre + '</td>' +
                            '<td class="px-6 py-3.5 text-gray-500">' + (r.descripcion || '') + '</td>' +
                            '<td class="px-6 py-3.5">' + badge + '</td>' +
                            '<td class="px-6 py-3.5 text-center">' +
                            '  <button onclick="abrirModal(' + r.id_rol + ', \'' + r.nombre.replace(/'/g,"\\'") + '\')" ' +
                            '          title="Gestionar permisos" ' +
                            '          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium ' +
                            '                 text-primary-600 bg-primary-50 hover:bg-primary-100 transition">' +
                            '    <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
                            '      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
                            '            d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>' +
                            '    </svg>' +
                            '    Permisos' +
                            '  </button>' +
                            '</td></tr>';
                    });
                    $('#contadorRoles').text(res.data.length + ' rol(es)');
                }
                $('#bodyRoles').html(filas);
            },
            error: function () {
                $('#bodyRoles').html('<tr><td colspan="5" class="px-6 py-10 text-center text-sm text-red-500">Error al cargar los roles.</td></tr>');
            }
        });
    }

    // -- Buscador de roles ---------------------------------------------------
    $('#buscador').on('input', function () {
        var t = $(this).val().toLowerCase();
        $('.fila-rol').each(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(t) !== -1);
        });
    });

    // -- Abrir modal y cargar permisos del rol -------------------------------
    function abrirModal(idRol, nombreRol) {
        rolActual = { id: idRol, nombre: nombreRol };
        $('#subtituloModal').text(nombreRol);
        $('#buscadorPermiso').val('');
        ocultarError();
        setLoading(false);
        $('#listaPermisos').html(
            '<div class="flex items-center justify-center py-8 text-sm text-gray-400">' +
            '  <svg class="animate-spin mr-2" style="width:18px;height:18px;" fill="none" viewBox="0 0 24 24">' +
            '    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>' +
            '    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>' +
            '  </svg>Cargando permisos...</div>'
        );
        $('#modalPermisos').removeClass('hidden').addClass('flex');

        $.ajax({
            url: '@Url.Action("ListarPermisosRol", "Permiso")',
            type: 'GET',
            data: { id_rol: idRol },
            success: function (res) {
                renderizarPermisos(res.data);
            },
            error: function () {
                $('#listaPermisos').html(
                    '<p class="text-sm text-red-500 text-center py-6">Error al cargar los permisos.</p>'
                );
            }
        });
    }

    function cerrarModal() {
        $('#modalPermisos').removeClass('flex').addClass('hidden');
        rolActual = { id: 0, nombre: '' };
    }

    // -- Renderizar checkboxes agrupados por módulo ---------------------------
    function renderizarPermisos(permisos) {
        if (!permisos || permisos.length === 0) {
            $('#listaPermisos').html(
                '<p class="text-sm text-gray-400 text-center py-6">No hay permisos registrados en el sistema.</p>'
            );
            return;
        }

        // Agrupar por módulo (vienen ya ordenados por módulo desde el SP)
        var grupos = [];   // [{ nombre, permisos: [] }]
        $.each(permisos, function (i, p) {
            var mod = p.modulo || 'Otros';
            var ultimo = grupos[grupos.length - 1];
            if (!ultimo || ultimo.nombre !== mod) {
                grupos.push({ nombre: mod, permisos: [] });
                ultimo = grupos[grupos.length - 1];
            }
            ultimo.permisos.push(p);
        });

        var html = '<div id="contenedorPermisos">';
        $.each(grupos, function (g, grupo) {
            html +=
                '<div class="grupo-modulo' + (g > 0 ? ' mt-5' : '') + '">' +
                '  <div class="flex items-center gap-2 mb-2">' +
                '    <span class="text-xs font-bold text-primary-700 uppercase tracking-wider">' + grupo.nombre + '</span>' +
                '    <div class="flex-1 h-px bg-gray-200"></div>' +
                '    <span class="text-xs text-gray-400 contador-modulo"></span>' +
                '  </div>' +
                '  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">';

            $.each(grupo.permisos, function (i, p) {
                var checked = p.asignado ? 'checked' : '';
                var filtro  = (p.accion + ' ' + (p.descripcion || '') + ' ' + grupo.nombre).toLowerCase();
                html +=
                    '<label class="item-permiso flex items-start gap-3 p-3 rounded-xl border border-gray-100 ' +
                    '              hover:bg-gray-50 cursor-pointer transition group" ' +
                    '       data-nombre="' + filtro + '">' +
                    '  <input type="checkbox" class="checkbox-permiso mt-0.5 w-4 h-4 rounded cursor-pointer flex-shrink-0" ' +
                    '         value="' + p.id_permiso + '" ' + checked + '>' +
                    '  <div class="min-w-0">' +
                    '    <p class="text-sm font-medium text-gray-800 leading-snug">' + p.accion + '</p>' +
                    (p.descripcion
                        ? '<p class="text-xs text-gray-400 mt-0.5">' + p.descripcion + '</p>'
                        : '') +
                    '  </div>' +
                    '</label>';
            });

            html += '  </div></div>';
        });
        html += '</div>';

        $('#listaPermisos').html(html);
        actualizarContador();

        // Actualizar contador al cambiar checkboxes
        $(document).on('change', '.checkbox-permiso', actualizarContador);
    }

    // -- Buscador dentro del modal -------------------------------------------
    $('#buscadorPermiso').on('input', function () {
        var t = $(this).val().toLowerCase();
        $('.item-permiso').each(function () {
            $(this).toggle($(this).data('nombre').indexOf(t) !== -1);
        });
        // Ocultar los módulos que quedaron sin resultados
        $('.grupo-modulo').each(function () {
            $(this).toggle($(this).find('.item-permiso:visible').length > 0);
        });
    });

    // -- Marcar / desmarcar todos --------------------------------------------
    function marcarTodos(valor) {
        $('.item-permiso:visible .checkbox-permiso').prop('checked', valor);
        actualizarContador();
    }

    function actualizarContador() {
        var total    = $('.checkbox-permiso').length;
        var marcados = $('.checkbox-permiso:checked').length;
        $('#contadorMarcados').text(marcados + ' / ' + total + ' seleccionados');

        // Contador por módulo
        $('.grupo-modulo').each(function () {
            var t = $(this).find('.checkbox-permiso').length;
            var m = $(this).find('.checkbox-permiso:checked').length;
            $(this).find('.contador-modulo').text(m + ' / ' + t);
        });
    }

    // -- Guardar permisos ----------------------------------------------------
    function guardarPermisos() {
        var ids = [];
        $('.checkbox-permiso:checked').each(function () {
            ids.push(parseInt($(this).val()));
        });

        ocultarError();
        setLoading(true);

        $.ajax({
            url: '@Url.Action("GuardarPermisosRol", "Permiso")',
            type: 'POST',
            // Serializar array correctamente para MVC
            data: $.param({ id_rol: rolActual.id }) +
                  (ids.length > 0 ? '&' + $.param({ permisos: ids }, true) : ''),
            success: function (res) {
                // El controller devuelve "resultado" como entero (> 0 = éxito), no booleano.
                if (res.resultado > 0) {
                    // Capturar el nombre ANTES de cerrar: cerrarModal() resetea rolActual.
                    var nombreRol = rolActual.nombre;
                    setLoading(false);
                    cerrarModal();
                    mostrarToast('Permisos de "' + nombreRol + '" actualizados.');
                } else {
                    mostrarError(res.mensaje || 'No se pudieron guardar los permisos.');
                    setLoading(false);
                }
            },
            error: function () {
                mostrarError('Error de conexión. Intenta nuevamente.');
                setLoading(false);
            }
        });
    }

    // -- Helpers -------------------------------------------------------------
    function mostrarError(msg) { $('#errorText').text(msg); $('#errorMsg').removeClass('hidden'); }
    function ocultarError()    { $('#errorMsg').addClass('hidden'); }
    function setLoading(v)     {
        $('#btnGuardar').prop('disabled', v);
        $('#btnText').text(v ? 'Guardando...' : 'Guardar Permisos');
        $('#btnSpinner').toggleClass('hidden', !v);
    }

    function mostrarToast(msg) {
        $('#toastText').text(msg);
        $('#toast').removeClass('hidden').addClass('flex');
        setTimeout(function () {
            $('#toast').removeClass('flex').addClass('hidden');
        }, 3000);
    }

    $(function () { cargarRoles(); });
    </script>
}

