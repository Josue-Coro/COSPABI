@{
    var rutaActual = (ViewContext.RouteData.Values["controller"] + "/" + ViewContext.RouteData.Values["action"]).ToLower();
    Func<string, bool> esActivo = r => rutaActual == r.ToLower();

    var nombreSocio = Session["NombreSocio"] as string;
    var iniciales = "S";
    if (!string.IsNullOrWhiteSpace(nombreSocio))
    {
        var partes = nombreSocio.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        iniciales = partes[0].Substring(0, 1).ToUpper() + (partes.Length > 1 ? partes[1].Substring(0, 1).ToUpper() : "");
    }

    // Un solo origen para los cinco destinos: la barra lateral de escritorio y
    // la barra inferior movil se pintan desde aqui, asi no se desincronizan.
    var destinos = new[]
    {
        new { Ruta = "Home/Index",            Url = Url.Action("Index", "Home"),            Icono = "home",     Titulo = "Inicio",         Corto = "Inicio" },
        new { Ruta = "Portal/Avisos",         Url = Url.Action("Avisos", "Portal"),         Icono = "receipt",  Titulo = "Mis Avisos",     Corto = "Avisos" },
        new { Ruta = "Portal/Pagos",          Url = Url.Action("Pagos", "Portal"),          Icono = "card",     Titulo = "Mis Pagos",      Corto = "Pagos" },
        new { Ruta = "Portal/Notificaciones", Url = Url.Action("Notificaciones", "Portal"), Icono = "bell",     Titulo = "Notificaciones", Corto = "Notif." },
        new { Ruta = "Perfil/Index",          Url = Url.Action("Index", "Perfil"),          Icono = "user",     Titulo = "Mi Perfil",      Corto = "Perfil" }
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Portal del Socio COSPABI</title>
    <link rel="icon" href="~/favicon.ico" />
    <link href="~/Content/app.css?v=@Recursos.AppCss()" rel="stylesheet" />
</head>
<body class="bg-slate-100 text-on-background font-sans antialiased min-h-screen">

    @* ------------------------------------------------------------------
       Sprite de iconos. Sustituye a Material Symbols: son ~25 iconos y la
       CSP solo permite font-src 'self', asi que traer una fuente de iconos
       entera no compensa. Se usan con <svg class="ic"><use href="#ic-x">.
       ------------------------------------------------------------------ *@
    <svg width="0" height="0" class="hidden" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="ic-drop" viewBox="0 0 24 24"><path d="M12 2.7 7.05 7.65a7 7 0 1 0 9.9 0z" /></symbol>
            <symbol id="ic-home" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></symbol>
            <symbol id="ic-receipt" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M9 13h6" /><path d="M9 17h6" /></symbol>
            <symbol id="ic-card" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /></symbol>
            <symbol id="ic-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></symbol>
            <symbol id="ic-user" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></symbol>
            <symbol id="ic-logout" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></symbol>
            <symbol id="ic-wallet" viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" /><path d="M3 5v14a2 2 0 0 0 2 2h16v-5" /><path d="M18 12a2 2 0 0 0 0 4h4v-4z" /></symbol>
            <symbol id="ic-chart" viewBox="0 0 24 24"><path d="M6 20v-5" /><path d="M12 20V8" /><path d="M18 20v-9" /><path d="M3 20h18" /></symbol>
            <symbol id="ic-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></symbol>
            <symbol id="ic-check-circle" viewBox="0 0 24 24"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1" /><path d="m9 11 3 3L22 4" /></symbol>
            <symbol id="ic-warning" viewBox="0 0 24 24"><path d="m10.3 3.9-8.2 14a2 2 0 0 0 1.7 3h16.4a2 2 0 0 0 1.7-3l-8.2-14a2 2 0 0 0-3.4 0z" /><path d="M12 9v4" /><path d="M12 17h.01" /></symbol>
            <symbol id="ic-error" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="m15 9-6 6" /><path d="m9 9 6 6" /></symbol>
            <symbol id="ic-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></symbol>
            <symbol id="ic-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></symbol>
            <symbol id="ic-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18" /><path d="M8 3v4" /><path d="M16 3v4" /></symbol>
            <symbol id="ic-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></symbol>
            <symbol id="ic-close" viewBox="0 0 24 24"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></symbol>
            <symbol id="ic-refresh" viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15 6.7L3 16" /><path d="M3 21v-5h5" /></symbol>
            <symbol id="ic-arrow-right" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></symbol>
            <symbol id="ic-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></symbol>
            <symbol id="ic-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></symbol>
            <symbol id="ic-qr" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><path d="M14 14h3v3h-3z" /><path d="M21 14v3" /><path d="M18 21h3" /><path d="M14 21h1" /></symbol>
            <symbol id="ic-megaphone" viewBox="0 0 24 24"><path d="m3 11 18-5v12L3 14z" /><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" /></symbol>
            <symbol id="ic-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2" /><path d="M12 2.5 13.4 5a1 1 0 0 0 1.1.5l2.8-.6.9 2.7-2.2 1.8a1 1 0 0 0-.3 1.1l1 2.7-2.3 1.7-2.1-1.9a1 1 0 0 0-1.2 0l-2.1 1.9L6.7 13l1-2.7a1 1 0 0 0-.3-1.1L5.2 7.4l.9-2.7 2.8.6A1 1 0 0 0 10 4.8z" /></symbol>
            <symbol id="ic-badge" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" /><circle cx="8.5" cy="11.5" r="2.5" /><path d="M14 10h5" /><path d="M14 14h3" /></symbol>
            <symbol id="ic-pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></symbol>
            <symbol id="ic-route" viewBox="0 0 24 24"><circle cx="6" cy="19" r="3" /><circle cx="18" cy="5" r="3" /><path d="M9 19h6a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6" /></symbol>
            <symbol id="ic-gauge" viewBox="0 0 24 24"><path d="M12 14 8.5 9.5" /><path d="M3.3 17a9 9 0 1 1 17.4 0z" /></symbol>
            <symbol id="ic-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></symbol>
            <symbol id="ic-eye-off" viewBox="0 0 24 24"><path d="M9.9 5.2A9.8 9.8 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3 3.9" /><path d="M6.2 6.2A17 17 0 0 0 2 12s3.6 7 10 7a9.8 9.8 0 0 0 4.2-.9" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /><path d="m2 2 20 20" /></symbol>
            <symbol id="ic-lock" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></symbol>
            <symbol id="ic-mail" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 7 10 6 10-6" /></symbol>
            <symbol id="ic-phone" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></symbol>
            <symbol id="ic-menu" viewBox="0 0 24 24"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></symbol>
            <symbol id="ic-shield" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></symbol>
            <symbol id="ic-users" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.9" /><path d="M16 3.1a4 4 0 0 1 0 7.8" /></symbol>
            <symbol id="ic-support" viewBox="0 0 24 24"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z" /><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" /></symbol>
        </defs>
    </svg>

    @* ---------------- Barra superior (solo movil) ---------------- *@
    <header class="md:hidden fixed top-0 inset-x-0 z-50 h-16 bg-surface shadow-sm flex items-center justify-between px-4">
        <a href="@Url.Action("Index", "Home")" class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-full gradient-primary flex items-center justify-center text-on-primary">
                <svg class="ic w-5 h-5" style="fill:currentColor;stroke:none"><use href="#ic-drop"></use></svg>
            </span>
            <span class="font-headline-md text-headline-md-mobile text-primary">COSPABI</span>
        </a>
        <a href="@Url.Action("Notificaciones", "Portal")"
           class="relative w-10 h-10 flex items-center justify-center rounded-full text-primary hover:bg-surface-container-high transition-colors"
           aria-label="Notificaciones">
            <svg class="ic"><use href="#ic-bell"></use></svg>
            <span class="badge-notif hidden absolute top-1.5 right-1.5 min-w-[18px] h-[18px] px-1 rounded-full bg-error-red text-white font-caption text-caption font-bold leading-[18px] text-center border-2 border-surface"></span>
        </a>
    </header>

    @* ---------------- Barra lateral (solo escritorio) ---------------- *@
    <aside class="hidden md:flex flex-col fixed left-0 top-0 w-[280px] h-screen bg-surface border-r border-outline-variant/40 py-6 px-4 z-40">
        <a href="@Url.Action("Index", "Home")" class="flex items-center gap-3 px-2 mb-8">
            <span class="w-10 h-10 rounded-full gradient-primary flex items-center justify-center text-on-primary shrink-0">
                <svg class="ic w-6 h-6" style="fill:currentColor;stroke:none"><use href="#ic-drop"></use></svg>
            </span>
            <span class="leading-tight">
                <span class="block font-headline-md text-headline-md-mobile text-primary">COSPABI R.L.</span>
                <span class="block font-caption text-caption text-on-surface-variant">Portal del Socio</span>
            </span>
        </a>

        <nav class="flex flex-col gap-1.5 flex-1">
            @foreach (var d in destinos)
            {
                var claseLateral = "flex items-center gap-3 px-4 py-3 rounded-xl font-label-sm text-label-sm transition-colors "
                    + (esActivo(d.Ruta)
                        ? "bg-primary-container text-on-primary-container font-semibold shadow-[0_2px_8px_-2px_rgba(34,197,94,0.4)]"
                        : "text-on-surface-variant hover:bg-surface-container-high");
                <a href="@d.Url" class="@claseLateral">
                    <svg class="ic w-5 h-5"><use href="#ic-@d.Icono"></use></svg>
                    <span class="flex-1">@d.Titulo</span>
                    @if (d.Icono == "bell")
                    {
                        <span class="badge-notif hidden min-w-[20px] h-5 px-1.5 rounded-full bg-error-red text-white font-caption text-caption font-bold leading-5 text-center"></span>
                    }
                </a>
            }
        </nav>

        @if (nombreSocio != null)
        {
            <div class="mt-auto pt-4 border-t border-outline-variant/40">
                <div class="flex items-center gap-3 px-2 py-2 mb-1">
                    <span class="w-9 h-9 rounded-full bg-primary-100 text-primary-700 flex items-center justify-center font-label-sm text-label-sm font-bold shrink-0">@iniciales</span>
                    <span class="font-label-sm text-label-sm text-on-surface truncate">@nombreSocio</span>
                </div>
                <a href="@Url.Action("CerrarSesion", "Login")"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-error-red hover:bg-error-container/40 font-label-sm text-label-sm font-semibold transition-colors">
                    <svg class="ic w-5 h-5"><use href="#ic-logout"></use></svg>
                    Cerrar sesión
                </a>
            </div>
        }
    </aside>

    @* ---------------- Lienzo principal ---------------- *@
    <main class="pt-20 pb-28 px-4 md:pt-8 md:pb-8 md:pl-[312px] md:pr-8 w-full max-w-[1440px] mx-auto">
        @RenderBody()

        <footer class="mt-10 pt-6 border-t border-outline-variant/40 text-center font-caption text-caption text-on-surface-variant">
            &copy; @DateTime.Now.Year <b class="text-on-surface-variant">Cooperativa de Agua Potable COSPABI R.L.</b> &middot; Portal del Socio
        </footer>
    </main>

    @* ---------------- Barra inferior (solo movil) ---------------- *@
    <nav class="md:hidden fixed bottom-0 inset-x-0 z-50 flex justify-around items-center px-2 pt-2 pb-3 bg-surface rounded-t-xl shadow-[0_-2px_10px_rgba(0,0,0,0.05)]">
        @foreach (var d in destinos)
        {
            var claseInferior = "relative flex flex-col items-center justify-center rounded-xl px-3 py-1 active:scale-95 transition-transform duration-200 "
                + (esActivo(d.Ruta)
                    ? "bg-primary-container text-on-primary-container"
                    : "text-on-secondary-container");
            <a href="@d.Url" class="@claseInferior">
                <svg class="ic w-6 h-6"><use href="#ic-@d.Icono"></use></svg>
                <span class="mt-0.5 text-[11px] font-medium">@d.Corto</span>
                @if (d.Icono == "bell")
                {
                    <span class="badge-notif hidden absolute top-0 right-1 min-w-[16px] h-4 px-1 rounded-full bg-error-red text-white text-[10px] font-bold leading-4 text-center"></span>
                }
            </a>
        }
    </nav>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/portal.js"></script>
    <script>
        // Contador de notificaciones sin leer: alimenta los tres badges
        // (campana movil, barra lateral y barra inferior) con una sola llamada.
        $(function () {
            $.get('@Url.Action("Resumen", "Portal")', function (res) {
                if (res && res.exito && res.resumen && res.resumen.notificaciones_sin_leer > 0) {
                    $('.badge-notif').text(res.resumen.notificaciones_sin_leer).removeClass('hidden');
                }
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
