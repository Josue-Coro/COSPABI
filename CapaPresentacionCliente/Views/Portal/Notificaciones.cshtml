@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-3xl">

    <header class="flex items-end justify-between gap-4 mb-6 md:mb-8">
        <div>
            <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface mb-1">Notificaciones</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">Mantente al día con tu cooperativa.</p>
        </div>
        <span id="chipNuevas" class="hidden shrink-0 font-label-sm text-label-sm bg-surface-container-high text-on-surface px-3 py-1.5 rounded-full border border-outline-variant/60"></span>
    </header>

    <div id="listaNotif" class="flex flex-col gap-3">
        <p class="font-body-md text-label-sm text-on-surface-variant">Cargando…</p>
    </div>

</div>

@section scripts {
    <script>
        // El tipo lo define el administrador al publicar; se usa solo para
        // elegir icono y color, nunca se inyecta como HTML.
        function estiloTipo(tipo) {
            var t = (tipo || '').toUpperCase();
            if (t.indexOf('PAGO') >= 0)         return { icono: 'ic-check-circle', fondo: 'bg-primary-50',            color: 'text-primary-700',        barra: 'bg-primary' };
            if (t.indexOf('VENCIM') >= 0 ||
                t.indexOf('RECORD') >= 0 ||
                t.indexOf('MORA') >= 0)         return { icono: 'ic-warning',      fondo: 'bg-warning-yellow/10',     color: 'text-warning-yellow',     barra: 'bg-warning-yellow' };
            if (t.indexOf('AVISO') >= 0 ||
                t.indexOf('COBRO') >= 0)        return { icono: 'ic-receipt',      fondo: 'bg-secondary-container',   color: 'text-on-secondary-container', barra: 'bg-primary' };
            if (t.indexOf('CORTE') >= 0 ||
                t.indexOf('MANTEN') >= 0)       return { icono: 'ic-settings',     fondo: 'bg-error-container/60',    color: 'text-on-error-container', barra: 'bg-error-red' };
            return { icono: 'ic-megaphone', fondo: 'bg-slate-100', color: 'text-secondary', barra: 'bg-primary' };
        }

        function cargar() {
            $.get('@Url.Action("ListarNotificaciones", "Portal")', function (res) {
                var cont = $('#listaNotif');
                cont.empty();

                if (!res.exito || !res.notificaciones || !res.notificaciones.length) {
                    $('#chipNuevas').addClass('hidden');
                    cont.html(
                        '<div class="bg-surface-container-lowest border border-outline-variant/40 rounded-xl p-10 text-center text-on-surface-variant">' +
                            '<svg class="ic w-12 h-12 mx-auto mb-3 opacity-40"><use href="#ic-bell"></use></svg>' +
                            '<p class="font-body-md text-body-md">No tienes notificaciones.</p>' +
                        '</div>');
                    return;
                }

                var nuevas = res.notificaciones.filter(function (n) { return !n.leido; }).length;
                $('#chipNuevas')
                    .text(nuevas === 0 ? 'Todas leídas' : (nuevas === 1 ? '1 nueva' : nuevas + ' nuevas'))
                    .toggleClass('hidden', false);

                $.each(res.notificaciones, function (_, n) {
                    var e = estiloTipo(n.tipo);
                    var nueva = !n.leido;

                    var card = $(
                        '<article class="bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-4 pl-5 flex gap-4 items-start shadow-sm relative overflow-hidden transition-shadow duration-200' +
                            (nueva ? ' cursor-pointer hover:shadow-[0_8px_15px_-3px_rgba(0,0,0,0.06)]' : ' opacity-80') + '">' +
                            (nueva ? '<span class="absolute left-0 top-0 w-1.5 h-full ' + e.barra + '"></span>' : '') +
                            '<span class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 ' + e.fondo + ' ' + e.color + '">' +
                                '<svg class="ic w-6 h-6"><use href="#' + e.icono + '"></use></svg>' +
                            '</span>' +
                            '<div class="flex-1 min-w-0">' +
                                '<div class="flex justify-between items-baseline gap-3 mb-1">' +
                                    '<h2 class="font-label-sm text-label-sm text-on-surface ' + (nueva ? 'font-bold' : 'font-medium') + '">' +
                                        Portal.esc(n.titulo) +
                                    '</h2>' +
                                    '<span class="font-caption text-caption shrink-0 ' + (nueva ? 'text-primary font-medium' : 'text-on-surface-variant') + '">' +
                                        Portal.ffechaLarga(n.fecha_publicacion) +
                                    '</span>' +
                                '</div>' +
                                '<p class="font-body-md text-label-sm leading-relaxed text-on-surface-variant whitespace-pre-line">' + Portal.esc(n.mensaje) + '</p>' +
                                '<div class="flex items-center gap-2 mt-3">' +
                                    '<span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant">' + Portal.esc(n.tipo) + '</span>' +
                                    (nueva
                                        ? '<span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-primary-50 text-primary-700">Nueva · toca para marcar leída</span>'
                                        : (n.fecha_lectura ? '<span class="font-caption text-caption text-on-surface-variant">Leída el ' + Portal.ffecha(n.fecha_lectura) + '</span>' : '')) +
                                '</div>' +
                            '</div>' +
                        '</article>');

                    if (nueva) {
                        card.on('click', function () {
                            $.post('@Url.Action("MarcarLeida", "Portal")',
                                   { idNotificacionSocio: n.id_notificacion_socio },
                                   function () { cargar(); });
                        });
                    }

                    cont.append(card);
                });
            });
        }

        $(cargar);
    </script>
}
