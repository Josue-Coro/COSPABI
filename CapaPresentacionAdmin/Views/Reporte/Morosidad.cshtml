@{
    ViewBag.Title = "Reporte de Morosidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@media print {
        aside, header, #sidebarOverlay, .no-print { display: none !important; }
        html, body { overflow: visible !important; height: auto !important; background: #fff !important; }
        body > .flex { display: block !important; height: auto !important; overflow: visible !important; }
        main { overflow: visible !important; padding: 0 !important; background: #fff !important; }
        #areaReporte { box-shadow: none !important; border: none !important; }
    }
</style>

<div class="p-6">
    <div class="mb-6 no-print">
        <h1 class="text-2xl font-bold text-gray-800">Reporte de Morosidad</h1>
        <p class="text-sm text-gray-500 mt-1">Avisos vencidos sin pagar, agrupados por socio</p>
    </div>

    <!-- Filtros -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 mb-6 no-print">
        <div class="flex flex-wrap items-end gap-3">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Vencidos desde</label>
                <input type="date" id="fIni" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Hasta</label>
                <input type="date" id="fFin" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Ruta</label>
                <select id="selRuta" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" style="min-width:140px">
                    <option value="">Todas</option>
                </select>
            </div>
            <button onclick="generar()" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2 rounded-xl">Generar</button>
            <button id="btnImprimir" onclick="window.print()" disabled
                    class="border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm font-semibold px-5 py-2 rounded-xl disabled:opacity-40">Imprimir / PDF</button>
        </div>
        <p class="text-xs text-gray-400 mt-2">Sin fechas: se listan todos los avisos vencidos a hoy.</p>
        <p id="msgError" class="hidden text-xs text-red-500 mt-2"></p>
    </div>

    <!-- Area imprimible -->
    <div id="areaReporte" class="hidden bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="text-center mb-4">
            <h2 class="text-lg font-bold text-gray-800">COSPABI R.L. — Reporte de Morosidad</h2>
            <p class="text-sm text-gray-500" id="lblRango"></p>
        </div>

        <div class="grid grid-cols-3 gap-4 mb-5">
            <div class="bg-gray-50 rounded-xl p-4 text-center">
                <p class="text-xs text-gray-400 uppercase font-semibold">Socios morosos</p>
                <p class="text-2xl font-bold text-gray-800" id="lblSocios">0</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-4 text-center">
                <p class="text-xs text-gray-400 uppercase font-semibold">Avisos vencidos</p>
                <p class="text-2xl font-bold text-gray-800" id="lblAvisos">0</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-4 text-center">
                <p class="text-xs text-gray-400 uppercase font-semibold">Total adeudado</p>
                <p class="text-2xl font-bold text-red-700 font-mono" id="lblTotal">Bs. 0.00</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-gray-500">
                    <tr>
                        <th class="px-3 py-2 text-left font-semibold uppercase text-xs">Socio</th>
                        <th class="px-3 py-2 text-left font-semibold uppercase text-xs">Ruta</th>
                        <th class="px-3 py-2 text-left font-semibold uppercase text-xs">Período</th>
                        <th class="px-3 py-2 text-left font-semibold uppercase text-xs">Venció</th>
                        <th class="px-3 py-2 text-right font-semibold uppercase text-xs">Días mora</th>
                        <th class="px-3 py-2 text-right font-semibold uppercase text-xs">Monto</th>
                    </tr>
                </thead>
                <tbody id="tbodyMorosos" class="divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
<script>
    $(function () {
        $.get('@Url.Action("Rutas", "Reporte")', function (res) {
            if (res.exito) $.each(res.rutas, function (_, r) {
                $('#selRuta').append('<option value="' + r.id_ruta + '">Ruta ' + r.ruta + '</option>');
            });
        });
    });

    function fmt(n) { return (n == null ? 0 : n).toLocaleString('es-BO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function parseNet(v) { if (!v) return null; var m = /\/Date\((\d+)\)\//.exec(v); var d = m ? new Date(parseInt(m[1])) : new Date(v); return isNaN(d) ? null : d; }
    function ffecha(v) { var d = parseNet(v); return d ? d.toLocaleDateString('es-BO') : '-'; }

    function generar() {
        $('#msgError').addClass('hidden');
        $.get('@Url.Action("DatosMorosidad", "Reporte")',
              { fechaInicio: $('#fIni').val(), fechaFin: $('#fFin').val(), idRuta: $('#selRuta').val() || null },
              function (res) {
            if (!res.exito) { $('#msgError').text(res.mensaje).removeClass('hidden'); return; }

            var rutaTxt = $('#selRuta option:selected').text();
            var fi = $('#fIni').val(), ff = $('#fFin').val();
            var rango = (fi || ff)
                ? 'Vencimientos ' + (fi ? 'desde ' + fi.split('-').reverse().join('/') : '') + (ff ? ' hasta ' + ff.split('-').reverse().join('/') : '')
                : 'Todos los avisos vencidos al ' + new Date().toLocaleDateString('es-BO');
            $('#lblRango').text(rango + ' · Ruta: ' + rutaTxt);

            $('#lblSocios').text(res.cantidadSocios);
            $('#lblAvisos').text(res.cantidadAvisos);
            $('#lblTotal').text('Bs. ' + fmt(res.totalAdeudado));

            var tb = $('#tbodyMorosos'); tb.empty();
            if (!res.avisos.length) {
                tb.html('<tr><td colspan="6" class="text-center py-6 text-gray-400">No hay avisos vencidos con los filtros seleccionados</td></tr>');
            }
            var socioPrev = 0;
            $.each(res.avisos, function (_, a) {
                var esNuevoSocio = a.id_socio !== socioPrev;
                socioPrev = a.id_socio;
                tb.append('<tr class="' + (esNuevoSocio ? 'border-t-2 border-gray-200' : '') + '">' +
                    '<td class="px-3 py-2 font-medium text-gray-800">' + (esNuevoSocio ? a.nombre_socio + ' (' + a.codigo_fijo + ')' : '') + '</td>' +
                    '<td class="px-3 py-2 text-gray-600">' + (a.nombre_ruta || '-') + '</td>' +
                    '<td class="px-3 py-2 text-gray-600">' + a.nombre_periodo + '</td>' +
                    '<td class="px-3 py-2 text-gray-600">' + ffecha(a.fecha_vencimiento) + '</td>' +
                    '<td class="px-3 py-2 text-right font-semibold ' + (a.dias_mora > 60 ? 'text-red-600' : 'text-amber-600') + '">' + a.dias_mora + '</td>' +
                    '<td class="px-3 py-2 text-right font-mono font-semibold text-gray-800">Bs. ' + fmt(a.monto_adeudado) + '</td>' +
                    '</tr>');
            });

            $('#areaReporte').removeClass('hidden');
            $('#btnImprimir').prop('disabled', false);
        }).fail(function () {
            $('#msgError').text('Error de conexión.').removeClass('hidden');
        });
    }
</script>
}
